#compdef paragravity pgrav

_paragravity_profiles() {
    local profiles_dir="${PARAGRAVITY_PROFILES_DIR:-${HOME}/.antigravity-profiles}"
    if [[ -d "$profiles_dir" ]]; then
        local -a profiles
        profiles=($(find "$profiles_dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null))
        _describe 'profiles' profiles
    fi
}

_paragravity() {
    local -a commands
    commands=(
        'create:Create a new isolated Antigravity profile'
        'list:List all profiles, status, and Google accounts'
        'ls:Alias for list'
        'launch:Launch Antigravity for a profile'
        'start:Alias for launch'
        'stop:Stop running instance of profile'
        'delete:Delete a profile and its shortcuts'
        'rm:Alias for delete'
        'info:Show detailed profile info'
        'path:Print profile directory path'
        'logs:Show the latest launch log of a profile'
    )

    _arguments -C \
        '(-v --version)'{-v,--version}'[Show version]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1: :->command' \
        '*: :->args'

    case $state in
        command)
            _describe 'paragravity commands' commands
            ;;
        args)
            case ${words[2]} in
                launch|start|stop|delete|rm|info|path|logs)
                    _paragravity_profiles
                    ;;
                create)
                    if [[ ${words[CURRENT-1]} == "--clone-from" ]]; then
                        _paragravity_profiles
                    else
                        _arguments \
                            '(-d --description)'{-d,--description}'[Short description]:description:' \
                            '(-l --launch)'{-l,--launch}'[Launch immediately after creation]' \
                            '(-i --inherit-config)'{-i,--inherit-config}'[Inherit settings/skills/MCP from host]' \
                            '--clone-from[Clone settings from existing profile]:profile:_paragravity_profiles' \
                            '--no-mcp[Do not inherit MCP tool configuration]' \
                            '--links[Symlink policy]:policy:(full minimal none)' \
                            '1:profile name:'
                    fi
                    ;;
            esac
            ;;
    esac
}

_paragravity "$@"
