#!/usr/bin/env python3
"""
ParaGravity (pgrav)
Native, non-invasive parallel multi-account & sandbox manager for Google Antigravity.

Repository: https://github.com/edison-land/paragravity
License: MIT
"""

from __future__ import annotations

import os
import re
import sys
import json
import base64
import signal
import shutil
import argparse
import subprocess
import time
from datetime import datetime, timedelta
from pathlib import Path

VERSION = "1.1.0"

IS_WINDOWS = sys.platform == "win32"
IS_DARWIN = sys.platform == "darwin"

def get_default_app_bin() -> str:
    if IS_WINDOWS:
        local_app_data = os.environ.get("LOCALAPPDATA")
        program_files = os.environ.get("PROGRAMFILES")
        program_files_x86 = os.environ.get("PROGRAMFILES(X86)")
        candidates = []
        if local_app_data:
            candidates.append(Path(local_app_data) / "Programs" / "Antigravity" / "Antigravity.exe")
            candidates.append(Path(local_app_data) / "Antigravity" / "Antigravity.exe")
        if program_files:
            candidates.append(Path(program_files) / "Antigravity" / "Antigravity.exe")
        if program_files_x86:
            candidates.append(Path(program_files_x86) / "Antigravity" / "Antigravity.exe")
        for c in candidates:
            if c.is_file():
                return str(c)
        which_exe = shutil.which("Antigravity.exe") or shutil.which("Antigravity")
        if which_exe:
            return which_exe
        return str(candidates[0]) if candidates else "Antigravity.exe"
    elif IS_DARWIN:
        mac_default = Path("/Applications/Antigravity.app/Contents/MacOS/Antigravity")
        if mac_default.is_file():
            return str(mac_default)
        alt = Path.home() / "Applications/Antigravity.app/Contents/MacOS/Antigravity"
        if alt.is_file():
            return str(alt)
        return str(mac_default)
    else:
        which_bin = shutil.which("antigravity") or shutil.which("Antigravity")
        return which_bin or "/usr/bin/antigravity"

DEFAULT_APP_BIN = get_default_app_bin()
DEFAULT_PROFILES_DIR = Path.home() / ".antigravity-profiles"

# ANSI Colors — disabled when output is piped or NO_COLOR is set, so
# `pgrav list | cat`, `--json` consumers and CI logs stay clean.
_COLOR_ENABLED = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
COLOR_RESET = "\033[0m" if _COLOR_ENABLED else ""
COLOR_BOLD = "\033[1m" if _COLOR_ENABLED else ""
COLOR_GREEN = "\033[32m" if _COLOR_ENABLED else ""
COLOR_BLUE = "\033[34m" if _COLOR_ENABLED else ""
COLOR_YELLOW = "\033[33m" if _COLOR_ENABLED else ""
COLOR_RED = "\033[31m" if _COLOR_ENABLED else ""
COLOR_CYAN = "\033[36m" if _COLOR_ENABLED else ""
COLOR_DIM = "\033[2m" if _COLOR_ENABLED else ""

def get_profiles_dir() -> Path:
    env_dir = os.environ.get("PARAGRAVITY_PROFILES_DIR") or os.environ.get("AGY_PROFILES_DIR")
    if env_dir:
        return Path(env_dir).expanduser()
    return DEFAULT_PROFILES_DIR

def validate_profile_name(name: str):
    """Reject names that could escape the profiles directory or be interpreted by a shell."""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", name):
        print(f"{COLOR_RED}Error: Invalid profile name '{name}'. Use 1-64 characters: letters, digits, '.', '_', '-' (must start with a letter or digit).{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

def prompt_yes_no(message: str, default_no: bool = True) -> bool:
    """Read a y/n answer; on EOF (non-interactive stdin) fall back to the default."""
    try:
        answer = input(message).strip().lower()
    except EOFError:
        return not default_no
    return answer == "y" if answer else not default_no

def harden_profile_perms(profile_dir: Path, profiles_dir: Path):
    """Keep profile directories and sensitive files accessible to the owner only (0700/0600)."""
    if IS_WINDOWS:
        return
    try:
        targets = [
            profiles_dir,
            profile_dir,
            profile_dir / "data",
            profile_dir / "home",
            profile_dir / "home" / ".gemini",
            profile_dir / "home" / ".gemini" / "config",
            profile_dir / "data" / "User",
        ]
        for d in targets:
            if d.is_dir():
                os.chmod(d, 0o700)
    except OSError:
        pass

def get_app_binary() -> str:
    env_bin = os.environ.get("ANTIGRAVITY_BIN")
    if env_bin:
        if os.path.isfile(env_bin):
            return env_bin
        print(f"{COLOR_YELLOW}Warning: ANTIGRAVITY_BIN is set but not a file: {env_bin} — ignoring.{COLOR_RESET}", file=sys.stderr)
    return get_default_app_bin()

def get_directory_size(path: Path) -> str:
    """Calculate human-readable directory size."""
    if not path.exists():
        return "0 B"
    total_bytes = 0
    try:
        for p in path.rglob("*"):
            if p.is_file() and not p.is_symlink():
                total_bytes += p.stat().st_size
    except Exception:
        pass

    for unit in ["B", "KB", "MB", "GB"]:
        if total_bytes < 1024.0:
            return f"{total_bytes:.1f} {unit}"
        total_bytes /= 1024.0
    return f"{total_bytes:.1f} TB"

def decode_jwt_payload(jwt_str: str) -> dict:
    """Decode JWT payload without external libraries."""
    try:
        parts = jwt_str.strip().split(".")
        if len(parts) >= 2:
            payload = parts[1]
            payload += "=" * (-len(payload) % 4)
            return json.loads(base64.urlsafe_b64decode(payload.encode()).decode("utf-8"))
    except Exception:
        pass
    return {}

def token_expiry_state(token_exp: str):
    """Classify a token expiry ISO timestamp: 'expired', 'expiring' (within
    7 days), or None when there is nothing to warn about."""
    if not token_exp:
        return None
    try:
        exp = datetime.fromisoformat(token_exp)
    except (TypeError, ValueError):
        return None
    now = datetime.now(exp.tzinfo) if exp.tzinfo else datetime.now()
    if exp < now:
        return "expired"
    if exp < now + timedelta(days=7):
        return "expiring"
    return None

def extract_account_info(profile_dir: Path) -> dict:
    """Extract signed-in Google account information from profile data."""
    info = {
        "email": None,
        "token_exp": None,
        "has_token": False
    }
    gemini_dir = profile_dir / "home" / ".gemini"
    if not gemini_dir.exists():
        return info

    acc_file = gemini_dir / "google_accounts.json"
    if acc_file.is_file():
        try:
            with open(acc_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                active = data.get("active")
                if active:
                    info["email"] = active
        except Exception:
            pass

    token_file = gemini_dir / "jetski-standalone-oauth-token"
    if token_file.is_file():
        try:
            tok_raw = token_file.read_text(encoding="utf-8").strip()
            if tok_raw:
                info["has_token"] = True
                claims = decode_jwt_payload(tok_raw)
                if not info["email"] and claims.get("email"):
                    info["email"] = claims["email"]
                if claims.get("exp"):
                    info["token_exp"] = datetime.fromtimestamp(claims["exp"]).isoformat()
        except Exception:
            pass

    return info

def strip_ansi(text: str) -> str:
    return re.sub(r'\x1b\[[0-9;]*m', '', text)

def pad_visible(text: str, width: int) -> str:
    visible_len = len(strip_ansi(text))
    padding = max(0, width - visible_len)
    return text + (" " * padding)

def is_pid_running(pid: int) -> bool:
    if pid <= 0:
        return False
    if IS_WINDOWS:
        try:
            import ctypes
            kernel32 = ctypes.windll.kernel32
            SYNCHRONIZE = 0x00100000
            PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
            handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, False, pid)
            if handle:
                exit_code = ctypes.c_ulong()
                kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code))
                kernel32.CloseHandle(handle)
                return exit_code.value == 259
        except Exception:
            pass
        try:
            res = subprocess.run(
                ["tasklist", "/FI", f"PID eq {pid}", "/NH"],
                capture_output=True, text=True, encoding="utf-8", errors="replace"
            )
            return str(pid) in (res.stdout or "")
        except Exception:
            return False
    else:
        try:
            os.kill(pid, 0)
            return True
        except (OSError, ProcessLookupError, SystemError):
            return False

def _ps_escape_like(text: str) -> str:
    """Escape PowerShell -like wildcards inside an embedded literal."""
    return (text.replace("[", "[[]")
                .replace("*", "[*]")
                .replace("?", "[?]"))

def _ps_single_quote(text: str) -> str:
    """Quote a string for a single-quoted PowerShell literal."""
    return "'" + text.replace("'", "''") + "'"

def _pid_matches_profile(pid: int, data_dir: Path) -> bool:
    """Confirm the live pid actually belongs to this profile.

    A stale run.pid can name a pid the OS has since recycled for an unrelated
    process — without this check `stop` would SIGTERM an innocent victim.
    """
    marker = f"--user-data-dir={data_dir.resolve()}"
    try:
        if IS_WINDOWS:
            ps_cmd = (
                f"(Get-CimInstance Win32_Process -Filter \"ProcessId = {pid}\").CommandLine"
            )
            out = subprocess.check_output(
                ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
                stderr=subprocess.DEVNULL
            )
            cmdline = out.decode("utf-8", "replace")
        else:
            out = subprocess.check_output(
                ["ps", "-o", "command=", "-p", str(pid)],
                stderr=subprocess.DEVNULL
            )
            cmdline = out.decode("utf-8", "replace")
    except Exception:
        return False
    return marker in cmdline or "Antigravity" in cmdline

def get_profile_process(profile_name: Path, data_dir: Path) -> int:
    """Check if Antigravity is running with this profile's data_dir."""
    pid_file = profile_name / "run.pid"
    if pid_file.is_file():
        try:
            pid = int(pid_file.read_text().strip())
            if is_pid_running(pid) and _pid_matches_profile(pid, data_dir):
                return pid
            # Stale or recycled pid — do not trust it.
            pid_file.unlink(missing_ok=True)
        except Exception:
            pass

    # Fallback to process search
    if IS_WINDOWS:
        try:
            like_path = _ps_escape_like(str(data_dir.resolve()))
            ps_cmd = (
                f"Get-CimInstance Win32_Process | "
                f"Where-Object {{ $_.ProcessId -ne $PID -and $_.Name -notlike '*powershell*' -and $_.Name -notlike '*pwsh*' -and $_.CommandLine -like {_ps_single_quote('*--user-data-dir=' + like_path + '*')} }} | "
                f"Select-Object -ExpandProperty ProcessId"
            )
            out = subprocess.check_output(
                ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
                stderr=subprocess.DEVNULL
            )
            pids = [int(p) for p in out.decode("utf-8", "replace").split() if p.strip().isdigit()]
            if pids:
                return pids[0]
        except Exception:
            pass
    else:
        try:
            # re.escape the path: PARAGRAVITY_PROFILES_DIR may contain regex
            # metacharacters that would otherwise widen the match.
            pattern = f"--user-data-dir={re.escape(str(data_dir.resolve()))}( |$)"
            out = subprocess.check_output(["pgrep", "-f", "--", pattern], stderr=subprocess.DEVNULL)
            pids = [int(p) for p in out.decode().split() if p.strip()]
            if pids:
                return pids[0]
        except Exception:
            pass

    return 0

# Items symlinked from the real HOME into a profile's fake HOME, by policy.
# "full" (default) maximizes developer comfort but exposes the real ~/.ssh and
# ~/.config to whatever runs inside the profile; "minimal" drops the sensitive
# dotdirs; "none" links nothing.
LINK_ITEMS_FULL = [
    ".zshrc", ".zshenv", ".zprofile",
    ".bashrc", ".bash_profile", ".profile",
    ".gitconfig", ".gitignore_global",
    ".ssh",
    ".config",
    ".npmrc", ".yarnrc",
    "Desktop", "Documents", "Downloads", "Projects", "Developer",
]
LINK_ITEMS_MINIMAL = [
    i for i in LINK_ITEMS_FULL
    if i not in (".ssh", ".config", ".npmrc", ".yarnrc")
]
SYMLINK_POLICIES = {
    "full": LINK_ITEMS_FULL,
    "minimal": LINK_ITEMS_MINIMAL,
    "none": [],
}

def create_symlink_or_junction(src: Path, dst: Path) -> bool:
    """
    Safely link src to dst.
    On Windows, uses directory junctions (mklink /J or _winapi.CreateJunction)
    for directories because junctions require no Administrator or Developer Mode privileges.
    On Unix/macOS, creates standard symlinks.
    """
    try:
        if dst.exists() or dst.is_symlink():
            return False
        dst.parent.mkdir(parents=True, exist_ok=True)
        if IS_WINDOWS and src.is_dir():
            try:
                import _winapi
                _winapi.CreateJunction(str(src), str(dst))
                return True
            except (AttributeError, OSError):
                res = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)], capture_output=True)
                if res.returncode == 0:
                    return True
        dst.symlink_to(src)
        return True
    except OSError:
        if IS_WINDOWS and src.is_file():
            try:
                shutil.copy2(src, dst)
                return True
            except OSError:
                pass
        return False

def setup_home_symlinks(real_home: Path, profile_home: Path, policy: str = "full"):
    """
    Symlink configuration & directories from the real HOME into the profile's
    fake HOME, according to the profile's policy ("full", "minimal" or "none").
    """
    profile_home.mkdir(parents=True, exist_ok=True)
    (profile_home / ".gemini").mkdir(exist_ok=True)

    link_items = SYMLINK_POLICIES.get(policy, LINK_ITEMS_FULL)

    for item in link_items:
        src = real_home / item
        dst = profile_home / item
        if src.exists() and not dst.exists():
            create_symlink_or_junction(src, dst)

    if IS_DARWIN:
        real_kc = real_home / "Library" / "Keychains"
        prof_lib = profile_home / "Library"
        prof_lib.mkdir(exist_ok=True)
        prof_kc = prof_lib / "Keychains"
        if real_kc.exists() and not prof_kc.exists():
            try:
                prof_kc.symlink_to(real_kc)
            except Exception:
                pass

def setup_profile_inheritance(
    target_profile_dir: Path,
    source: str,
    inherit_mcp: bool = True,
    inherit_extensions: bool = True
) -> dict:
    """
    Safely inherit or clone non-credential configuration from the host
    environment (source="host") or an existing profile (source=<profile_name>).
    Strict allowlist only — OAuth tokens, accounts, session DBs, and conversations
    are strictly excluded.
    Returns a dict summarizing what was inherited.
    """
    profiles_dir = get_profiles_dir()
    real_home = Path.home()

    if source == "host":
        src_root = real_home
        src_home = real_home
        src_gemini = real_home / ".gemini"
        if IS_WINDOWS:
            appdata = os.environ.get("APPDATA")
            src_app_support = (Path(appdata) / "Antigravity") if appdata else (real_home / "AppData" / "Roaming" / "Antigravity")
        else:
            src_app_support = real_home / "Library" / "Application Support" / "Antigravity"
        source_is_profile = False
    else:
        validate_profile_name(source)
        src_profile_dir = profiles_dir / source
        if not src_profile_dir.is_dir() or not (src_profile_dir / "profile.json").is_file():
            raise ValueError(f"Source profile '{source}' does not exist or has no profile.json.")
        src_root = src_profile_dir
        src_home = src_profile_dir / "home"
        src_gemini = src_home / ".gemini"
        src_data = src_profile_dir / "data"
        src_app_support = src_data
        source_is_profile = True

    tgt_home = target_profile_dir / "home"
    tgt_data = target_profile_dir / "data"
    tgt_gemini = tgt_home / ".gemini"
    tgt_gemini_cfg = tgt_gemini / "config"

    tgt_gemini.mkdir(parents=True, exist_ok=True)
    tgt_gemini_cfg.mkdir(parents=True, exist_ok=True)
    tgt_data.mkdir(parents=True, exist_ok=True)

    report = {
        "source": source,
        "files_copied": [],
        "dirs_linked": [],
        "dirs_copied": [],
    }

    def _is_path_safe(p: Path, allowed_root: Path) -> bool:
        try:
            resolved = p.resolve()
            resolved.relative_to(allowed_root.resolve())
            return True
        except (ValueError, OSError):
            if IS_WINDOWS:
                try:
                    p_str = os.path.normcase(os.path.realpath(str(p)))
                    root_str = os.path.normcase(os.path.realpath(str(allowed_root)))
                    return p_str == root_str or p_str.startswith(root_str.rstrip("\\/") + "\\")
                except Exception:
                    pass
            return False

    def _safe_copy(src_file: Path, dst_file: Path) -> bool:
        try:
            if not src_file.is_file() or src_file.is_symlink():
                return False
            # Ensure resolved path is within allowed source root or app support root
            if not _is_path_safe(src_file, src_root) and not _is_path_safe(src_file, src_app_support):
                return False
            dst_file.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src_file, dst_file)
            os.chmod(dst_file, 0o600)
            report["files_copied"].append(dst_file.name)
            return True
        except OSError:
            return False

    def _safe_copy_dir(src_d: Path, dst_d: Path) -> bool:
        try:
            if not src_d.is_dir() or src_d.is_symlink():
                return False
            if not _is_path_safe(src_d, src_root) and not _is_path_safe(src_d, src_app_support):
                return False
            copied_any = False
            for item in src_d.rglob("*"):
                if item.is_file() and not item.is_symlink():
                    d_file = dst_d / item.relative_to(src_d)
                    d_file.parent.mkdir(parents=True, exist_ok=True)
                    os.chmod(d_file.parent, 0o700)
                    shutil.copy2(item, d_file)
                    os.chmod(d_file, 0o600)
                    copied_any = True
            if copied_any:
                report["dirs_copied"].append(dst_d.name)
            return copied_any
        except OSError:
            return False

    def _safe_link_or_copy_dir(src_d: Path, dst_d: Path) -> bool:
        try:
            if not src_d.is_dir():
                return False
            resolved = src_d.resolve()
            # If src_d is within source root
            if _is_path_safe(src_d, src_root):
                if source_is_profile and not src_d.is_symlink():
                    return _safe_copy_dir(src_d, dst_d)
                if dst_d.exists() or dst_d.is_symlink():
                    return False
                dst_d.parent.mkdir(parents=True, exist_ok=True)
                if create_symlink_or_junction(src_d, dst_d):
                    report["dirs_linked"].append(dst_d.name)
                    return True
                return _safe_copy_dir(src_d, dst_d)
            # If src_d is a symlink pointing into real home (e.g. host skills)
            elif _is_path_safe(resolved, real_home):
                if dst_d.exists() or dst_d.is_symlink():
                    return False
                dst_d.parent.mkdir(parents=True, exist_ok=True)
                if create_symlink_or_junction(resolved, dst_d):
                    report["dirs_linked"].append(dst_d.name)
                    return True
                return False
            return False
        except OSError:
            return False

    # 1. Antigravity & VSCode User settings (settings.json, keybindings.json, snippets)
    tgt_user_dir = tgt_data / "User"
    if not source_is_profile:
        if IS_WINDOWS:
            appdata = os.environ.get("APPDATA")
            src_user_dir = (Path(appdata) / "Antigravity" / "User") if appdata else (real_home / "AppData" / "Roaming" / "Antigravity" / "User")
            if not src_user_dir.is_dir() and appdata:
                code_user = Path(appdata) / "Code" / "User"
                if code_user.is_dir():
                    src_user_dir = code_user
        else:
            src_user_dir = src_app_support / "User"
            if not src_user_dir.is_dir():
                code_user = real_home / "Library" / "Application Support" / "Code" / "User"
                if code_user.is_dir():
                    src_user_dir = code_user
    else:
        src_user_dir = src_data / "User"

    if src_user_dir.is_dir():
        _safe_copy(src_user_dir / "settings.json", tgt_user_dir / "settings.json")
        _safe_copy(src_user_dir / "keybindings.json", tgt_user_dir / "keybindings.json")
        _safe_copy_dir(src_user_dir / "snippets", tgt_user_dir / "snippets")

    def _sanitize_mcp_servers(servers) -> dict:
        """Strip secret-looking values from an mcpServers mapping.

        MCP server definitions routinely embed API keys/tokens in `env` and
        `headers` — the "credentials are never copied" guarantee has to reach
        into these, or --inherit-config would leak keys into every clone.
        """
        secret_key = re.compile(r"key|token|secret|password|credential|auth|signature|private", re.IGNORECASE)
        if not isinstance(servers, dict):
            return servers
        clean = {}
        for srv_name, srv in servers.items():
            if isinstance(srv, dict):
                srv = dict(srv)
                for field in ("env", "headers"):
                    if isinstance(srv.get(field), dict):
                        srv[field] = {
                            k: ("" if secret_key.search(str(k)) else v)
                            for k, v in srv[field].items()
                        }
            clean[srv_name] = srv
        return clean

    # Target ~/.gemini/settings.json
    src_gemini_settings = src_gemini / "settings.json"
    if src_gemini_settings.is_file() and not src_gemini_settings.is_symlink():
        try:
            raw = json.loads(src_gemini_settings.read_text(encoding="utf-8"))
            sensitive_keys = {
                "jetski-standalone-oauth-token", "google_accounts", "google_account_id",
                "lastLoginUsername", "oauth_creds", "credentials", "token",
                "refreshToken", "accessToken"
            }
            filtered = {}
            for k, v in raw.items():
                k_lower = k.lower()
                if k in sensitive_keys or "oauth" in k_lower or "token" in k_lower or "secret" in k_lower or "credential" in k_lower:
                    continue
                if k == "mcpServers":
                    if not inherit_mcp:
                        continue
                    v = _sanitize_mcp_servers(v)
                filtered[k] = v
            dst_s = tgt_gemini / "settings.json"
            dst_s.write_text(json.dumps(filtered, indent=2, ensure_ascii=False), encoding="utf-8")
            os.chmod(dst_s, 0o600)
            report["files_copied"].append("settings.json")
        except Exception:
            pass

    # 2. AI Assistant Configuration (~/.gemini/config/config.json)
    src_config_json = src_gemini / "config" / "config.json"
    if src_config_json.is_file() and not src_config_json.is_symlink():
        try:
            raw_cfg = json.loads(src_config_json.read_text(encoding="utf-8"))
            user_settings = raw_cfg.get("userSettings", {})
            sanitized_user_settings = {
                k: v for k, v in user_settings.items()
                if k not in ("remoteControlHostname",)
            }
            dst_cfg = tgt_gemini_cfg / "config.json"
            dst_cfg.write_text(json.dumps({"userSettings": sanitized_user_settings}, indent=2, ensure_ascii=False), encoding="utf-8")
            os.chmod(dst_cfg, 0o600)
            report["files_copied"].append("config.json")
        except Exception:
            pass

    # 3. MCP tool configurations (mcp_config.json) — copied with secret env
    # values stripped (see _sanitize_mcp_servers above).
    if inherit_mcp:
        src_mcp = src_gemini / "config" / "mcp_config.json"
        if src_mcp.is_file() and not src_mcp.is_symlink():
            try:
                mcp_raw = json.loads(src_mcp.read_text(encoding="utf-8"))
                if isinstance(mcp_raw, dict) and "mcpServers" in mcp_raw:
                    mcp_raw["mcpServers"] = _sanitize_mcp_servers(mcp_raw["mcpServers"])
                dst_mcp = tgt_gemini_cfg / "mcp_config.json"
                dst_mcp.write_text(json.dumps(mcp_raw, indent=2, ensure_ascii=False), encoding="utf-8")
                os.chmod(dst_mcp, 0o600)
                report["files_copied"].append("mcp_config.json")
            except Exception:
                _safe_copy(src_mcp, tgt_gemini_cfg / "mcp_config.json")

    # 4. Agent Skills & Plugins
    src_skills = src_gemini / "config" / "skills"
    if src_skills.is_dir():
        _safe_link_or_copy_dir(src_skills, tgt_gemini_cfg / "skills")

    src_plugins = src_gemini / "config" / "plugins"
    if src_plugins.is_dir():
        _safe_link_or_copy_dir(src_plugins, tgt_gemini_cfg / "plugins")

    # 5. Extensions
    if inherit_extensions:
        src_ext = (src_home / ".antigravity" / "extensions") if (src_home / ".antigravity" / "extensions").is_dir() else (src_home / ".vscode" / "extensions")
        if src_ext.is_dir():
            _safe_link_or_copy_dir(src_ext, tgt_home / ".antigravity" / "extensions")

    harden_profile_perms(target_profile_dir, profiles_dir)
    return report

def create_macos_app_shortcut(profile_name: str) -> Path:
    """Create a macOS native .app in ~/Applications so Spotlight and Dock can launch it."""
    if not IS_DARWIN:
        return None
    apps_dir = Path.home() / "Applications"
    apps_dir.mkdir(exist_ok=True)

    display_name = f"Antigravity ({profile_name})"
    target_app = apps_dir / f"{display_name}.app"
    script_path = Path(__file__).resolve()
    orig_icns = Path("/Applications/Antigravity.app/Contents/Resources/icon.icns")

    # Use the interpreter that is running us right now instead of a bare
    # "python3": applets launched from Spotlight only get the launchd PATH
    # (/usr/bin:/bin:/usr/sbin:/sbin), where python3 is the Command Line Tools
    # shim and fails if CLT is not installed.
    py_bin = (sys.executable or "python3").replace("'", "'\\''")
    script_escaped = str(script_path).replace("'", "'\\''")
    osa_cmd = f'''do shell script "'{py_bin}' '{script_escaped}' launch {profile_name} > /dev/null 2>&1 &"'''
    try:
        subprocess.run(["osacompile", "-o", str(target_app), "-e", osa_cmd], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if orig_icns.exists():
            res_dir = target_app / "Contents" / "Resources"
            res_dir.mkdir(exist_ok=True)
            shutil.copy2(orig_icns, res_dir / "applet.icns")
            subprocess.run(["touch", str(target_app)])
        return target_app
    except Exception:
        return None

def remove_macos_app_shortcut(profile_name: str):
    """Remove macOS .app shortcut for profile."""
    if not IS_DARWIN:
        return
    apps_dir = Path.home() / "Applications"
    if not apps_dir.exists():
        return
    # Exact names only — a glob like "Antigravity (zwe)*.app" would also match
    # unrelated bundles such as "Antigravity (zwe) copy.app".
    for app in (apps_dir / f"Antigravity ({profile_name}).app", apps_dir / f"Antigravity-{profile_name}.app"):
        if app.is_dir() and app.name.endswith(".app"):
            shutil.rmtree(app, ignore_errors=True)

def create_windows_shortcut(profile_name: str) -> Path | None:
    """Create a Windows .lnk shortcut in Start Menu and Desktop so Windows Search can find it."""
    if not IS_WINDOWS:
        return None
    try:
        appdata = os.environ.get("APPDATA")
        start_menu_dirs = []
        if appdata:
            start_menu_dirs.append(Path(appdata) / "Microsoft" / "Windows" / "Start Menu" / "Programs")
        desktop_dir = Path.home() / "Desktop"

        shortcut_name = f"Antigravity ({profile_name}).lnk"
        script_path = Path(__file__).resolve()
        py_exe = sys.executable
        app_bin = get_app_binary()

        created_path = None
        targets = []
        for sm in start_menu_dirs:
            if sm.is_dir():
                targets.append(sm / shortcut_name)
        if desktop_dir.is_dir():
            targets.append(desktop_dir / shortcut_name)

        if not targets:
            return None

        for target in targets:
            # All interpolated paths go through _ps_single_quote: a user
            # profile path containing an apostrophe (e.g. "O'Brien") would
            # otherwise break the script or inject PowerShell syntax.
            ps_script = (
                f"$ws = New-Object -ComObject WScript.Shell; "
                f"$s = $ws.CreateShortcut({_ps_single_quote(str(target))}); "
                f"$s.TargetPath = {_ps_single_quote(str(py_exe))}; "
                f"$s.Arguments = {_ps_single_quote(chr(34) + str(script_path) + chr(34) + ' launch ' + profile_name)}; "
                f"$s.IconLocation = {_ps_single_quote(str(app_bin) + ',0')}; "
                f"$s.WorkingDirectory = {_ps_single_quote(str(get_profiles_dir() / profile_name))}; "
                f"$s.Save()"
            )
            res = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_script], capture_output=True)
            if res.returncode == 0 and target.is_file():
                if not created_path:
                    created_path = target

        return created_path
    except Exception:
        return None

def remove_windows_shortcut(profile_name: str):
    """Remove Windows .lnk shortcuts in Start Menu and Desktop."""
    if not IS_WINDOWS:
        return
    try:
        appdata = os.environ.get("APPDATA")
        shortcut_name = f"Antigravity ({profile_name}).lnk"
        candidates = [Path.home() / "Desktop" / shortcut_name]
        if appdata:
            candidates.append(Path(appdata) / "Microsoft" / "Windows" / "Start Menu" / "Programs" / shortcut_name)
        for c in candidates:
            if c.is_file():
                c.unlink(missing_ok=True)
    except Exception:
        pass

def create_desktop_shortcut(profile_name: str) -> Path | None:
    if IS_DARWIN:
        return create_macos_app_shortcut(profile_name)
    elif IS_WINDOWS:
        return create_windows_shortcut(profile_name)
    return None

def remove_desktop_shortcut(profile_name: str):
    if IS_DARWIN:
        remove_macos_app_shortcut(profile_name)
    elif IS_WINDOWS:
        remove_windows_shortcut(profile_name)

def cmd_create(args):
    """Create a new isolated profile."""
    profiles_dir = get_profiles_dir()
    profiles_dir.mkdir(parents=True, exist_ok=True)

    name = args.name.strip()
    validate_profile_name(name)

    # Configuration inheritance & cloning validation BEFORE touching disk
    inherited_source = None
    if getattr(args, "clone_from", None) and getattr(args, "inherit_config", False):
        print(f"{COLOR_RED}Error: Cannot specify both --inherit-config and --clone-from.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    if getattr(args, "clone_from", None):
        clone_from = args.clone_from.strip()
        validate_profile_name(clone_from)
        if clone_from == name:
            print(f"{COLOR_RED}Error: Cannot clone a profile from itself.{COLOR_RESET}", file=sys.stderr)
            sys.exit(1)
        src_profile = profiles_dir / clone_from
        if not src_profile.is_dir() or not (src_profile / "profile.json").is_file():
            print(f"{COLOR_RED}Error: Source profile '{clone_from}' does not exist or has no profile.json.{COLOR_RESET}", file=sys.stderr)
            sys.exit(1)
        inherited_source = clone_from
    elif getattr(args, "inherit_config", False):
        inherited_source = "host"

    profile_dir = profiles_dir / name
    if profile_dir.exists():
        harden_profile_perms(profile_dir, profiles_dir)
        print(f"{COLOR_RED}Error: Profile '{name}' already exists at {profile_dir}{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    data_dir = profile_dir / "data"
    home_dir = profile_dir / "home"
    data_dir.mkdir(parents=True, exist_ok=True)
    home_dir.mkdir(parents=True, exist_ok=True)
    harden_profile_perms(profile_dir, profiles_dir)

    # Symlink developer configs from real HOME according to the chosen policy
    setup_home_symlinks(Path.home(), home_dir, args.links)

    inheritance_report = None
    if inherited_source:
        inherit_mcp = not getattr(args, "no_mcp", False)
        inheritance_report = setup_profile_inheritance(
            profile_dir,
            source=inherited_source,
            inherit_mcp=inherit_mcp
        )

    # Create profile metadata
    meta = {
        "name": name,
        "description": args.description or "",
        "symlink_policy": args.links,
        "inherited_from": inherited_source,
        "created_at": datetime.now().isoformat(),
        "version": 1
    }
    with open(profile_dir / "profile.json", "w", encoding="utf-8") as f:
        json.dump(meta, f, indent=2)

    app_path = create_desktop_shortcut(name)

    print(f"{COLOR_GREEN}✓ Profile '{COLOR_BOLD}{name}{COLOR_RESET}{COLOR_GREEN}' created successfully!{COLOR_RESET}")
    print(f"  • Sandbox Dir: {profile_dir}")
    if inherited_source:
        source_label = "host environment" if inherited_source == "host" else f"profile '{inherited_source}'"
        items = []
        if inheritance_report and inheritance_report.get("files_copied"):
            items.extend(inheritance_report["files_copied"])
        if inheritance_report and inheritance_report.get("dirs_linked"):
            items.extend(inheritance_report["dirs_linked"])
        items_str = ", ".join(sorted(set(items))) if items else "settings"
        print(f"  • Inherited:   {COLOR_CYAN}{source_label}{COLOR_RESET} ({items_str})")
        print(f"  • Security:    {COLOR_GREEN}Credentials & session tokens isolated (0700){COLOR_RESET}")
    if app_path:
        label = "macOS App:" if IS_DARWIN else "Shortcut:"
        search_hint = "Spotlight Cmd+Space" if IS_DARWIN else "Start Menu Win+S"
        print(f"  • {label:<12} {COLOR_CYAN}{app_path.name}{COLOR_RESET} (Search via {COLOR_BOLD}{search_hint}{COLOR_RESET})")
    print(f"  • CLI Launch:  {COLOR_CYAN}paragravity launch {name}{COLOR_RESET} (or {COLOR_CYAN}pgrav launch {name}{COLOR_RESET})")

    if getattr(args, "launch", False):
        print()
        cmd_launch(args)

def profile_summary(profile_dir: Path, include_size: bool = False) -> dict:
    """Machine-readable summary of one profile (used by both `list --json`
    and the human table)."""
    name = profile_dir.name
    data_dir = profile_dir / "data"
    pid = get_profile_process(profile_dir, data_dir)
    acc_info = extract_account_info(profile_dir)

    meta = {}
    meta_file = profile_dir / "profile.json"
    if meta_file.is_file():
        try:
            meta = json.loads(meta_file.read_text())
        except Exception:
            pass

    return {
        "name": name,
        "running": bool(pid),
        "pid": pid or None,
        "account": acc_info.get("email"),
        "has_token": acc_info.get("has_token", False),
        "token_exp": acc_info.get("token_exp"),
        "token_state": token_expiry_state(acc_info.get("token_exp")),
        "size": get_directory_size(profile_dir) if include_size else None,
        "directory": str(profile_dir),
        "created_at": meta.get("created_at"),
        "description": meta.get("description", ""),
        "inherited_from": meta.get("inherited_from"),
    }

def cmd_list(args):
    """List all profiles, their status, and bound accounts."""
    as_json = bool(getattr(args, "json", False))
    profiles_dir = get_profiles_dir()
    if not profiles_dir.exists():
        # --json must emit valid JSON on stdout; human hints go to stderr.
        if as_json:
            print("[]")
        else:
            print(f"{COLOR_YELLOW}No profiles found. Create one with: paragravity create <name>{COLOR_RESET}")
        return

    profiles = sorted([p for p in profiles_dir.iterdir() if p.is_dir() and (p / "profile.json").exists()])
    if not profiles:
        if as_json:
            print("[]")
        else:
            print(f"{COLOR_YELLOW}No profiles found in {profiles_dir}.{COLOR_RESET}")
            print(f"Run: {COLOR_CYAN}paragravity create <name>{COLOR_RESET} to create your first profile.")
        return

    include_size = bool(getattr(args, "size", False))
    summaries = [profile_summary(p, include_size=include_size) for p in profiles]

    if as_json:
        print(json.dumps(summaries, indent=2, ensure_ascii=False))
        return

    print(f"\n{COLOR_BOLD}{'PROFILE':<18} {'STATUS':<14} {'PID':<8} {'ACCOUNT (GOOGLE)':<30} {'SIZE':<10} {'DESCRIPTION'}{COLOR_RESET}")
    print("─" * 95)

    for s in summaries:
        p = profiles_dir / s["name"]

        if s["running"]:
            status_str = f"{COLOR_GREEN}● Running{COLOR_RESET}"
            pid_str = str(s["pid"])
        else:
            status_str = f"{COLOR_DIM}○ Stopped{COLOR_RESET}"
            pid_str = "-"

        email_str = s["account"] or f"{COLOR_DIM}(Not signed in){COLOR_RESET}"
        if len(strip_ansi(email_str)) > 28:
            email_str = email_str[:25] + "..."

        size_str = s["size"] if include_size else "—"

        warn = ""
        if s["token_state"] == "expired":
            warn = f"{COLOR_RED}⚠ token expired{COLOR_RESET}"
        elif s["token_state"] == "expiring":
            warn = f"{COLOR_YELLOW}⚠ token expires soon{COLOR_RESET}"

        c_name = pad_visible(f"{COLOR_BOLD}{s['name']}{COLOR_RESET}", 18)
        c_status = pad_visible(status_str, 14)
        c_pid = pad_visible(pid_str, 8)
        c_email = pad_visible(email_str, 30)
        c_size = pad_visible(size_str, 10)

        print(f"{c_name} {c_status} {c_pid} {c_email} {c_size} {s['description']} {warn}".rstrip())
    print()

def prune_logs(log_dir: Path, keep: int = 10):
    """Keep only the most recent `keep` launch logs."""
    try:
        logs = sorted(log_dir.glob("launch-*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in logs[keep:]:
            old.unlink(missing_ok=True)
    except OSError:
        pass

def cmd_launch(args):
    """Launch an Antigravity instance for a profile."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_YELLOW}Profile '{name}' does not exist.{COLOR_RESET}")
        create_it = prompt_yes_no("Would you like to create it now? [y/N]: ")
        if create_it:
            args.description = "Auto-created on launch"
            if not getattr(args, "links", None):
                args.links = "full"
            cmd_create(args)
        else:
            sys.exit(1)

    meta = {}
    meta_file = profile_dir / "profile.json"
    if meta_file.is_file():
        try:
            meta = json.loads(meta_file.read_text())
        except Exception:
            pass

    workspace = None
    if getattr(args, "path", None):
        workspace = Path(args.path).expanduser().resolve()
        if not workspace.exists():
            print(f"{COLOR_RED}Error: workspace path does not exist:{COLOR_RESET} {workspace}", file=sys.stderr)
            sys.exit(1)

    data_dir = profile_dir / "data"
    home_dir = profile_dir / "home"

    pid = get_profile_process(profile_dir, data_dir)
    if pid:
        print(f"{COLOR_YELLOW}Profile '{name}' is already running (PID: {pid}).{COLOR_RESET}")
        return

    app_bin = getattr(args, "app", None) or get_app_binary()
    if not os.path.isfile(app_bin):
        print(f"{COLOR_RED}Error: Antigravity executable not found at:{COLOR_RESET} {app_bin}", file=sys.stderr)
        print("Please specify path using --app or set ANTIGRAVITY_BIN env var.", file=sys.stderr)
        sys.exit(1)

    policy = getattr(args, "links", None) or meta.get("symlink_policy", "full")
    setup_home_symlinks(Path.home(), home_dir, policy)
    harden_profile_perms(profile_dir, profiles_dir)

    env = os.environ.copy()
    env["HOME"] = str(home_dir.resolve())
    if IS_WINDOWS:
        env["USERPROFILE"] = str(home_dir.resolve())
        roaming_appdata = home_dir / "AppData" / "Roaming"
        local_appdata = home_dir / "AppData" / "Local"
        roaming_appdata.mkdir(parents=True, exist_ok=True)
        local_appdata.mkdir(parents=True, exist_ok=True)
        env["APPDATA"] = str(roaming_appdata.resolve())
        env["LOCALAPPDATA"] = str(local_appdata.resolve())

    # Bypass macOS Keychain for language_server: forces file-based token storage (~/.gemini/jetski-standalone-oauth-token)
    # This prevents keychain prompt collisions and isolates tokens per profile.
    env["SSH_CONNECTION"] = "127.0.0.1 50000 127.0.0.1 22"
    env["SSH_CLIENT"] = "127.0.0.1 50000 22"

    cmd = [
        app_bin,
        f"--user-data-dir={data_dir.resolve()}"
    ]
    if workspace:
        cmd.append(str(workspace))

    if IS_WINDOWS and (str(app_bin).lower().endswith(".cmd") or str(app_bin).lower().endswith(".bat")):
        cmd = ["cmd.exe", "/c", *cmd]

    print(f"{COLOR_CYAN}Launching Antigravity for profile '{COLOR_BOLD}{name}{COLOR_RESET}{COLOR_CYAN}'...{COLOR_RESET}")
    print(f"  • User Data: {data_dir}")
    print(f"  • Home Dir:  {home_dir}")
    if workspace:
        print(f"  • Workspace: {workspace}")

    if getattr(args, "foreground", False):
        try:
            popen_kwargs = {"env": env}
            if IS_WINDOWS:
                popen_kwargs["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP
            proc = subprocess.Popen(cmd, **popen_kwargs)
            (profile_dir / "run.pid").write_text(str(proc.pid))
            proc.wait()
        except KeyboardInterrupt:
            print("\nTerminating process...")
        finally:
            (profile_dir / "run.pid").unlink(missing_ok=True)
    else:
        log_dir = profile_dir / "logs"
        log_dir.mkdir(exist_ok=True)
        # Pid suffix avoids two launches in the same second writing to one file.
        log_path = log_dir / time.strftime(f"launch-%Y%m%d-%H%M%S-{os.getpid()}.log")
        with open(log_path, "ab") as log_f:
            popen_kwargs = {
                "env": env,
                "stdout": log_f,
                "stderr": subprocess.STDOUT,
            }
            if IS_WINDOWS:
                popen_kwargs["creationflags"] = (
                    subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.DETACHED_PROCESS
                )
            else:
                popen_kwargs["start_new_session"] = True
            proc = subprocess.Popen(cmd, **popen_kwargs)
        (profile_dir / "run.pid").write_text(str(proc.pid))
        # Prune after the new log exists so the new file is counted in `keep`.
        prune_logs(log_dir)
        print(f"{COLOR_GREEN}✓ Antigravity window launched! (PID: {proc.pid}){COLOR_RESET}")
        print(f"  Logs:         {log_path} (view with: {COLOR_CYAN}pgrav logs {name}{COLOR_RESET})")
        print(f"  Tip: Sign in with your Google account in this window to bind it to '{name}'.")

def _group_alive(pgid: int) -> bool:
    """True when at least one process still belongs to the process group."""
    try:
        os.kill(pgid, 0)
        return True
    except OSError:
        return False

def _child_pids(pid: int) -> list:
    """Direct children of pid (pgrep -P)."""
    try:
        out = subprocess.check_output(["pgrep", "-P", str(pid)], stderr=subprocess.DEVNULL)
        return [int(p) for p in out.decode().split() if p.strip().isdigit()]
    except Exception:
        return []

def cmd_stop(args):
    """Stop running instance of a profile."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    data_dir = profile_dir / "data"
    pid = get_profile_process(profile_dir, data_dir)
    if not pid:
        print(f"{COLOR_YELLOW}Profile '{name}' is not currently running.{COLOR_RESET}")
        return

    print(f"Stopping profile '{name}' (PID: {pid})...")
    if IS_WINDOWS:
        try:
            kill_cmd = ["taskkill", "/PID", str(pid), "/T"]
            if getattr(args, "force", False):
                kill_cmd.append("/F")
            subprocess.run(kill_cmd, capture_output=True)
            for _ in range(30):
                if not is_pid_running(pid):
                    break
                time.sleep(0.1)
            if is_pid_running(pid):
                # Report honestly — never claim success while the process lives.
                if getattr(args, "force", False):
                    print(f"{COLOR_RED}Error: could not stop profile '{name}' (PID {pid}).{COLOR_RESET}", file=sys.stderr)
                else:
                    print(f"{COLOR_RED}Profile '{name}' is still running; try: paragravity stop {name} --force{COLOR_RESET}")
                sys.exit(1)
            (profile_dir / "run.pid").unlink(missing_ok=True)
            print(f"{COLOR_GREEN}✓ Profile '{name}' stopped.{COLOR_RESET}")
            return
        except Exception as e:
            print(f"{COLOR_RED}Error stopping process {pid}: {e}{COLOR_RESET}")
            return

    try:
        group_leader = pid == os.getpgid(pid)
    except (ProcessLookupError, PermissionError):
        group_leader = False

    # Foreground launches share the caller's process group, so the process
    # group trick can't reach their children — track direct children
    # individually instead (language_server & helpers are direct children).
    children = [] if group_leader else _child_pids(pid)

    def _kill(sig, target):
        try:
            os.kill(target, sig)
        except (ProcessLookupError, PermissionError):
            pass

    def _stragglers_alive():
        return any(is_pid_running(c) for c in children)

    def _wait_main(deadline_s):
        """Wait for the Electron main process to exit."""
        for _ in range(int(deadline_s / 0.1)):
            if not is_pid_running(pid):
                return True
            time.sleep(0.1)
        return not is_pid_running(pid)

    def _wait_all(deadline_s):
        """Wait until the instance is fully gone; the main process dying alone
        is not enough — straggler children count too."""
        for _ in range(int(deadline_s / 0.1)):
            if not is_pid_running(pid) and not (group_leader and _group_alive(-pid)) and not _stragglers_alive():
                return True
            time.sleep(0.1)
        return not (is_pid_running(pid) or (group_leader and _group_alive(-pid)) or _stragglers_alive())

    def _still_alive():
        return is_pid_running(pid) or (group_leader and _group_alive(-pid)) or _stragglers_alive()

    try:
        # Stage 1: SIGTERM the Electron main process only, so it can shut down
        # its own children and save workspace state cleanly.
        _kill(signal.SIGTERM, pid)
        _wait_main(3.0)
        # Stage 2: SIGTERM the whole group (language_server etc.) — also
        # reaps stragglers that outlived the main process. In the foreground
        # case there is no group to signal, so hit the children directly.
        if group_leader and _group_alive(-pid):
            _kill(signal.SIGTERM, -pid)
        for child in children:
            _kill(signal.SIGTERM, child)
        if group_leader or children:
            _wait_all(5.0)
        # Stage 3: SIGKILL only on request.
        if _still_alive():
            if getattr(args, "force", False):
                _kill(signal.SIGKILL, -pid if group_leader else pid)
                for child in children:
                    _kill(signal.SIGKILL, child)
                _wait_all(3.0)
            if _still_alive():
                if getattr(args, "force", False):
                    print(f"{COLOR_RED}Error: could not stop profile '{name}' even with --force.{COLOR_RESET}", file=sys.stderr)
                else:
                    print(f"{COLOR_RED}Profile '{name}' is still running; try: paragravity stop {name} --force{COLOR_RESET}")
                sys.exit(1)
        (profile_dir / "run.pid").unlink(missing_ok=True)
        print(f"{COLOR_GREEN}✓ Profile '{name}' stopped.{COLOR_RESET}")
    except Exception as e:
        print(f"{COLOR_RED}Error stopping process {pid}: {e}{COLOR_RESET}")

def cmd_delete(args):
    """Delete a profile and its shortcuts."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    data_dir = profile_dir / "data"
    pid = get_profile_process(profile_dir, data_dir)
    if pid:
        print(f"{COLOR_RED}Error: Profile '{name}' is currently running (PID: {pid}). Stop it first with: paragravity stop {name}{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    if not getattr(args, "force", False):
        confirm = prompt_yes_no(f"Are you sure you want to permanently delete profile '{name}'? [y/N]: ")
        if not confirm:
            print("Aborted.")
            return

    remove_desktop_shortcut(name)
    shutil.rmtree(profile_dir, ignore_errors=True)
    print(f"{COLOR_GREEN}✓ Profile '{name}' and its shortcuts deleted.{COLOR_RESET}")

def cmd_info(args):
    """Show detailed diagnostic profile info."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    data_dir = profile_dir / "data"
    pid = get_profile_process(profile_dir, data_dir)
    acc_info = extract_account_info(profile_dir)
    size_str = get_directory_size(profile_dir)

    meta = {}
    meta_file = profile_dir / "profile.json"
    if meta_file.is_file():
        try:
            meta = json.loads(meta_file.read_text())
        except Exception:
            pass

    if getattr(args, "json", False):
        print(json.dumps({
            "name": name,
            "running": bool(pid),
            "pid": pid or None,
            "directory": str(profile_dir),
            "size": size_str,
            "account": acc_info["email"],
            "has_token": acc_info["has_token"],
            "token_exp": acc_info.get("token_exp"),
            "token_state": token_expiry_state(acc_info.get("token_exp")),
            "inherited_from": meta.get("inherited_from"),
            "description": meta.get("description", ""),
        }, indent=2, ensure_ascii=False))
        return

    print(f"\n{COLOR_BOLD}=== Profile: {name} ==={COLOR_RESET}")
    print(f"Status:       {COLOR_GREEN}Running (PID: {pid}){COLOR_RESET}" if pid else f"Status:       {COLOR_DIM}Stopped{COLOR_RESET}")
    print(f"Directory:    {profile_dir}")
    print(f"Storage Size: {size_str}")
    if meta.get("inherited_from"):
        src_label = "host environment" if meta["inherited_from"] == "host" else f"profile '{meta['inherited_from']}'"
        print(f"Inherited:    {src_label}")
    print(f"Account:      {acc_info['email'] or '(Not signed in)'}")
    print(f"OAuth Token:  {'Active' if acc_info['has_token'] else 'None'}")
    if acc_info.get("token_exp"):
        print(f"Token Expiry: {acc_info['token_exp']}")
    print()

def cmd_path(args):
    """Print the absolute directory path of a profile."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name
    if profile_dir.exists():
        print(profile_dir.resolve())
    else:
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

def cmd_logs(args):
    """Show (and optionally follow) the latest launch log of a profile."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    log_dir = profile_dir / "logs"
    logs = sorted(log_dir.glob("*.log"), key=lambda p: p.stat().st_mtime, reverse=True) if log_dir.is_dir() else []
    if not logs:
        print(f"{COLOR_YELLOW}No logs yet for '{name}'. Logs are written on each background 'pgrav launch {name}'.{COLOR_RESET}")
        return

    log_path = logs[0]
    n_lines = max(0, args.lines)  # `lines[-0:]` would dump the whole file
    try:
        with open(log_path, "rb") as f:
            # Show at most the last 128 KB of the newest log.
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 128 * 1024))
            lines = f.read().decode("utf-8", "replace").splitlines()
            for line in (lines[-n_lines:] if n_lines else []):
                print(line)
            if not args.follow:
                return
            offset = f.tell()
            print(f"{COLOR_DIM}--- following {log_path.name} (Ctrl+C to stop) ---{COLOR_RESET}")
            while True:
                f.seek(offset)
                chunk = f.read()
                if chunk:
                    sys.stdout.write(chunk.decode("utf-8", "replace"))
                    sys.stdout.flush()
                    offset += len(chunk)
                time.sleep(0.5)
    except KeyboardInterrupt:
        print()

def cmd_web(args):
    """Start the modern Web Console & lightweight Widget HUD."""
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    try:
        from web_server import start_server
    except ImportError:
        print(f"{COLOR_RED}Error: web_server module not found.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)
    port = getattr(args, "port", 3888)
    no_browser = getattr(args, "no_browser", False)
    widget_mode = getattr(args, "widget", False) or getattr(args, "command", "") == "widget"
    start_server(port=port, open_browser=not no_browser, widget_mode=widget_mode)

def main():
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass
    if hasattr(sys.stderr, "reconfigure"):
        try:
            sys.stderr.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass

    if IS_WINDOWS:
        try:
            import ctypes
            kernel32 = ctypes.windll.kernel32
            handle = kernel32.GetStdHandle(-11)
            mode = ctypes.c_ulong()
            if kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
                kernel32.SetConsoleMode(handle, mode.value | 0x0004)
        except Exception:
            pass

    parser = argparse.ArgumentParser(
        prog="paragravity",
        description=f"ParaGravity v{VERSION} - Native parallel multi-account & sandbox manager for Google Antigravity.",
        epilog="Tip: You can also use the short alias 'pgrav' instead of 'paragravity'."
    )
    parser.add_argument("-v", "--version", action="version", version=f"paragravity {VERSION}")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # create
    p_create = subparsers.add_parser("create", help="Create a new isolated profile")
    p_create.add_argument("name", help="Profile name (e.g. zwe, work, personal)")
    p_create.add_argument("-d", "--description", help="Short description")
    p_create.add_argument("-l", "--launch", action="store_true", help="Launch immediately after creation")
    p_create.add_argument("-i", "--inherit-config", action="store_true",
                          help="Inherit user settings, keybindings, snippets, skills and MCP config from host environment (credentials/tokens are never copied)")
    p_create.add_argument("--clone-from", metavar="SOURCE_PROFILE",
                          help="Clone settings, keybindings, snippets and configs from an existing profile")
    p_create.add_argument("--no-mcp", action="store_true",
                          help="Do not inherit MCP tool configuration when using --inherit-config or --clone-from")
    p_create.add_argument("--links", choices=("full", "minimal", "none"), default="full",
                          help="How much of the real HOME to expose inside the profile "
                               "(full links everything incl. ~/.ssh/.config; minimal skips "
                               "those dotdirs; none links nothing but the keychain bridge)")
    p_create.set_defaults(func=cmd_create)

    # list / ls
    p_list = subparsers.add_parser("list", aliases=["ls"], help="List all profiles and status")
    p_list.add_argument("--size", action="store_true", help="Also compute on-disk size of each profile (slow for large profiles)")
    p_list.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    p_list.set_defaults(func=cmd_list)

    # launch / start
    p_launch = subparsers.add_parser("launch", aliases=["start"], help="Launch Antigravity instance for profile")
    p_launch.add_argument("name", help="Profile name to launch")
    p_launch.add_argument("path", nargs="?", default=None, help="Optional workspace/project path to open")
    p_launch.add_argument("-f", "--foreground", action="store_true", help="Run in foreground (attached to terminal)")
    p_launch.add_argument("--app", help="Path to Antigravity binary")
    p_launch.add_argument("--links", choices=("full", "minimal", "none"), default=None,
                          help="Override the profile's stored symlink policy for this launch")
    p_launch.set_defaults(func=cmd_launch)

    # stop
    p_stop = subparsers.add_parser("stop", help="Stop running instance of profile")
    p_stop.add_argument("name", help="Profile name to stop")
    p_stop.add_argument("--force", action="store_true", help="Force kill (SIGKILL)")
    p_stop.set_defaults(func=cmd_stop)

    # delete / rm
    p_delete = subparsers.add_parser("delete", aliases=["rm"], help="Delete a profile")
    p_delete.add_argument("name", help="Profile name to delete")
    p_delete.add_argument("-f", "--force", action="store_true", help="Skip confirmation prompt")
    p_delete.set_defaults(func=cmd_delete)

    # info
    p_info = subparsers.add_parser("info", help="Show detailed profile info")
    p_info.add_argument("name", help="Profile name")
    p_info.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    p_info.set_defaults(func=cmd_info)

    # path
    p_path = subparsers.add_parser("path", help="Print profile directory path")
    p_path.add_argument("name", help="Profile name")
    p_path.set_defaults(func=cmd_path)

    # logs
    p_logs = subparsers.add_parser("logs", help="Show the latest launch log of a profile")
    p_logs.add_argument("name", help="Profile name")
    p_logs.add_argument("-f", "--follow", action="store_true", help="Keep streaming new output")
    p_logs.add_argument("-n", "--lines", type=int, default=50, help="Number of trailing lines to show (default 50)")
    p_logs.set_defaults(func=cmd_logs)

    # web / ui / widget
    p_web = subparsers.add_parser("web", aliases=["ui", "widget"], help="Launch modern Web Console or compact widget HUD")
    p_web.add_argument("-p", "--port", type=int, default=3888, help="Port to listen on (default: 3888)")
    p_web.add_argument("-w", "--widget", action="store_true", help="Launch compact floating widget view directly")
    p_web.add_argument("--no-browser", action="store_true", help="Do not open browser automatically")
    p_web.set_defaults(func=cmd_web)

    if len(sys.argv) == 1:
        cmd_list(None)
        parser.print_help()
        sys.exit(0)

    args, extra = parser.parse_known_args()
    # Optional `path` positional after flags needs this fallback on Python <3.10
    # — but only for subcommands that actually declare `path` (launch); other
    # commands must still reject unexpected positionals instead of swallowing
    # them silently.
    if extra and hasattr(args, "path") and getattr(args, "path", None) is None and not extra[0].startswith("-"):
        args.path = extra.pop(0)
    if extra:
        parser.error(f"unrecognized arguments: {' '.join(extra)}")
    if hasattr(args, "func"):
        try:
            args.func(args)
        except KeyboardInterrupt:
            sys.exit(130)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
