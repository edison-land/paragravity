#!/usr/bin/env python3
"""
ParaGravity (pgrav)
Native, non-invasive parallel multi-account & sandbox manager for Google Antigravity.

Repository: https://github.com/edison-land/paragravity
License: MIT
"""

from __future__ import annotations

import os
import re
import sys
import json
import time
import base64
import hashlib
import signal
import shutil
import argparse
import subprocess
from datetime import datetime, timedelta
from pathlib import Path
from typing import Optional

if sys.platform != "win32":
    import fcntl
    import pwd
else:
    fcntl = None
    pwd = None

VERSION = "1.3.0"

IS_WINDOWS = sys.platform == "win32"
IS_DARWIN = sys.platform == "darwin"


def _sys_passwd_home() -> Optional[Path]:
    """Return the OS passwd home directory on POSIX systems, if available."""
    if not IS_WINDOWS and pwd is not None:
        try:
            pw_dir = Path(pwd.getpwuid(os.getuid()).pw_dir)
            if pw_dir.is_dir():
                return pw_dir
        except Exception:
            pass
    return None


def get_real_home() -> Path:
    """Resolve the real OS user home even inside a ParaGravity sandboxed terminal,
    while respecting explicit test HOME overrides (when HOME is not inside a profile)."""
    override = os.environ.get("PARAGRAVITY_REAL_HOME", "").strip()
    if override:
        return Path(override).expanduser()

    env_home = Path.home()
    parts = env_home.parts
    if len(parts) >= 3 and parts[-1] == "home" and parts[-3] == ".antigravity-profiles":
        return Path(*parts[:-3])
    if env_home.name == "home" and (env_home.parent / "profile.json").is_file():
        return _sys_passwd_home() or env_home.parent.parent.parent
    return env_home


def is_ephemeral_test_home(real_home: Optional[Path] = None) -> bool:
    """Return True when running inside an isolated test HOME/temp directory so
    tests never touch the host's live launchd services."""
    if os.environ.get("PARAGRAVITY_NO_DAEMON") == "1":
        return True
    if real_home is None:
        real_home = get_real_home()
    if not IS_WINDOWS:
        pw = _sys_passwd_home()
        if pw is not None:
            try:
                if real_home.resolve() != pw.resolve():
                    return True
            except OSError:
                pass
    import tempfile
    try:
        tmp_root = Path(tempfile.gettempdir()).resolve()
        rh_res = real_home.resolve()
        if rh_res == tmp_root or tmp_root in rh_res.parents:
            return True
    except OSError:
        pass
    if "pgrav-" in str(real_home).lower():
        return True
    return False


def get_default_app_bin() -> str:
    real_home = get_real_home()
    if IS_WINDOWS:
        local_app_data = os.environ.get("LOCALAPPDATA")
        program_files = os.environ.get("PROGRAMFILES")
        program_files_x86 = os.environ.get("PROGRAMFILES(X86)")
        candidates = []
        if local_app_data:
            candidates.append(Path(local_app_data) / "Programs" / "Antigravity" / "Antigravity.exe")
            candidates.append(Path(local_app_data) / "Antigravity" / "Antigravity.exe")
        if program_files:
            candidates.append(Path(program_files) / "Antigravity" / "Antigravity.exe")
        if program_files_x86:
            candidates.append(Path(program_files_x86) / "Antigravity" / "Antigravity.exe")
        for c in candidates:
            if c.is_file():
                return str(c)
        which_exe = shutil.which("Antigravity.exe") or shutil.which("Antigravity")
        if which_exe:
            return which_exe
        return str(candidates[0]) if candidates else "Antigravity.exe"
    elif IS_DARWIN:
        mac_default = Path("/Applications/Antigravity.app/Contents/MacOS/Antigravity")
        if mac_default.is_file():
            return str(mac_default)
        alt = real_home / "Applications/Antigravity.app/Contents/MacOS/Antigravity"
        if alt.is_file():
            return str(alt)
        return str(mac_default)
    else:
        which_bin = shutil.which("antigravity") or shutil.which("Antigravity")
        return which_bin or "/usr/bin/antigravity"


DEFAULT_APP_BIN = get_default_app_bin()
DEFAULT_PROFILES_DIR = get_real_home() / ".antigravity-profiles"

# ANSI Colors — disabled when output is piped or NO_COLOR is set, so
# `pgrav list | cat`, `--json` consumers and CI logs stay clean.
_COLOR_ENABLED = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
COLOR_RESET = "\033[0m" if _COLOR_ENABLED else ""
COLOR_BOLD = "\033[1m" if _COLOR_ENABLED else ""
COLOR_GREEN = "\033[32m" if _COLOR_ENABLED else ""
COLOR_BLUE = "\033[34m" if _COLOR_ENABLED else ""
COLOR_YELLOW = "\033[33m" if _COLOR_ENABLED else ""
COLOR_RED = "\033[31m" if _COLOR_ENABLED else ""
COLOR_CYAN = "\033[36m" if _COLOR_ENABLED else ""
COLOR_DIM = "\033[2m" if _COLOR_ENABLED else ""

def get_profiles_dir() -> Path:
    env_dir = os.environ.get("PARAGRAVITY_PROFILES_DIR") or os.environ.get("AGY_PROFILES_DIR")
    if env_dir:
        return Path(env_dir).expanduser()
    return get_real_home() / ".antigravity-profiles"

def validate_profile_name(name: str):
    """Reject names that could escape the profiles directory or be interpreted by a shell."""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", name):
        print(f"{COLOR_RED}Error: Invalid profile name '{name}'. Use 1-64 characters: letters, digits, '.', '_', '-' (must start with a letter or digit).{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

def prompt_yes_no(message: str, default_no: bool = True) -> bool:
    """Read a y/n answer; on EOF (non-interactive stdin) fall back to the default."""
    try:
        answer = input(message).strip().lower()
    except EOFError:
        return not default_no
    return answer == "y" if answer else not default_no

def harden_profile_perms(profile_dir: Path, profiles_dir: Path):
    """Keep profile directories and sensitive files accessible to the owner only (0700/0600)."""
    if IS_WINDOWS:
        return
    try:
        targets = [
            profiles_dir,
            profile_dir,
            profile_dir / "data",
            profile_dir / "home",
            profile_dir / "home" / ".gemini",
            profile_dir / "home" / ".gemini" / "config",
            profile_dir / "home" / ".gemini" / "antigravity-cli",
            profile_dir / "data" / "User",
        ]
        for d in targets:
            if d.is_dir() and not d.is_symlink():
                os.chmod(d, 0o700)
    except OSError:
        pass

def get_app_binary() -> str:
    env_bin = os.environ.get("ANTIGRAVITY_BIN")
    if env_bin:
        if os.path.isfile(env_bin):
            return env_bin
        print(f"{COLOR_YELLOW}Warning: ANTIGRAVITY_BIN is set but not a file: {env_bin} — ignoring.{COLOR_RESET}", file=sys.stderr)
    return get_default_app_bin()

def get_directory_size(path: Path) -> str:
    """Calculate human-readable directory size."""
    if not path.exists():
        return "0 B"
    total_bytes = 0
    try:
        for p in path.rglob("*"):
            if p.is_file() and not p.is_symlink():
                total_bytes += p.stat().st_size
    except Exception:
        pass

    for unit in ["B", "KB", "MB", "GB"]:
        if total_bytes < 1024.0:
            return f"{total_bytes:.1f} {unit}"
        total_bytes /= 1024.0
    return f"{total_bytes:.1f} TB"

def decode_jwt_payload(jwt_str: str) -> dict:
    """Decode JWT payload without external libraries."""
    try:
        parts = jwt_str.strip().split(".")
        if len(parts) == 3 and re.fullmatch(r"[A-Za-z0-9_-]+", parts[1]):
            payload = parts[1]
            payload += "=" * (-len(payload) % 4)
            return json.loads(base64.urlsafe_b64decode(payload.encode("ascii")).decode("utf-8"))
    except Exception:
        pass
    return {}

def token_expiry_state(token_exp: str):
    """Classify a token expiry ISO timestamp: 'expired', 'expiring' (within
    7 days), or None when there is nothing to warn about."""
    if not token_exp:
        return None
    try:
        exp = datetime.fromisoformat(token_exp)
    except (TypeError, ValueError):
        return None
    now = datetime.now(exp.tzinfo) if exp.tzinfo else datetime.now()
    if exp < now:
        return "expired"
    if exp < now + timedelta(days=7):
        return "expiring"
    return None

def _parse_oauth_token_file(token_file: Path) -> dict:
    """Parse modern JSON or legacy JWT Antigravity/agy OAuth token files."""
    res = {
        "email": None,
        "token_exp": None,
        "access_token_exp": None,
        "has_token": False,
        "has_refresh_token": False,
        "auth_method": None,
        "mtime_ns": 0,
    }
    if not token_file.is_file():
        return res
    try:
        st = token_file.stat()
        res["mtime_ns"] = st.st_mtime_ns
        tok_raw = token_file.read_text(encoding="utf-8").strip()
    except Exception:
        return res
    if not tok_raw:
        return res

    # Modern Antigravity 2.0 & agy CLI store JSON:
    # {"token": {"access_token": ..., "refresh_token": ..., "expiry": ...}, "auth_method": ..., "id_token_email": ...}
    data = None
    try:
        data = json.loads(tok_raw)
    except Exception:
        data = None

    if isinstance(data, dict):
        tok = data.get("token") if isinstance(data.get("token"), dict) else data
        has_refresh = bool(tok.get("refresh_token") or data.get("refresh_token"))
        has_access = bool(
            tok.get("access_token")
            or data.get("access_token")
            or tok.get("id_token")
            or data.get("id_token")
        )
        res["has_refresh_token"] = has_refresh
        res["has_token"] = has_refresh or has_access
        res["auth_method"] = data.get("auth_method")

        email = data.get("id_token_email") or data.get("email") or tok.get("email")
        if not email:
            id_tok = tok.get("id_token") or data.get("id_token")
            if id_tok:
                email = decode_jwt_payload(str(id_tok)).get("email")
        if email:
            res["email"] = str(email).strip()

        access_exp = tok.get("expiry") or data.get("expiry")
        if access_exp:
            res["access_token_exp"] = str(access_exp)
        # OAuth2 refresh_token sessions auto-refresh on demand; do not trigger a false
        # "token expired" warning when the 1-hour access_token expiry is in the past.
        res["token_exp"] = None if has_refresh else res["access_token_exp"]
        return res

    # Legacy raw JWT string fallback
    claims = decode_jwt_payload(tok_raw)
    if claims:
        res["has_token"] = True
        if claims.get("email"):
            res["email"] = str(claims["email"]).strip()
        if claims.get("exp"):
            try:
                res["token_exp"] = datetime.fromtimestamp(claims["exp"]).isoformat()
            except Exception:
                pass
    return res

def extract_account_info(profile_dir: Path) -> dict:
    """Extract signed-in Google account information from profile data."""
    info = {
        "email": None,
        "token_exp": None,
        "has_token": False,
        "has_refresh_token": False,
    }
    gemini_dir = profile_dir / "home" / ".gemini"
    if gemini_dir.exists():
        candidates = [
            gemini_dir / "jetski-standalone-oauth-token",
            gemini_dir / "antigravity-cli" / "antigravity-oauth-token",
        ]
        parsed_list = [_parse_oauth_token_file(c) for c in candidates if c.is_file()]
        parsed_list.sort(key=lambda item: item.get("mtime_ns", 0), reverse=True)
        for parsed in parsed_list:
            if parsed["has_token"]:
                info["has_token"] = True
            if parsed["has_refresh_token"]:
                info["has_refresh_token"] = True
            if not info["email"] and parsed["email"]:
                info["email"] = parsed["email"]
            if info["token_exp"] is None and parsed["token_exp"]:
                info["token_exp"] = parsed["token_exp"]

        if not info["email"]:
            acc_file = gemini_dir / "google_accounts.json"
            if acc_file.is_file():
                try:
                    data = json.loads(acc_file.read_text(encoding="utf-8"))
                    active = data.get("active")
                    if active:
                        info["email"] = active
                except Exception:
                    pass

    if not info["email"]:
        app_storage = profile_dir / "data" / "app_storage.json"
        if app_storage.is_file():
            try:
                sdata = json.loads(app_storage.read_text(encoding="utf-8"))
                last_user = sdata.get("agy.onboarding.lastLoginUsername")
                if last_user and isinstance(last_user, str) and "@" in last_user and info["has_token"]:
                    info["email"] = last_user.strip()
            except Exception:
                pass

    return info

def get_host_app_support_dir() -> Path:
    real_home = get_real_home()
    if IS_WINDOWS:
        appdata = os.environ.get("APPDATA")
        return (Path(appdata) / "Antigravity") if appdata else (real_home / "AppData" / "Roaming" / "Antigravity")
    if IS_DARWIN:
        base = real_home / "Library" / "Application Support"
        for name in ("antigravity", "Antigravity"):
            cand = base / name
            if cand.is_dir():
                return cand
        return base / "antigravity"
    return real_home / ".config" / "Antigravity"

def get_host_process() -> int:
    """Return PID of the main native host Antigravity process (without --user-data-dir)."""
    if IS_WINDOWS:
        try:
            ps_cmd = (
                "Get-CimInstance Win32_Process | "
                "Where-Object { $_.Name -like '*Antigravity*' -and $_.CommandLine -notlike '*--type=*' -and $_.CommandLine -notlike '*--user-data-dir=*' } | "
                "Select-Object -ExpandProperty ProcessId"
            )
            out = subprocess.check_output(
                ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
                stderr=subprocess.DEVNULL
            )
            pids = [int(p) for p in out.decode("utf-8", "replace").split() if p.strip().isdigit()]
            return pids[0] if pids else 0
        except Exception:
            return 0
    try:
        out = subprocess.check_output(["ps", "-ax", "-o", "pid=,command="], stderr=subprocess.DEVNULL)
        for line in out.decode("utf-8", "replace").splitlines():
            line = line.strip()
            if not line:
                continue
            parts = line.split(None, 1)
            if len(parts) != 2 or not parts[0].isdigit():
                continue
            pid = int(parts[0])
            cmd = parts[1]
            if "--type=" in cmd or "--user-data-dir=" in cmd:
                continue
            if "Antigravity.app/Contents/MacOS/Antigravity" in cmd or (
                not IS_DARWIN and os.path.basename(cmd.split()[0]).lower() == "antigravity"
            ):
                return pid
    except Exception:
        pass
    return 0

def extract_host_info() -> dict:
    """Inspect real host Antigravity running status and signed-in account (metadata only, never secrets)."""
    real_home = get_real_home()
    gemini_dir = real_home / ".gemini"
    app_support = get_host_app_support_dir()
    pid = get_host_process()

    email = None
    has_token = False
    token_exp = None

    candidates = [
        gemini_dir / "jetski-standalone-oauth-token",
        gemini_dir / "antigravity-cli" / "antigravity-oauth-token",
    ]
    parsed_list = [_parse_oauth_token_file(c) for c in candidates if c.is_file()]
    parsed_list.sort(key=lambda item: item.get("mtime_ns", 0), reverse=True)
    for parsed in parsed_list:
        if parsed["has_token"]:
            has_token = True
        if not email and parsed["email"]:
            email = parsed["email"]
        if token_exp is None and parsed["token_exp"]:
            token_exp = parsed["token_exp"]

    if IS_DARWIN and not has_token:
        try:
            res = subprocess.run(
                ["security", "find-generic-password", "-s", "gemini", "-a", "antigravity"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=3,
            )
            if res.returncode == 0:
                has_token = True
        except Exception:
            pass

    if not email:
        acc_file = gemini_dir / "google_accounts.json"
        if acc_file.is_file():
            try:
                data = json.loads(acc_file.read_text(encoding="utf-8"))
                if data.get("active"):
                    email = str(data["active"]).strip()
            except Exception:
                pass

    if not email:
        for app_dir in (
            app_support,
            real_home / "Library" / "Application Support" / "antigravity",
            real_home / "Library" / "Application Support" / "Antigravity",
        ):
            app_storage = app_dir / "app_storage.json"
            if app_storage.is_file():
                try:
                    sdata = json.loads(app_storage.read_text(encoding="utf-8"))
                    last_user = sdata.get("agy.onboarding.lastLoginUsername")
                    if last_user and isinstance(last_user, str) and "@" in last_user:
                        email = last_user.strip()
                        break
                except Exception:
                    pass

    return {
        "name": "host",
        "running": bool(pid),
        "pid": pid or None,
        "account": email,
        "has_token": has_token,
        "token_exp": token_exp,
        "token_state": token_expiry_state(token_exp),
        "directory": str(gemini_dir),
    }

def strip_ansi(text: str) -> str:
    return re.sub(r'\x1b\[[0-9;]*m', '', text)

def pad_visible(text: str, width: int) -> str:
    visible_len = len(strip_ansi(text))
    padding = max(0, width - visible_len)
    return text + (" " * padding)

def is_pid_running(pid: int) -> bool:
    if pid <= 0:
        return False
    if IS_WINDOWS:
        try:
            import ctypes
            kernel32 = ctypes.windll.kernel32
            SYNCHRONIZE = 0x00100000
            PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
            handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, False, pid)
            if handle:
                exit_code = ctypes.c_ulong()
                kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code))
                kernel32.CloseHandle(handle)
                return exit_code.value == 259
        except Exception:
            pass
        try:
            res = subprocess.run(
                ["tasklist", "/FI", f"PID eq {pid}", "/NH"],
                capture_output=True, text=True, encoding="utf-8", errors="replace"
            )
            return str(pid) in (res.stdout or "")
        except Exception:
            return False
    else:
        try:
            os.kill(pid, 0)
            return True
        except (OSError, ProcessLookupError, SystemError):
            return False

def _ps_escape_like(text: str) -> str:
    """Escape PowerShell -like wildcards inside an embedded literal."""
    return (text.replace("[", "[[]")
                .replace("*", "[*]")
                .replace("?", "[?]"))

def _ps_single_quote(text: str) -> str:
    """Quote a string for a single-quoted PowerShell literal."""
    return "'" + text.replace("'", "''") + "'"

def _pid_matches_profile(pid: int, data_dir: Path) -> bool:
    """Confirm the live pid actually belongs to this profile.

    A stale run.pid can name a pid the OS has since recycled for an unrelated
    process — without this check `stop` would SIGTERM an innocent victim.
    """
    marker = f"--user-data-dir={data_dir.resolve()}"
    try:
        if IS_WINDOWS:
            ps_cmd = (
                f"(Get-CimInstance Win32_Process -Filter \"ProcessId = {pid}\").CommandLine"
            )
            out = subprocess.check_output(
                ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
                stderr=subprocess.DEVNULL
            )
            cmdline = out.decode("utf-8", "replace")
        else:
            out = subprocess.check_output(
                ["ps", "-o", "command=", "-p", str(pid)],
                stderr=subprocess.DEVNULL
            )
            cmdline = out.decode("utf-8", "replace")
    except Exception:
        return False
    return marker in cmdline or "Antigravity" in cmdline

def get_profile_process(profile_name: Path, data_dir: Path) -> int:
    """Check if Antigravity is running with this profile's data_dir."""
    pid_file = profile_name / "run.pid"
    if pid_file.is_file():
        try:
            pid = int(pid_file.read_text().strip())
            if is_pid_running(pid) and _pid_matches_profile(pid, data_dir):
                return pid
            # Stale or recycled pid — do not trust it.
            pid_file.unlink(missing_ok=True)
        except Exception:
            pass

    # Fallback to process search
    if IS_WINDOWS:
        try:
            like_path = _ps_escape_like(str(data_dir.resolve()))
            ps_cmd = (
                f"Get-CimInstance Win32_Process | "
                f"Where-Object {{ $_.ProcessId -ne $PID -and $_.Name -notlike '*powershell*' -and $_.Name -notlike '*pwsh*' -and $_.CommandLine -like {_ps_single_quote('*--user-data-dir=' + like_path + '*')} }} | "
                f"Select-Object -ExpandProperty ProcessId"
            )
            out = subprocess.check_output(
                ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
                stderr=subprocess.DEVNULL
            )
            pids = [int(p) for p in out.decode("utf-8", "replace").split() if p.strip().isdigit()]
            if pids:
                return pids[0]
        except Exception:
            pass
    else:
        try:
            # re.escape the path: PARAGRAVITY_PROFILES_DIR may contain regex
            # metacharacters that would otherwise widen the match.
            pattern = f"--user-data-dir={re.escape(str(data_dir.resolve()))}( |$)"
            out = subprocess.check_output(["pgrep", "-f", "--", pattern], stderr=subprocess.DEVNULL)
            pids = [int(p) for p in out.decode().split() if p.strip()]
            if pids:
                return pids[0]
        except Exception:
            pass

    return 0

def get_canonical_cli_path() -> Path:
    """Find the canonical executable path for paragravity CLI."""
    real_home = get_real_home()
    for cand in (
        real_home / ".local" / "bin" / "paragravity",
        real_home / ".paragravity" / "bin" / "paragravity",
    ):
        if cand.is_file() and os.access(cand, os.X_OK):
            return cand.resolve()
    which_pgrav = shutil.which("paragravity") or shutil.which("pgrav")
    if which_pgrav:
        try:
            resolved = Path(which_pgrav).resolve()
            if resolved.is_file():
                return resolved
        except Exception:
            pass
    return Path(__file__).resolve()

def get_installed_app_version(app_bin: Optional[str] = None) -> Optional[str]:
    """Detect current installed version of Google Antigravity binary."""
    if not app_bin:
        app_bin = get_app_binary()
    if not app_bin or not os.path.exists(app_bin):
        return None

    if IS_DARWIN:
        bin_path = Path(app_bin).resolve()
        plist_candidates = [
            bin_path.parent.parent / "Info.plist",
            Path("/Applications/Antigravity.app/Contents/Info.plist"),
            get_real_home() / "Applications/Antigravity.app/Contents/Info.plist",
        ]
        import plistlib
        for plist_path in plist_candidates:
            if plist_path.is_file():
                try:
                    with open(plist_path, "rb") as f:
                        pl = plistlib.load(f)
                        ver = pl.get("CFBundleShortVersionString") or pl.get("CFBundleVersion")
                        if ver:
                            return str(ver).strip()
                except Exception:
                    pass

    elif IS_WINDOWS:
        try:
            ps_cmd = f"(Get-Item -LiteralPath '{app_bin}').VersionInfo.ProductVersion"
            res = subprocess.run(
                ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
                capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=5
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip().split()[0]
        except Exception:
            pass

    else:
        try:
            res = subprocess.run([app_bin, "--version"], capture_output=True, text=True, timeout=5)
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip().splitlines()[0].strip()
        except Exception:
            pass

    return None

def clean_stale_locks(profile_dir: Path, data_dir: Optional[Path] = None) -> list[str]:
    """
    Clean stale Chromium/Electron lock files and socket handles if no active process is running.
    Zero data loss: never removes cookies, tokens, or local storage.
    """
    if data_dir is None:
        data_dir = profile_dir / "data"

    pid_file = profile_dir / "run.pid"
    had_pid_file = pid_file.exists()

    if get_profile_process(profile_dir, data_dir) > 0:
        return []

    cleaned = []
    lock_targets = [
        data_dir / "SingletonLock",
        data_dir / "SingletonSocket",
        data_dir / "SingletonCookie",
        data_dir / "DevToolsActivePort",
        profile_dir / "run.pid",
    ]
    for target in lock_targets:
        if os.path.lexists(str(target)):
            try:
                target.unlink(missing_ok=True)
                cleaned.append(target.name)
            except OSError:
                pass
    if had_pid_file and "run.pid" not in cleaned:
        cleaned.append("run.pid")
    return cleaned

def suppress_sandbox_autoupdate(profile_dir: Path) -> bool:
    """
    Disable auto-updater within profile sandbox to prevent quitAndInstall() collisions.
    1. Sets autoCheckForUpdates=false in data/app_storage.json (Electron StorageManager).
    2. Sets update.mode=none in data/User/settings.json (VS Code engine).
    Preserves all other settings, logins, and conversation data.
    """
    modified = False
    data_dir = profile_dir / "data"

    # 1. app_storage.json
    app_storage = data_dir / "app_storage.json"
    try:
        data = {}
        if app_storage.is_file():
            try:
                data = json.loads(app_storage.read_text(encoding="utf-8"))
            except Exception:
                data = {}
        if data.get("autoCheckForUpdates") != "false":
            data["autoCheckForUpdates"] = "false"
            data_dir.mkdir(parents=True, exist_ok=True)
            app_storage.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
            if not IS_WINDOWS:
                try:
                    os.chmod(app_storage, 0o600)
                except OSError:
                    pass
            modified = True
    except OSError:
        pass

    # 2. data/User/settings.json
    user_settings = data_dir / "User" / "settings.json"
    try:
        sdata = {}
        if user_settings.is_file():
            try:
                sdata = json.loads(user_settings.read_text(encoding="utf-8"))
            except Exception:
                sdata = {}
        if sdata.get("update.mode") != "none":
            sdata["update.mode"] = "none"
            user_settings.parent.mkdir(parents=True, exist_ok=True)
            user_settings.write_text(json.dumps(sdata, indent=2, ensure_ascii=False), encoding="utf-8")
            if not IS_WINDOWS:
                try:
                    os.chmod(user_settings, 0o600)
                except OSError:
                    pass
            modified = True
    except OSError:
        pass

    return modified

EPHEMERAL_CACHE_DIRS = [
    "Code Cache",
    "GPUCache",
    "DawnGraphiteCache",
    "DawnWebGPUCache",
    "Cache",
]

def heal_profile_environment(profile_dir: Path, force: bool = False, app_bin: Optional[str] = None) -> dict:
    """
    Auto-heal profile environment across AntiGravity updates:
    - Cleans stale locks if not running.
    - Purges obsolete bytecode / shader caches on version mismatch or force.
    - Suppresses auto-updater inside profile.
    - Updates last_app_version in profile.json.
    """
    data_dir = profile_dir / "data"
    active_pid = get_profile_process(profile_dir, data_dir)

    locks_cleaned = []
    if active_pid == 0:
        locks_cleaned = clean_stale_locks(profile_dir, data_dir)

    meta_file = profile_dir / "profile.json"
    meta = {}
    if meta_file.is_file():
        try:
            meta = json.loads(meta_file.read_text(encoding="utf-8"))
        except Exception:
            meta = {}

    last_ver = meta.get("last_app_version")
    current_ver = get_installed_app_version(app_bin)
    version_changed = bool(current_ver and last_ver != current_ver)

    purged_caches = []
    if (version_changed or force) and active_pid == 0 and data_dir.is_dir():
        for cache_name in EPHEMERAL_CACHE_DIRS:
            cdir = data_dir / cache_name
            if cdir.exists():
                try:
                    shutil.rmtree(cdir, ignore_errors=True)
                    purged_caches.append(cache_name)
                except OSError:
                    pass

        if current_ver:
            meta["last_app_version"] = current_ver
            try:
                meta_file.write_text(json.dumps(meta, indent=2, ensure_ascii=False), encoding="utf-8")
            except OSError:
                pass

    updater_suppressed = suppress_sandbox_autoupdate(profile_dir)

    return {
        "active_pid": active_pid,
        "locks_cleaned": locks_cleaned,
        "version_changed": version_changed,
        "old_version": last_ver,
        "new_version": current_ver,
        "caches_purged": purged_caches,
        "updater_suppressed": updater_suppressed,
    }

# Items symlinked from the real HOME into a profile's fake HOME, by policy.
# "full" (default) maximizes developer comfort but exposes the real ~/.ssh and
# ~/.config to whatever runs inside the profile; "minimal" drops the sensitive
# dotdirs; "none" links nothing.
LINK_ITEMS_FULL = [
    ".zshrc", ".zshenv", ".zprofile",
    ".bashrc", ".bash_profile", ".profile",
    ".gitconfig", ".gitignore_global",
    ".ssh", ".config",
    ".npmrc", ".yarnrc",
    ".agents", ".agent",
    ".orca", "orca",
    ".local", ".nvm", ".npm", ".bun", ".cargo", ".rustup",
    ".opencode", ".minimax",
    ".claude", ".codex", ".omp", ".dsh", ".paseo", ".t3", ".lark-cli", ".hindsight",
    "Desktop", "Documents", "Downloads", "Projects", "Developer", "work", "reports",
]
LINK_ITEMS_MINIMAL = [
    i for i in LINK_ITEMS_FULL
    if i not in (".ssh", ".config", ".npmrc", ".yarnrc", ".claude", ".codex", ".opencode", ".minimax", ".lark-cli", ".dsh")
]
SYMLINK_POLICIES = {
    "full": LINK_ITEMS_FULL,
    "minimal": LINK_ITEMS_MINIMAL,
    "none": [],
}

def create_symlink_or_junction(src: Path, dst: Path) -> bool:
    """
    Safely link src to dst.
    On Windows, uses directory junctions (mklink /J or _winapi.CreateJunction)
    for directories because junctions require no Administrator or Developer Mode privileges.
    On Unix/macOS, creates standard symlinks.
    """
    try:
        if dst.exists() or dst.is_symlink():
            return False
        dst.parent.mkdir(parents=True, exist_ok=True)
        if IS_WINDOWS and src.is_dir():
            try:
                import _winapi
                _winapi.CreateJunction(str(src), str(dst))
                return True
            except (AttributeError, OSError):
                res = subprocess.run(["cmd", "/c", "mklink", "/J", str(dst), str(src)], capture_output=True)
                if res.returncode == 0:
                    return True
        dst.symlink_to(src)
        return True
    except OSError:
        if IS_WINDOWS and src.is_file():
            try:
                shutil.copy2(src, dst)
                return True
            except OSError:
                pass
        return False

def setup_home_symlinks(real_home: Path, profile_home: Path, policy: str = "full"):
    """
    Symlink configuration & directories from the real HOME into the profile's
    fake HOME, according to the profile's policy ("full", "minimal" or "none").
    """
    profile_home.mkdir(parents=True, exist_ok=True)
    (profile_home / ".gemini").mkdir(exist_ok=True)

    link_items = SYMLINK_POLICIES.get(policy, LINK_ITEMS_FULL)

    for item in link_items:
        src = real_home / item
        dst = profile_home / item
        if src.exists() and not dst.exists() and not dst.is_symlink():
            create_symlink_or_junction(src, dst)

    if IS_DARWIN:
        real_kc = real_home / "Library" / "Keychains"
        prof_lib = profile_home / "Library"
        prof_lib.mkdir(exist_ok=True)
        prof_kc = prof_lib / "Keychains"
        if real_kc.exists() and not prof_kc.exists() and not prof_kc.is_symlink():
            try:
                prof_kc.symlink_to(real_kc)
            except Exception:
                pass

def sanitize_mcp_servers(servers) -> dict:
    """Strip secret-looking values from an mcpServers mapping.

    MCP server definitions routinely embed API keys/tokens in `env` and
    `headers` — the "credentials are never copied" guarantee has to reach
    into these, or --inherit-config would leak keys into every clone.
    """
    secret_key = re.compile(r"key|token|secret|password|credential|auth|signature|private", re.IGNORECASE)
    if not isinstance(servers, dict):
        return servers
    clean = {}
    for srv_name, srv in servers.items():
        if isinstance(srv, dict):
            srv = dict(srv)
            for field in ("env", "headers"):
                if isinstance(srv.get(field), dict):
                    srv[field] = {
                        k: ("" if secret_key.search(str(k)) else v)
                        for k, v in srv[field].items()
                    }
        clean[srv_name] = srv
    return clean


def setup_profile_inheritance(
    target_profile_dir: Path,
    source: str,
    inherit_mcp: bool = True,
    inherit_extensions: bool = True
) -> dict:
    """
    Safely inherit or clone non-credential configuration from the host
    environment (source="host") or an existing profile (source=<profile_name>).
    Strict allowlist only — OAuth tokens, accounts, session DBs, and conversations
    are strictly excluded.
    Returns a dict summarizing what was inherited.
    """
    profiles_dir = get_profiles_dir()
    real_home = get_real_home()

    if source == "host":
        src_root = real_home
        src_home = real_home
        src_gemini = real_home / ".gemini"
        if IS_WINDOWS:
            appdata = os.environ.get("APPDATA")
            src_app_support = (Path(appdata) / "Antigravity") if appdata else (real_home / "AppData" / "Roaming" / "Antigravity")
        else:
            src_app_support = real_home / "Library" / "Application Support" / "Antigravity"
        source_is_profile = False
    else:
        validate_profile_name(source)
        src_profile_dir = profiles_dir / source
        if not src_profile_dir.is_dir() or not (src_profile_dir / "profile.json").is_file():
            raise ValueError(f"Source profile '{source}' does not exist or has no profile.json.")
        src_root = src_profile_dir
        src_home = src_profile_dir / "home"
        src_gemini = src_home / ".gemini"
        src_data = src_profile_dir / "data"
        src_app_support = src_data
        source_is_profile = True

    tgt_home = target_profile_dir / "home"
    tgt_data = target_profile_dir / "data"
    tgt_gemini = tgt_home / ".gemini"
    tgt_gemini_cfg = tgt_gemini / "config"

    tgt_gemini.mkdir(parents=True, exist_ok=True)
    tgt_gemini_cfg.mkdir(parents=True, exist_ok=True)
    tgt_data.mkdir(parents=True, exist_ok=True)

    report = {
        "source": source,
        "files_copied": [],
        "dirs_linked": [],
        "dirs_copied": [],
    }

    def _is_path_safe(p: Path, allowed_root: Path) -> bool:
        try:
            resolved = p.resolve()
            resolved.relative_to(allowed_root.resolve())
            return True
        except (ValueError, OSError):
            if IS_WINDOWS:
                try:
                    p_str = os.path.normcase(os.path.realpath(str(p)))
                    root_str = os.path.normcase(os.path.realpath(str(allowed_root)))
                    return p_str == root_str or p_str.startswith(root_str.rstrip("\\/") + "\\")
                except Exception:
                    pass
            return False

    def _safe_copy(src_file: Path, dst_file: Path) -> bool:
        try:
            if not src_file.is_file() or src_file.is_symlink():
                return False
            # Ensure resolved path is within allowed source root or app support root
            if not _is_path_safe(src_file, src_root) and not _is_path_safe(src_file, src_app_support):
                return False
            dst_file.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src_file, dst_file)
            os.chmod(dst_file, 0o600)
            report["files_copied"].append(dst_file.name)
            return True
        except OSError:
            return False

    def _safe_copy_dir(src_d: Path, dst_d: Path) -> bool:
        try:
            if not src_d.is_dir() or src_d.is_symlink():
                return False
            if not _is_path_safe(src_d, src_root) and not _is_path_safe(src_d, src_app_support):
                return False
            copied_any = False
            for item in src_d.rglob("*"):
                if item.is_file() and not item.is_symlink():
                    d_file = dst_d / item.relative_to(src_d)
                    d_file.parent.mkdir(parents=True, exist_ok=True)
                    os.chmod(d_file.parent, 0o700)
                    shutil.copy2(item, d_file)
                    os.chmod(d_file, 0o600)
                    copied_any = True
            if copied_any:
                report["dirs_copied"].append(dst_d.name)
            return copied_any
        except OSError:
            return False

    def _safe_link_or_copy_dir(src_d: Path, dst_d: Path) -> bool:
        try:
            if not src_d.is_dir():
                return False
            resolved = src_d.resolve()
            # If src_d is within source root
            if _is_path_safe(src_d, src_root):
                if source_is_profile and not src_d.is_symlink():
                    return _safe_copy_dir(src_d, dst_d)
                if dst_d.exists() or dst_d.is_symlink():
                    return False
                dst_d.parent.mkdir(parents=True, exist_ok=True)
                if create_symlink_or_junction(src_d, dst_d):
                    report["dirs_linked"].append(dst_d.name)
                    return True
                return _safe_copy_dir(src_d, dst_d)
            # If src_d is a symlink pointing into real home (e.g. host skills)
            elif _is_path_safe(resolved, real_home):
                if dst_d.exists() or dst_d.is_symlink():
                    return False
                dst_d.parent.mkdir(parents=True, exist_ok=True)
                if create_symlink_or_junction(resolved, dst_d):
                    report["dirs_linked"].append(dst_d.name)
                    return True
                return False
            return False
        except OSError:
            return False

    # 1. Antigravity & VSCode User settings (settings.json, keybindings.json, snippets)
    tgt_user_dir = tgt_data / "User"
    if not source_is_profile:
        if IS_WINDOWS:
            appdata = os.environ.get("APPDATA")
            src_user_dir = (Path(appdata) / "Antigravity" / "User") if appdata else (real_home / "AppData" / "Roaming" / "Antigravity" / "User")
            if not src_user_dir.is_dir() and appdata:
                code_user = Path(appdata) / "Code" / "User"
                if code_user.is_dir():
                    src_user_dir = code_user
        else:
            src_user_dir = src_app_support / "User"
            if not src_user_dir.is_dir():
                code_user = real_home / "Library" / "Application Support" / "Code" / "User"
                if code_user.is_dir():
                    src_user_dir = code_user
    else:
        src_user_dir = src_data / "User"

    if src_user_dir.is_dir():
        _safe_copy(src_user_dir / "settings.json", tgt_user_dir / "settings.json")
        _safe_copy(src_user_dir / "keybindings.json", tgt_user_dir / "keybindings.json")
        _safe_copy_dir(src_user_dir / "snippets", tgt_user_dir / "snippets")

    # Target ~/.gemini/settings.json
    src_gemini_settings = src_gemini / "settings.json"
    if src_gemini_settings.is_file() and not src_gemini_settings.is_symlink():
        try:
            raw = json.loads(src_gemini_settings.read_text(encoding="utf-8"))
            sensitive_keys = {
                "jetski-standalone-oauth-token", "google_accounts", "google_account_id",
                "lastLoginUsername", "oauth_creds", "credentials", "token",
                "refreshToken", "accessToken"
            }
            filtered = {}
            for k, v in raw.items():
                k_lower = k.lower()
                if k in sensitive_keys or "oauth" in k_lower or "token" in k_lower or "secret" in k_lower or "credential" in k_lower:
                    continue
                if k == "mcpServers":
                    if not inherit_mcp:
                        continue
                    v = sanitize_mcp_servers(v)
                filtered[k] = v
            dst_s = tgt_gemini / "settings.json"
            dst_s.write_text(json.dumps(filtered, indent=2, ensure_ascii=False), encoding="utf-8")
            os.chmod(dst_s, 0o600)
            report["files_copied"].append("settings.json")
        except Exception:
            pass

    # 2. AI Assistant Configuration (~/.gemini/config/config.json)
    src_config_json = src_gemini / "config" / "config.json"
    if src_config_json.is_file() and not src_config_json.is_symlink():
        try:
            raw_cfg = json.loads(src_config_json.read_text(encoding="utf-8"))
            user_settings = raw_cfg.get("userSettings", {})
            sanitized_user_settings = {
                k: v for k, v in user_settings.items()
                if k not in ("remoteControlHostname",)
            }
            dst_cfg = tgt_gemini_cfg / "config.json"
            dst_cfg.write_text(json.dumps({"userSettings": sanitized_user_settings}, indent=2, ensure_ascii=False), encoding="utf-8")
            os.chmod(dst_cfg, 0o600)
            report["files_copied"].append("config.json")
        except Exception:
            pass

    # 3. MCP tool configurations (mcp_config.json) — copied with secret env
    # values stripped (see sanitize_mcp_servers above).
    if inherit_mcp:
        src_mcp = src_gemini / "config" / "mcp_config.json"
        if src_mcp.is_file() and not src_mcp.is_symlink():
            try:
                mcp_raw = json.loads(src_mcp.read_text(encoding="utf-8"))
                if isinstance(mcp_raw, dict) and "mcpServers" in mcp_raw:
                    mcp_raw["mcpServers"] = sanitize_mcp_servers(mcp_raw["mcpServers"])
                dst_mcp = tgt_gemini_cfg / "mcp_config.json"
                dst_mcp.write_text(json.dumps(mcp_raw, indent=2, ensure_ascii=False), encoding="utf-8")
                os.chmod(dst_mcp, 0o600)
                report["files_copied"].append("mcp_config.json")
            except Exception:
                _safe_copy(src_mcp, tgt_gemini_cfg / "mcp_config.json")

    # 4. Agent Skills & Plugins
    src_skills = src_gemini / "config" / "skills"
    if src_skills.is_dir():
        _safe_link_or_copy_dir(src_skills, tgt_gemini_cfg / "skills")

    src_plugins = src_gemini / "config" / "plugins"
    if src_plugins.is_dir():
        _safe_link_or_copy_dir(src_plugins, tgt_gemini_cfg / "plugins")

    # 5. Extensions
    if inherit_extensions:
        src_ext = (src_home / ".antigravity" / "extensions") if (src_home / ".antigravity" / "extensions").is_dir() else (src_home / ".vscode" / "extensions")
        if src_ext.is_dir():
            _safe_link_or_copy_dir(src_ext, tgt_home / ".antigravity" / "extensions")

    harden_profile_perms(target_profile_dir, profiles_dir)
    return report

def create_macos_app_shortcut(profile_name: str) -> Path:
    """Create a macOS native .app in ~/Applications so Spotlight and Dock can launch it."""
    if not IS_DARWIN:
        return None
    apps_dir = get_real_home() / "Applications"
    apps_dir.mkdir(exist_ok=True)

    display_name = f"Antigravity ({profile_name})"
    target_app = apps_dir / f"{display_name}.app"
    script_path = get_canonical_cli_path()
    orig_icns = Path("/Applications/Antigravity.app/Contents/Resources/icon.icns")
    if not orig_icns.exists():
        try:
            cand = Path(get_app_binary()).parent.parent / "Resources" / "icon.icns"
            if cand.is_file():
                orig_icns = cand
        except Exception:
            pass

    # Use the interpreter that is running us right now instead of a bare
    # "python3": applets launched from Spotlight only get the launchd PATH
    # (/usr/bin:/bin:/usr/sbin:/sbin), where python3 is the Command Line Tools
    # shim and fails if CLT is not installed.
    py_bin = (sys.executable or "python3").replace("'", "'\\''")
    script_escaped = str(script_path).replace("'", "'\\''")
    osa_cmd = f'''do shell script "'{py_bin}' '{script_escaped}' launch {profile_name} > /dev/null 2>&1 &"'''
    try:
        subprocess.run(["osacompile", "-o", str(target_app), "-e", osa_cmd], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if orig_icns.exists():
            res_dir = target_app / "Contents" / "Resources"
            res_dir.mkdir(exist_ok=True)
            shutil.copy2(orig_icns, res_dir / "applet.icns")
            subprocess.run(["touch", str(target_app)])
        return target_app
    except Exception:
        return None

def remove_macos_app_shortcut(profile_name: str):
    """Remove macOS .app shortcut for profile."""
    if not IS_DARWIN:
        return
    apps_dir = get_real_home() / "Applications"
    if not apps_dir.exists():
        return
    # Exact names only — a glob like "Antigravity (zwe)*.app" would also match
    # unrelated bundles such as "Antigravity (zwe) copy.app".
    for app in (apps_dir / f"Antigravity ({profile_name}).app", apps_dir / f"Antigravity-{profile_name}.app"):
        if app.is_dir() and app.name.endswith(".app"):
            shutil.rmtree(app, ignore_errors=True)

def create_windows_shortcut(profile_name: str) -> Path | None:
    """Create a Windows .lnk shortcut in Start Menu and Desktop so Windows Search can find it."""
    if not IS_WINDOWS:
        return None
    try:
        appdata = os.environ.get("APPDATA")
        start_menu_dirs = []
        if appdata:
            start_menu_dirs.append(Path(appdata) / "Microsoft" / "Windows" / "Start Menu" / "Programs")
        desktop_dir = get_real_home() / "Desktop"

        shortcut_name = f"Antigravity ({profile_name}).lnk"
        script_path = Path(__file__).resolve()
        py_exe = sys.executable
        app_bin = get_app_binary()

        created_path = None
        targets = []
        for sm in start_menu_dirs:
            if sm.is_dir():
                targets.append(sm / shortcut_name)
        if desktop_dir.is_dir():
            targets.append(desktop_dir / shortcut_name)

        if not targets:
            return None

        for target in targets:
            # All interpolated paths go through _ps_single_quote: a user
            # profile path containing an apostrophe (e.g. "O'Brien") would
            # otherwise break the script or inject PowerShell syntax.
            ps_script = (
                f"$ws = New-Object -ComObject WScript.Shell; "
                f"$s = $ws.CreateShortcut({_ps_single_quote(str(target))}); "
                f"$s.TargetPath = {_ps_single_quote(str(py_exe))}; "
                f"$s.Arguments = {_ps_single_quote(chr(34) + str(script_path) + chr(34) + ' launch ' + profile_name)}; "
                f"$s.IconLocation = {_ps_single_quote(str(app_bin) + ',0')}; "
                f"$s.WorkingDirectory = {_ps_single_quote(str(get_profiles_dir() / profile_name))}; "
                f"$s.Save()"
            )
            res = subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_script], capture_output=True)
            if res.returncode == 0 and target.is_file():
                if not created_path:
                    created_path = target

        return created_path
    except Exception:
        return None

def remove_windows_shortcut(profile_name: str):
    """Remove Windows .lnk shortcuts in Start Menu and Desktop."""
    if not IS_WINDOWS:
        return
    try:
        appdata = os.environ.get("APPDATA")
        shortcut_name = f"Antigravity ({profile_name}).lnk"
        candidates = [get_real_home() / "Desktop" / shortcut_name]
        if appdata:
            candidates.append(Path(appdata) / "Microsoft" / "Windows" / "Start Menu" / "Programs" / shortcut_name)
        for c in candidates:
            if c.is_file():
                c.unlink(missing_ok=True)
    except Exception:
        pass

def create_desktop_shortcut(profile_name: str) -> Path | None:
    if IS_DARWIN:
        return create_macos_app_shortcut(profile_name)
    elif IS_WINDOWS:
        return create_windows_shortcut(profile_name)
    return None

def remove_desktop_shortcut(profile_name: str):
    if IS_DARWIN:
        remove_macos_app_shortcut(profile_name)
    elif IS_WINDOWS:
        remove_windows_shortcut(profile_name)

FAKE_SSH_CONN = "127.0.0.1 50000 127.0.0.1 22"
FAKE_SSH_CLIENT = "127.0.0.1 50000 22"

SHARED_GEMINI_CONFIG_DIRS = [
    "projects",
    "skills",
    "plugins",
    "hooks",
    "rules",
    "agents",
    "workflows",
    "global_workflows",
    "sidecars",
]

SYNC_AGENT_LABEL = "com.paragravity.sync"


def _write_bytes_atomic(dst: Path, content: bytes, mode: int = 0o600):
    """Write bytes atomically via temp file + os.replace (never follows symlinks)."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    if not IS_WINDOWS:
        try:
            os.chmod(dst.parent, 0o700)
        except OSError:
            pass
    tmp = dst.with_name(f".{dst.name}.tmp.{os.getpid()}")
    tmp.write_bytes(content)
    if not IS_WINDOWS:
        try:
            os.chmod(tmp, mode)
        except OSError:
            pass
    os.replace(tmp, dst)


def _write_text_atomic(dst: Path, text: str, mode: int = 0o600):
    _write_bytes_atomic(dst, text.encode("utf-8"), mode=mode)


def _sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _sha256_json(obj) -> str:
    canonical = json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(canonical).hexdigest()


def sync_profile_auth_tokens(profile_dir: Path) -> bool:
    """Bridge per-profile Desktop and agy CLI OAuth tokens (same profile only)."""
    gemini_dir = profile_dir / "home" / ".gemini"
    gui_tok = gemini_dir / "jetski-standalone-oauth-token"
    cli_tok = gemini_dir / "antigravity-cli" / "antigravity-oauth-token"

    gui_info = _parse_oauth_token_file(gui_tok)
    cli_info = _parse_oauth_token_file(cli_tok)

    gui_valid = bool(gui_info.get("has_token"))
    cli_valid = bool(cli_info.get("has_token"))

    if not gui_valid and not cli_valid:
        return False

    if gui_valid and cli_valid:
        try:
            gui_bytes = gui_tok.read_bytes()
            cli_bytes = cli_tok.read_bytes()
            if gui_bytes == cli_bytes:
                return False
        except OSError:
            return False
        if cli_info["mtime_ns"] > gui_info["mtime_ns"]:
            src, dst = cli_tok, gui_tok
            src_bytes = cli_bytes
        else:
            src, dst = gui_tok, cli_tok
            src_bytes = gui_bytes
    elif gui_valid:
        src, dst = gui_tok, cli_tok
        try:
            src_bytes = src.read_bytes()
        except OSError:
            return False
    else:
        src, dst = cli_tok, gui_tok
        try:
            src_bytes = src.read_bytes()
        except OSError:
            return False

    try:
        src_st = src.stat()
        _write_bytes_atomic(dst, src_bytes, mode=0o600)
        os.utime(dst, ns=(src_st.st_atime_ns, src_st.st_mtime_ns))
        return True
    except OSError:
        return False


def _canonical_dir_has_swarm_board(projects_dir: Path) -> bool:
    if not projects_dir.is_dir():
        return False
    for p in projects_dir.glob("*.json"):
        try:
            obj = json.loads(p.read_text(encoding="utf-8"))
            if isinstance(obj, dict) and obj.get("name") == "swarm/swarm_board":
                return True
        except Exception:
            pass
    return False


def _find_canonical_swarm_project_id(real_home: Path) -> Optional[str]:
    proj_dir = real_home / ".gemini" / "config" / "projects"
    if not proj_dir.is_dir():
        return None
    for p in sorted(proj_dir.glob("*.json")):
        try:
            obj = json.loads(p.read_text(encoding="utf-8"))
            if isinstance(obj, dict) and obj.get("name") == "swarm/swarm_board" and obj.get("id"):
                return str(obj["id"])
        except Exception:
            pass
    return None


def _merge_entry_into_dir(src_entry: Path, dst_entry: Path):
    """Losslessly merge a file, symlink, or subdirectory from src_entry into dst_entry."""
    if src_entry.is_symlink():
        if not os.path.lexists(str(dst_entry)):
            dst_entry.parent.mkdir(parents=True, exist_ok=True)
            dst_entry.symlink_to(os.readlink(src_entry))
        return
    if src_entry.is_dir():
        if not os.path.lexists(str(dst_entry)):
            shutil.copytree(src_entry, dst_entry, symlinks=True)
        elif dst_entry.is_dir() and not dst_entry.is_symlink():
            for child in src_entry.iterdir():
                _merge_entry_into_dir(child, dst_entry / child.name)
        return
    if src_entry.is_file():
        if not os.path.lexists(str(dst_entry)):
            dst_entry.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src_entry, dst_entry)
        elif dst_entry.is_file() and not dst_entry.is_symlink():
            try:
                if src_entry.stat().st_mtime_ns > dst_entry.stat().st_mtime_ns:
                    shutil.copy2(src_entry, dst_entry)
            except OSError:
                pass


def _is_dir_link_or_junction(p: Path) -> bool:
    if p.is_symlink():
        return True
    if IS_WINDOWS:
        if hasattr(os.path, "isjunction") and os.path.isjunction(p):
            return True
        try:
            import stat as _stat
            return bool(os.lstat(p).st_file_attributes & _stat.FILE_ATTRIBUTE_REPARSE_POINT)
        except OSError:
            return False
    return False


def _remove_dir_link_or_junction(p: Path):
    if IS_WINDOWS:
        try:
            os.rmdir(p)
            return
        except OSError:
            pass
    p.unlink(missing_ok=True)


def _merge_and_link_dir(canonical_dir: Path, prof_dir: Path, deduplicate_swarm_projects: bool = False) -> bool:
    """Ensure prof_dir is a symlink/junction to canonical_dir after merging any local contents."""
    canonical_dir.mkdir(parents=True, exist_ok=True)

    if _is_dir_link_or_junction(prof_dir):
        try:
            if prof_dir.resolve() == canonical_dir.resolve():
                return False
        except OSError:
            pass
        _remove_dir_link_or_junction(prof_dir)
    elif prof_dir.is_dir():
        has_swarm = _canonical_dir_has_swarm_board(canonical_dir) if deduplicate_swarm_projects else False
        for entry in list(prof_dir.iterdir()):
            if deduplicate_swarm_projects and entry.is_file() and entry.suffix == ".json":
                try:
                    obj = json.loads(entry.read_text(encoding="utf-8"))
                    if isinstance(obj, dict) and obj.get("name") == "swarm/swarm_board":
                        if has_swarm:
                            continue
                        has_swarm = True
                except Exception:
                    pass
            _merge_entry_into_dir(entry, canonical_dir / entry.name)
        shutil.rmtree(prof_dir)
    elif prof_dir.exists():
        prof_dir.unlink(missing_ok=True)

    return create_symlink_or_junction(canonical_dir, prof_dir)


def setup_shared_config_links(profile_dir: Path, real_home: Optional[Path] = None) -> list[str]:
    """Tier 1: symlink multi-file customization directories to host's canonical ~/.gemini/config."""
    if real_home is None:
        real_home = get_real_home()
    host_gemini = real_home / ".gemini"
    host_cfg = host_gemini / "config"
    prof_gemini = profile_dir / "home" / ".gemini"
    prof_cfg = prof_gemini / "config"
    host_cfg.mkdir(parents=True, exist_ok=True)
    prof_cfg.mkdir(parents=True, exist_ok=True)

    linked = []
    for sub in SHARED_GEMINI_CONFIG_DIRS:
        canon = host_cfg / sub
        target = prof_cfg / sub
        if _merge_and_link_dir(canon, target, deduplicate_swarm_projects=(sub == "projects")):
            linked.append(f"config/{sub}")

    # Custom slash commands (~/.gemini/commands)
    if (host_gemini / "commands").is_dir() or (prof_gemini / "commands").is_dir():
        if _merge_and_link_dir(host_gemini / "commands", prof_gemini / "commands"):
            linked.append("commands")

    return linked


def _load_sync_state(profiles_dir: Path) -> dict:
    state_file = profiles_dir / ".sync_state.json"
    if state_file.is_file():
        try:
            data = json.loads(state_file.read_text(encoding="utf-8"))
            if isinstance(data, dict) and isinstance(data.get("files"), dict):
                return data
        except Exception:
            pass
    return {"version": 1, "files": {}}


def _save_sync_state(profiles_dir: Path, state: dict):
    state_file = profiles_dir / ".sync_state.json"
    _write_text_atomic(state_file, json.dumps(state, indent=2, ensure_ascii=False) + "\n", mode=0o600)


def _extract_shared_config_json(raw: dict, swarm_proj_id: Optional[str]) -> dict:
    plugins = raw.get("plugins") if isinstance(raw.get("plugins"), dict) else {}
    sidecars = raw.get("sidecars") if isinstance(raw.get("sidecars"), dict) else {}
    sidecars_clean = json.loads(json.dumps(sidecars))
    if swarm_proj_id and isinstance(sidecars_clean.get("swarm/swarm_board"), dict):
        sidecars_clean["swarm/swarm_board"]["projectId"] = swarm_proj_id
    us = raw.get("userSettings") if isinstance(raw.get("userSettings"), dict) else {}
    us_clean = {k: v for k, v in us.items() if k not in ("remoteControlHostname", "remoteControlEnabled")}
    return {
        "plugins": plugins,
        "sidecars": sidecars_clean,
        "userSettings": us_clean,
    }


def _build_participant_config_json(shared: dict, existing_raw: dict) -> dict:
    out = {}
    if shared.get("plugins"):
        out["plugins"] = shared["plugins"]
    if shared.get("sidecars"):
        out["sidecars"] = shared["sidecars"]
    us = dict(shared.get("userSettings") or {})
    existing_us = existing_raw.get("userSettings") if isinstance(existing_raw.get("userSettings"), dict) else {}
    for local_key in ("remoteControlHostname", "remoteControlEnabled"):
        if local_key in existing_us:
            us[local_key] = existing_us[local_key]
        else:
            us.pop(local_key, None)
    out["userSettings"] = us
    return out


def _sync_field_aware_json(
    key: str,
    participants: list[tuple[str, Path]],
    extract_fn,
    build_fn,
    bootstrap_merge_fn,
    state_files: dict,
    skip_if_empty_all: bool = False,
) -> tuple[bool, bool]:
    """Bidirectional field-aware JSON sync across participants. Returns (changed_files, state_dirty)."""
    prev_entry = state_files.get(key) if isinstance(state_files.get(key), dict) else {}
    prev_canon_hash = prev_entry.get("canonical_hash")
    prev_parts = prev_entry.get("participants") if isinstance(prev_entry.get("participants"), dict) else {}

    records = []
    for pid, path in participants:
        rec = {
            "id": pid,
            "path": path,
            "exists": path.is_file() and not path.is_symlink(),
            "mtime_ns": 0,
            "raw": {},
            "raw_hash": None,
            "shared": None,
            "shared_hash": None,
            "valid": False,
        }
        if path.is_symlink():
            # Never follow a leftover symlink on single JSON files; treat as needing rewrite if real file exists elsewhere
            rec["exists"] = False
        if rec["exists"]:
            try:
                rec["mtime_ns"] = path.stat().st_mtime_ns
                raw_bytes = path.read_bytes()
                rec["raw_hash"] = _sha256_bytes(raw_bytes)
                txt = raw_bytes.decode("utf-8").strip()
                if not txt:
                    rec["raw"] = {}
                    rec["shared"] = extract_fn({})
                    rec["shared_hash"] = _sha256_json(rec["shared"])
                    rec["valid"] = True
                else:
                    raw = json.loads(txt)
                    if isinstance(raw, dict):
                        rec["raw"] = raw
                        rec["shared"] = extract_fn(raw)
                        rec["shared_hash"] = _sha256_json(rec["shared"])
                        rec["valid"] = True
            except Exception:
                pass
        records.append(rec)

    valid_recs = [r for r in records if r["valid"]]
    if not valid_recs:
        return False, False

    if skip_if_empty_all and all(not r["shared"] or all(not v for v in r["shared"].values()) for r in valid_recs):
        return False, False

    canonical_shared = None
    if not prev_canon_hash:
        canonical_shared = bootstrap_merge_fn(valid_recs)
    else:
        edited = []
        for r in valid_recs:
            pinfo = prev_parts.get(r["id"])
            if not isinstance(pinfo, dict):
                continue
            prev_disk = pinfo.get("disk_hash")
            disk_changed = (prev_disk is None) or (r["raw_hash"] != prev_disk)
            if pinfo.get("hash") == prev_canon_hash and disk_changed and r["shared_hash"] != prev_canon_hash:
                edited.append(r)
        if edited:
            winner = max(edited, key=lambda r: r["mtime_ns"])
            canonical_shared = winner["shared"]
        else:
            matching = [r for r in valid_recs if r["shared_hash"] == prev_canon_hash]
            if matching:
                canonical_shared = matching[0]["shared"]
            else:
                # Fallback if all tracked copies drifted simultaneously
                host_recs = [r for r in valid_recs if r["id"] == "host"]
                winner = host_recs[0] if host_recs else max(valid_recs, key=lambda r: r["mtime_ns"])
                canonical_shared = winner["shared"]

    canon_hash = _sha256_json(canonical_shared)
    changed_files = False
    new_parts = {}

    for r in records:
        pid = r["id"]
        path = r["path"]
        target_obj = build_fn(pid, canonical_shared, r["raw"])
        if skip_if_empty_all and not target_obj:
            continue
        target_bytes = (json.dumps(target_obj, indent=2, ensure_ascii=False) + "\n").encode("utf-8")

        need_write = False
        if not r["exists"]:
            need_write = True
        else:
            try:
                cur_bytes = path.read_bytes()
                if cur_bytes != target_bytes:
                    need_write = True
            except OSError:
                need_write = True

        if need_write:
            try:
                _write_bytes_atomic(path, target_bytes, mode=0o600)
                changed_files = True
            except OSError:
                pass

        try:
            st_ns = path.stat().st_mtime_ns if path.is_file() else 0
            disk_hash = _sha256_bytes(path.read_bytes()) if path.is_file() else None
        except OSError:
            st_ns = 0
            disk_hash = None
        new_parts[pid] = {"mtime_ns": st_ns, "hash": canon_hash, "disk_hash": disk_hash}

    new_entry = {"canonical_hash": canon_hash, "participants": new_parts}
    state_dirty = (prev_entry != new_entry)
    state_files[key] = new_entry
    return changed_files, state_dirty


def _sync_raw_file(
    key: str,
    participants: list[tuple[str, Path]],
    state_files: dict,
    require_valid_json: bool = False,
) -> tuple[bool, bool]:
    """Bidirectional raw-bytes sync for shared config/markdown/settings files."""
    prev_entry = state_files.get(key) if isinstance(state_files.get(key), dict) else {}
    prev_canon_hash = prev_entry.get("canonical_hash")
    prev_parts = prev_entry.get("participants") if isinstance(prev_entry.get("participants"), dict) else {}

    records = []
    for pid, path in participants:
        rec = {
            "id": pid,
            "path": path,
            "exists": path.is_file() and not path.is_symlink(),
            "mtime_ns": 0,
            "bytes": None,
            "hash": None,
            "valid": False,
        }
        if rec["exists"]:
            try:
                rec["mtime_ns"] = path.stat().st_mtime_ns
                raw_bytes = path.read_bytes()
                if raw_bytes.strip():
                    if require_valid_json:
                        json.loads(raw_bytes.decode("utf-8"))
                    rec["bytes"] = raw_bytes
                    rec["hash"] = _sha256_bytes(raw_bytes)
                    rec["valid"] = True
            except Exception:
                pass
        records.append(rec)

    valid_recs = [r for r in records if r["valid"]]
    if not valid_recs:
        return False, False

    if not prev_canon_hash:
        host_recs = [r for r in valid_recs if r["id"] == "host"]
        winner = host_recs[0] if host_recs else max(valid_recs, key=lambda r: r["mtime_ns"])
    else:
        edited = [
            r for r in valid_recs
            if r["id"] in prev_parts
            and prev_parts[r["id"]].get("hash") == prev_canon_hash
            and r["hash"] != prev_canon_hash
        ]
        if edited:
            winner = max(edited, key=lambda r: r["mtime_ns"])
        else:
            matching = [r for r in valid_recs if r["hash"] == prev_canon_hash]
            if matching:
                winner = matching[0]
            else:
                host_recs = [r for r in valid_recs if r["id"] == "host"]
                winner = host_recs[0] if host_recs else max(valid_recs, key=lambda r: r["mtime_ns"])

    canon_bytes = winner["bytes"]
    canon_hash = winner["hash"]
    changed_files = False
    new_parts = {}

    for r in records:
        pid = r["id"]
        path = r["path"]
        if not r["exists"] or r["bytes"] != canon_bytes:
            try:
                _write_bytes_atomic(path, canon_bytes, mode=0o600)
                changed_files = True
            except OSError:
                pass
        try:
            st_ns = path.stat().st_mtime_ns if path.is_file() else 0
        except OSError:
            st_ns = 0
        new_parts[pid] = {"mtime_ns": st_ns, "hash": canon_hash}

    new_entry = {"canonical_hash": canon_hash, "participants": new_parts}
    state_dirty = (prev_entry != new_entry)
    state_files[key] = new_entry
    return changed_files, state_dirty


def reconcile_shared_files(profiles: list[Path], profiles_dir: Path, real_home: Optional[Path] = None) -> dict:
    """Tier 2: bidirectional field-aware sync for single JSON/markdown config files."""
    if real_home is None:
        real_home = get_real_home()
    state = _load_sync_state(profiles_dir)
    state_files = state.setdefault("files", {})
    state_dirty = False
    synced_keys = []

    host_gemini = real_home / ".gemini"
    host_app_user = get_host_app_support_dir() / "User"
    swarm_proj_id = _find_canonical_swarm_project_id(real_home)

    profile_meta_map = {}
    for pdir in profiles:
        pmeta = {}
        mf = pdir / "profile.json"
        if mf.is_file():
            try:
                pmeta = json.loads(mf.read_text(encoding="utf-8"))
            except Exception:
                pass
        profile_meta_map[pdir.name] = pmeta

    def _participants(rel_home_subpath: Optional[Path], use_app_user: Optional[str] = None, exclude_no_mcp: bool = False) -> list[tuple[str, Path]]:
        items = []
        if use_app_user:
            items.append(("host", host_app_user / use_app_user))
            for pdir in profiles:
                items.append((pdir.name, pdir / "data" / "User" / use_app_user))
        else:
            items.append(("host", host_gemini / rel_home_subpath))
            for pdir in profiles:
                if exclude_no_mcp and profile_meta_map.get(pdir.name, {}).get("no_mcp"):
                    continue
                items.append((pdir.name, pdir / "home" / ".gemini" / rel_home_subpath))
        return items

    # 1. config/config.json (plugins, sidecars, shared userSettings; keeps remoteControlHostname/Enabled local)
    def _bootstrap_config_json(valid_recs: list[dict]) -> dict:
        host_r = next((r for r in valid_recs if r["id"] == "host"), None)
        base = json.loads(json.dumps(host_r["shared"] if host_r else valid_recs[0]["shared"]))
        merged_plugins = dict(base.get("plugins") or {})
        merged_sidecars = dict(base.get("sidecars") or {})
        merged_us = dict(base.get("userSettings") or {})

        for r in valid_recs:
            sh = r["shared"] or {}
            for k, v in (sh.get("plugins") or {}).items():
                if k not in merged_plugins:
                    merged_plugins[k] = v
                elif isinstance(v, dict) and isinstance(merged_plugins[k], dict):
                    if "installedFrom" in v and "installedFrom" not in merged_plugins[k]:
                        merged_plugins[k] = v
            for k, v in (sh.get("sidecars") or {}).items():
                if k not in merged_sidecars:
                    merged_sidecars[k] = v
            for k, v in (sh.get("userSettings") or {}).items():
                if k not in merged_us:
                    merged_us[k] = v

        if swarm_proj_id and isinstance(merged_sidecars.get("swarm/swarm_board"), dict):
            merged_sidecars["swarm/swarm_board"]["projectId"] = swarm_proj_id

        return {
            "plugins": merged_plugins,
            "sidecars": merged_sidecars,
            "userSettings": merged_us,
        }

    ch, sd = _sync_field_aware_json(
        "gemini_config_json",
        _participants(Path("config") / "config.json"),
        lambda raw: _extract_shared_config_json(raw, swarm_proj_id),
        lambda _pid, shared, existing: _build_participant_config_json(shared, existing),
        _bootstrap_config_json,
        state_files,
    )
    if ch:
        synced_keys.append("config/config.json")
    state_dirty = state_dirty or sd

    # 2. config/mcp_config.json (union-merge on bootstrap if non-empty, respects --no-mcp and sanitize_mcp)
    def _extract_mcp(raw: dict) -> dict:
        srvs = raw.get("mcpServers")
        if isinstance(srvs, dict) and srvs:
            return {"mcpServers": srvs}
        if raw:
            return raw
        return {}

    def _build_mcp(pid: str, shared: dict, _existing: dict) -> dict:
        if pid != "host" and profile_meta_map.get(pid, {}).get("sanitize_mcp"):
            out = dict(shared)
            if isinstance(out.get("mcpServers"), dict):
                out["mcpServers"] = sanitize_mcp_servers(out["mcpServers"])
            return out
        return shared

    def _bootstrap_mcp(valid_recs: list[dict]) -> dict:
        merged = {}
        extra = {}
        for r in valid_recs:
            sh = r["shared"] or {}
            if isinstance(sh.get("mcpServers"), dict):
                for k, v in sh["mcpServers"].items():
                    if k not in merged:
                        merged[k] = v
            for k, v in sh.items():
                if k != "mcpServers" and k not in extra:
                    extra[k] = v
        out = dict(extra)
        if merged:
            out["mcpServers"] = merged
        return out

    ch, sd = _sync_field_aware_json(
        "mcp_config_json",
        _participants(Path("config") / "mcp_config.json", exclude_no_mcp=True),
        _extract_mcp,
        _build_mcp,
        _bootstrap_mcp,
        state_files,
        skip_if_empty_all=True,
    )
    if ch:
        synced_keys.append("config/mcp_config.json")
    state_dirty = state_dirty or sd

    # 3. Raw files: hooks.json, GEMINI.md, AGENTS.md, workflows.json, antigravity-cli/settings.json
    raw_specs = [
        ("hooks_json", Path("config") / "hooks.json", True),
        ("workflows_json", Path("config") / "workflows.json", True),
        ("cli_settings_json", Path("antigravity-cli") / "settings.json", True),
        ("gemini_md", Path("GEMINI.md"), False),
        ("agents_md", Path("AGENTS.md"), False),
    ]
    for rkey, rel_path, is_json in raw_specs:
        ch, sd = _sync_raw_file(rkey, _participants(rel_path), state_files, require_valid_json=is_json)
        if ch:
            synced_keys.append(str(rel_path))
        state_dirty = state_dirty or sd

    # 4. Editor User/settings.json (exclude update.mode so sandboxes stay update.mode=none)
    def _extract_editor_settings(raw: dict) -> dict:
        return {k: v for k, v in raw.items() if k != "update.mode"}

    def _build_editor_settings(pid: str, shared: dict, existing: dict) -> dict:
        out = dict(shared)
        if pid != "host":
            out["update.mode"] = "none"
        elif "update.mode" in existing:
            out["update.mode"] = existing["update.mode"]
        return out

    def _bootstrap_editor_settings(valid_recs: list[dict]) -> dict:
        merged = {}
        host_r = next((r for r in valid_recs if r["id"] == "host"), None)
        if host_r:
            merged.update(host_r["shared"] or {})
        for r in valid_recs:
            for k, v in (r["shared"] or {}).items():
                if k not in merged:
                    merged[k] = v
        return merged

    ch, sd = _sync_field_aware_json(
        "editor_user_settings",
        _participants(None, use_app_user="settings.json"),
        _extract_editor_settings,
        _build_editor_settings,
        _bootstrap_editor_settings,
        state_files,
        skip_if_empty_all=True,
    )
    if ch:
        synced_keys.append("User/settings.json")
    state_dirty = state_dirty or sd

    # 5. Editor User/keybindings.json
    ch, sd = _sync_raw_file(
        "editor_keybindings",
        _participants(None, use_app_user="keybindings.json"),
        state_files,
        require_valid_json=True,
    )
    if ch:
        synced_keys.append("User/keybindings.json")
    state_dirty = state_dirty or sd

    if state_dirty:
        _save_sync_state(profiles_dir, state)

    return {"synced_files": synced_keys, "state_dirty": state_dirty}


def is_profile_sync_enabled(profile_dir: Path) -> bool:
    meta_file = profile_dir / "profile.json"
    if not meta_file.is_file():
        return False
    try:
        meta = json.loads(meta_file.read_text(encoding="utf-8"))
        return meta.get("sync_enabled", True) is not False
    except Exception:
        return True


def sync_profile(profile_dir: Path, real_home: Optional[Path] = None) -> dict:
    """Sync symlinks and per-profile Desktop<->CLI OAuth tokens for one profile."""
    if real_home is None:
        real_home = get_real_home()
    meta = {}
    meta_file = profile_dir / "profile.json"
    if meta_file.is_file():
        try:
            meta = json.loads(meta_file.read_text(encoding="utf-8"))
        except Exception:
            pass
    policy = meta.get("symlink_policy", "full")
    setup_home_symlinks(real_home, profile_dir / "home", policy)
    linked = []
    if meta.get("sync_enabled", True) is not False:
        linked = setup_shared_config_links(profile_dir, real_home=real_home)
    token_synced = sync_profile_auth_tokens(profile_dir)
    return {"dirs_linked": linked, "token_synced": token_synced}


def sync_all_profiles(profiles_dir: Optional[Path] = None) -> dict:
    """Run full Tier 1 + Tier 2 real-time sync across host and all sync-enabled profiles."""
    if profiles_dir is None:
        profiles_dir = get_profiles_dir()
    profiles_dir.mkdir(parents=True, exist_ok=True)
    real_home = get_real_home()

    lock_f = None
    if fcntl is not None:
        try:
            lock_path = profiles_dir / ".sync.lock"
            lock_f = open(lock_path, "a+")
            fcntl.flock(lock_f.fileno(), fcntl.LOCK_EX)
        except OSError:
            if lock_f:
                lock_f.close()
                lock_f = None

    try:
        all_profiles = sorted(
            [p for p in profiles_dir.iterdir() if p.is_dir() and not p.name.startswith(".") and (p / "profile.json").is_file()]
        )
        synced_profiles = []
        dirs_linked = {}
        tokens_synced = []

        for pdir in all_profiles:
            if is_profile_sync_enabled(pdir):
                synced_profiles.append(pdir)
            res = sync_profile(pdir, real_home=real_home)
            if res["dirs_linked"]:
                dirs_linked[pdir.name] = res["dirs_linked"]
            if res["token_synced"]:
                tokens_synced.append(pdir.name)

        file_res = reconcile_shared_files(synced_profiles, profiles_dir, real_home=real_home)
        if not IS_WINDOWS:
            try:
                os.chmod(profiles_dir, 0o700)
            except OSError:
                pass
        return {
            "profiles": [p.name for p in synced_profiles],
            "dirs_linked": dirs_linked,
            "tokens_synced": tokens_synced,
            "synced_files": file_res.get("synced_files", []),
        }
    finally:
        if lock_f is not None:
            try:
                fcntl.flock(lock_f.fileno(), fcntl.LOCK_UN)
                lock_f.close()
            except OSError:
                pass


def get_sync_plist_path() -> Path:
    return get_real_home() / "Library" / "LaunchAgents" / f"{SYNC_AGENT_LABEL}.plist"


def get_sync_daemon_pid(profiles_dir: Optional[Path] = None) -> int:
    if profiles_dir is None:
        profiles_dir = get_profiles_dir()
    pid_file = profiles_dir / ".sync.pid"
    if pid_file.is_file():
        try:
            pid = int(pid_file.read_text(encoding="utf-8").strip())
            if is_pid_running(pid):
                if IS_WINDOWS:
                    return pid
                try:
                    out = subprocess.check_output(["ps", "-o", "command=", "-p", str(pid)], stderr=subprocess.DEVNULL)
                    if "sync" in out.decode("utf-8", "replace") and "_daemon" in out.decode("utf-8", "replace"):
                        return pid
                except Exception:
                    pass
        except Exception:
            pass
    if not IS_WINDOWS and not is_ephemeral_test_home():
        try:
            out = subprocess.check_output(["pgrep", "-f", "--", "paragravity sync _daemon"], stderr=subprocess.DEVNULL)
            pids = [int(p) for p in out.decode().split() if p.strip().isdigit()]
            if pids:
                return pids[0]
        except Exception:
            pass
    return 0


def ensure_sync_daemon(profiles_dir: Optional[Path] = None) -> dict:
    """Install and start the lightweight background sync LaunchAgent (or background daemon)."""
    if profiles_dir is None:
        profiles_dir = get_profiles_dir()
    profiles_dir.mkdir(parents=True, exist_ok=True)
    real_home = get_real_home()
    if is_ephemeral_test_home(real_home):
        return {"method": "disabled-in-test", "running": False, "pid": None, "plist": None}
    cli_path = get_canonical_cli_path()
    py_bin = sys.executable or shutil.which("python3") or "/usr/bin/python3"

    existing_pid = get_sync_daemon_pid(profiles_dir)

    if IS_DARWIN:
        import plistlib
        plist_path = get_sync_plist_path()
        plist_path.parent.mkdir(parents=True, exist_ok=True)
        log_path = profiles_dir / "sync-daemon.log"
        plist_data = {
            "Label": SYNC_AGENT_LABEL,
            "ProgramArguments": [py_bin, str(cli_path), "sync", "_daemon"],
            "RunAtLoad": True,
            "KeepAlive": True,
            "ProcessType": "Background",
            "StandardOutPath": str(log_path),
            "StandardErrorPath": str(log_path),
            "EnvironmentVariables": {
                "HOME": str(real_home),
                "PATH": f"{real_home / '.local' / 'bin'}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
            },
        }
        plist_bytes = plistlib.dumps(plist_data)
        plist_changed = (not plist_path.is_file()) or (plist_path.read_bytes() != plist_bytes)
        if plist_changed:
            _write_bytes_atomic(plist_path, plist_bytes, mode=0o644)

        if not existing_pid or plist_changed:
            subprocess.run(["launchctl", "unload", str(plist_path)], capture_output=True)
            res = subprocess.run(["launchctl", "load", "-w", str(plist_path)], capture_output=True, text=True)
            if res.returncode == 0:
                for _ in range(15):
                    pid = get_sync_daemon_pid(profiles_dir)
                    if pid:
                        return {"method": "launchd", "running": True, "pid": pid, "plist": str(plist_path)}
                    time.sleep(0.1)

    if not existing_pid:
        log_path = profiles_dir / "sync-daemon.log"
        with open(log_path, "ab") as log_f:
            popen_kwargs = {
                "stdout": log_f,
                "stderr": subprocess.STDOUT,
                "env": {**os.environ, "HOME": str(real_home)},
            }
            if IS_WINDOWS:
                popen_kwargs["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.DETACHED_PROCESS
            else:
                popen_kwargs["start_new_session"] = True
            proc = subprocess.Popen([py_bin, str(cli_path), "sync", "_daemon"], **popen_kwargs)
        return {"method": "daemon", "running": True, "pid": proc.pid, "plist": str(get_sync_plist_path()) if IS_DARWIN else None}

    return {"method": "launchd" if IS_DARWIN else "daemon", "running": True, "pid": existing_pid, "plist": str(get_sync_plist_path()) if IS_DARWIN else None}


def stop_sync_daemon(profiles_dir: Optional[Path] = None) -> bool:
    if profiles_dir is None:
        profiles_dir = get_profiles_dir()
    if IS_DARWIN:
        plist_path = get_sync_plist_path()
        if plist_path.is_file():
            subprocess.run(["launchctl", "unload", "-w", str(plist_path)], capture_output=True)
    pid = get_sync_daemon_pid(profiles_dir)
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            for _ in range(20):
                if not is_pid_running(pid):
                    break
                time.sleep(0.1)
        except OSError:
            pass
    (profiles_dir / ".sync.pid").unlink(missing_ok=True)
    return True


def get_sync_status_data(profiles_dir: Optional[Path] = None) -> dict:
    if profiles_dir is None:
        profiles_dir = get_profiles_dir()
    real_home = get_real_home()
    host_cfg = real_home / ".gemini" / "config"
    projects_count = len([p for p in (host_cfg / "projects").glob("*.json")]) if (host_cfg / "projects").is_dir() else 0
    skills_count = len([p for p in (host_cfg / "skills").iterdir() if not p.name.startswith(".")]) if (host_cfg / "skills").is_dir() else 0
    plugins_count = len([p for p in (host_cfg / "plugins").iterdir() if p.is_dir() and not p.name.startswith(".")]) if (host_cfg / "plugins").is_dir() else 0

    daemon_pid = get_sync_daemon_pid(profiles_dir)
    launchd_loaded = False
    if IS_DARWIN and not is_ephemeral_test_home(real_home):
        res = subprocess.run(["launchctl", "list", SYNC_AGENT_LABEL], capture_output=True)
        launchd_loaded = (res.returncode == 0)

    profiles_status = []
    if profiles_dir.is_dir():
        for pdir in sorted(profiles_dir.iterdir()):
            if pdir.is_dir() and not pdir.name.startswith(".") and (pdir / "profile.json").is_file():
                cfg = pdir / "home" / ".gemini" / "config"
                linked_ok = all(
                    _is_dir_link_or_junction(cfg / sub)
                    for sub in ("projects", "skills", "plugins")
                )
                profiles_status.append({
                    "name": pdir.name,
                    "sync_enabled": is_profile_sync_enabled(pdir),
                    "dirs_linked": linked_ok,
                    "cli_token_synced": (pdir / "home" / ".gemini" / "antigravity-cli" / "antigravity-oauth-token").is_file(),
                })

    return {
        "daemon_running": bool(daemon_pid),
        "daemon_pid": daemon_pid or None,
        "launchd_loaded": launchd_loaded,
        "plist_path": str(get_sync_plist_path()) if IS_DARWIN else None,
        "shared_counts": {
            "projects": projects_count,
            "skills": skills_count,
            "plugins": plugins_count,
        },
        "profiles": profiles_status,
    }


def get_shims_dir() -> Path:
    return get_profiles_dir() / "shims"


def get_active_profile_file() -> Path:
    return get_profiles_dir() / ".active_profile"


def normalize_profile_target(name: str) -> str:
    clean = name.strip()
    if clean.lower() in ("host", "default", "real", "system", "local"):
        return "host"
    validate_profile_name(clean)
    return clean


def get_active_profile_with_source() -> tuple[str, str]:
    profiles_dir = get_profiles_dir()
    env_prof = os.environ.get("PGRAV_PROFILE", "").strip()
    if env_prof:
        if env_prof.lower() in ("host", "default", "real", "system", "local"):
            return "host", "env:PGRAV_PROFILE"
        if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", env_prof) and (profiles_dir / env_prof / "profile.json").is_file():
            return env_prof, "env:PGRAV_PROFILE"

    active_file = get_active_profile_file()
    if active_file.is_file():
        try:
            raw = active_file.read_text(encoding="utf-8").strip()
            if raw.lower() in ("host", "default", "real", "system", "local"):
                return "host", "file"
            if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", raw) and (profiles_dir / raw / "profile.json").is_file():
                return raw, "file"
        except OSError:
            pass

    env_home = Path(os.environ.get("HOME", ""))
    parts = env_home.parts
    if len(parts) >= 3 and parts[-1] == "home" and parts[-3] == ".antigravity-profiles":
        cand = parts[-2]
        if (profiles_dir / cand / "profile.json").is_file():
            return cand, "env:HOME"

    return "host", "default"


def get_active_profile() -> str:
    target, _ = get_active_profile_with_source()
    return target


def set_active_profile(name: str) -> str:
    target = normalize_profile_target(name)
    profiles_dir = get_profiles_dir()
    profiles_dir.mkdir(parents=True, exist_ok=True)
    if target != "host":
        pdir = profiles_dir / target
        if not (pdir / "profile.json").is_file():
            raise ValueError(f"Profile '{target}' does not exist.")
    _write_text_atomic(get_active_profile_file(), target + "\n", mode=0o644)
    return target


def _wrap_windows_cmd(bin_path: str, args_list: list[str]) -> list[str]:
    cmd = [bin_path, *args_list]
    if IS_WINDOWS and str(bin_path).lower().endswith((".cmd", ".bat")):
        return ["cmd.exe", "/c", *cmd]
    return cmd


def get_real_agy_binary() -> Optional[str]:
    env_bin = os.environ.get("ANTIGRAVITY_CLI_BIN")
    shims_dir = get_shims_dir().resolve() if get_shims_dir().exists() else get_shims_dir()
    real_home = get_real_home()
    candidates = []
    if env_bin:
        candidates.append(Path(env_bin).expanduser())
    if IS_WINDOWS:
        candidates.extend([
            real_home / ".local" / "bin" / "agy.cmd",
            real_home / ".local" / "bin" / "agy.exe",
            real_home / ".gemini" / "bin" / "agy.cmd",
            real_home / ".gemini" / "bin" / "agy.exe",
        ])
        for entry in os.environ.get("PATH", "").split(os.pathsep):
            if entry:
                candidates.append(Path(entry) / "agy.cmd")
                candidates.append(Path(entry) / "agy.exe")
    else:
        candidates.extend([
            real_home / ".local" / "bin" / "agy",
            real_home / ".gemini" / "bin" / "agy",
        ])
        for entry in os.environ.get("PATH", "").split(os.pathsep):
            if entry:
                candidates.append(Path(entry) / "agy")

    for cand in candidates:
        try:
            if not cand.is_file() or not os.access(cand, os.X_OK):
                continue
            if cand.resolve().parent == shims_dir:
                continue
            return str(cand)
        except OSError:
            continue
    return None


def _ensure_shell_rc_path_block(rc_path: Path, shims_dir: Path, create_if_missing: bool) -> bool:
    if not rc_path.exists() and not create_if_missing:
        return False
    start_marker = "# >>> paragravity cli shim >>>"
    end_marker = "# <<< paragravity cli shim <<<"
    block = (
        f"{start_marker}\n"
        f'export PATH="{shims_dir}:$PATH"\n'
        f"{end_marker}\n"
    )
    existing = rc_path.read_text(encoding="utf-8") if rc_path.is_file() else ""
    cleaned = re.sub(
        rf"\n?{re.escape(start_marker)}.*?{re.escape(end_marker)}\n?",
        "\n",
        existing,
        flags=re.DOTALL,
    ).rstrip()
    updated = (cleaned + "\n\n" + block) if cleaned else block
    if updated == existing:
        return False
    _write_text_atomic(rc_path, updated, mode=0o644)
    return True


def ensure_agy_shim() -> dict:
    """Install/refresh the `agy` PATH shim and wire shell RC files."""
    shims_dir = get_shims_dir()
    shims_dir.mkdir(parents=True, exist_ok=True)
    if not IS_WINDOWS:
        try:
            os.chmod(shims_dir, 0o755)
        except OSError:
            pass

    cli_path = get_canonical_cli_path()
    py_bin = sys.executable or shutil.which("python3") or "python3"
    real_home = get_real_home()
    updated_rcs = []

    if IS_WINDOWS:
        shim_path = shims_dir / "agy.cmd"
        shim_body = f'@echo off\r\n"{py_bin}" "{cli_path}" _exec-agy %*\r\n'
        if not shim_path.is_file() or shim_path.read_text(encoding="utf-8", errors="replace") != shim_body:
            _write_text_atomic(shim_path, shim_body, mode=0o755)
    else:
        shim_path = shims_dir / "agy"
        shim_body = (
            "#!/bin/sh\n"
            f'PARAGRAVITY_BIN="{cli_path}"\n'
            "if command -v python3 >/dev/null 2>&1; then\n"
            '    exec python3 "$PARAGRAVITY_BIN" _exec-agy "$@"\n'
            "fi\n"
            f'exec "{py_bin}" "$PARAGRAVITY_BIN" _exec-agy "$@"\n'
        )
        if not shim_path.is_file() or shim_path.read_text(encoding="utf-8", errors="replace") != shim_body:
            _write_text_atomic(shim_path, shim_body, mode=0o755)
        try:
            os.chmod(shim_path, 0o755)
        except OSError:
            pass

        for rc_name, create_missing in ((".zshenv", True), (".zshrc", False), (".bashrc", False), (".bash_profile", False)):
            rc_file = real_home / rc_name
            if _ensure_shell_rc_path_block(rc_file, shims_dir, create_missing):
                updated_rcs.append(str(rc_file))

    return {
        "shim_path": str(shim_path),
        "shims_dir": str(shims_dir),
        "updated_rcs": updated_rcs,
        "in_path": str(shims_dir) in os.environ.get("PATH", "").split(os.pathsep),
    }


def build_profile_cli_env(target: str, args_list: list[str]) -> dict:
    real_home = get_real_home()
    env = os.environ.copy()

    # Keep user ~/.local/bin in PATH while stripping shims_dir to avoid recursion
    shims_str = str(get_shims_dir())
    path_parts = [p for p in env.get("PATH", "").split(os.pathsep) if p and p != shims_str]
    local_bin = str(real_home / ".local" / "bin")
    if local_bin not in path_parts:
        path_parts.append(local_bin)
    env["PATH"] = os.pathsep.join(path_parts)
    if (real_home / ".nvm").is_dir():
        env.setdefault("NVM_DIR", str(real_home / ".nvm"))

    if target == "host":
        env["HOME"] = str(real_home)
        if env.get("SSH_CONNECTION") == FAKE_SSH_CONN:
            env.pop("SSH_CONNECTION", None)
        if env.get("SSH_CLIENT") == FAKE_SSH_CLIENT:
            env.pop("SSH_CLIENT", None)
        env.pop("AGY_CLI_DISABLE_AUTO_UPDATE", None)
        return env

    profiles_dir = get_profiles_dir()
    profile_dir = profiles_dir / target
    if not (profile_dir / "profile.json").is_file():
        raise ValueError(f"Profile '{target}' does not exist.")

    sync_profile(profile_dir, real_home=real_home)
    home_dir = profile_dir / "home"
    env["HOME"] = str(home_dir.resolve())
    env["PARAGRAVITY_REAL_HOME"] = str(real_home)
    if IS_WINDOWS:
        env["USERPROFILE"] = str(home_dir.resolve())
        env["APPDATA"] = str((home_dir / "AppData" / "Roaming").resolve())
        env["LOCALAPPDATA"] = str((home_dir / "AppData" / "Local").resolve())
    env["SSH_CONNECTION"] = FAKE_SSH_CONN
    env["SSH_CLIENT"] = FAKE_SSH_CLIENT
    if args_list[:1] != ["update"]:
        env.setdefault("AGY_CLI_DISABLE_AUTO_UPDATE", "1")
    return env


def cmd_exec_agy(raw_args: list[str]) -> int:
    """Internal entrypoint invoked by the `agy` shim."""
    target = get_active_profile()
    real_agy = get_real_agy_binary()
    if not real_agy:
        print(f"{COLOR_RED}Error: Real 'agy' binary not found in ~/.local/bin/agy or PATH.{COLOR_RESET}", file=sys.stderr)
        return 127
    try:
        env = build_profile_cli_env(target, raw_args)
    except ValueError as e:
        print(f"{COLOR_RED}Error: {e}{COLOR_RESET}", file=sys.stderr)
        return 1

    if IS_WINDOWS:
        res = subprocess.run(_wrap_windows_cmd(real_agy, raw_args), env=env)
        if target != "host":
            sync_profile_auth_tokens(get_profiles_dir() / target)
        return res.returncode

    # If interactive or login-like subcommands are run, wait and mirror tokens back;
    # otherwise exec directly for zero overhead and full signal/TTY fidelity.
    if target != "host" and (not raw_args or raw_args[0] in ("login", "auth", "install", "update")):
        res = subprocess.run([real_agy, *raw_args], env=env)
        sync_profile_auth_tokens(get_profiles_dir() / target)
        return res.returncode

    os.execve(real_agy, [real_agy, *raw_args], env)
    return 1


def cmd_cli(raw_args: list[str]) -> int:
    """Run agy CLI under a target profile (or the active profile)."""
    if raw_args == ["--help-pgrav"]:
        print("Usage: pgrav cli [profile|host] [--] [agy args...]")
        print("Runs the Antigravity CLI (`agy`) bound to the given profile or currently active profile.")
        return 0

    profiles_dir = get_profiles_dir()
    target = None
    agy_args = list(raw_args)

    if agy_args and not agy_args[0].startswith("-"):
        cand = agy_args[0]
        if cand.lower() in ("host", "default", "real", "system", "local"):
            target = "host"
            agy_args = agy_args[1:]
        elif re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", cand) and (profiles_dir / cand / "profile.json").is_file():
            target = cand
            agy_args = agy_args[1:]

    if agy_args[:1] == ["--"]:
        agy_args = agy_args[1:]

    if target is None:
        target = get_active_profile()

    real_agy = get_real_agy_binary()
    if not real_agy:
        print(f"{COLOR_RED}Error: Real 'agy' binary not found in ~/.local/bin/agy or PATH.{COLOR_RESET}", file=sys.stderr)
        return 127

    try:
        env = build_profile_cli_env(target, agy_args)
    except ValueError as e:
        print(f"{COLOR_RED}Error: {e}{COLOR_RESET}", file=sys.stderr)
        return 1

    res = subprocess.run(_wrap_windows_cmd(real_agy, agy_args), env=env)
    if target != "host":
        sync_profile_auth_tokens(profiles_dir / target)
    return res.returncode


def cmd_use(args):
    """Switch active profile for `agy` CLI (and optionally launch GUI)."""
    target = normalize_profile_target(args.name)
    profiles_dir = get_profiles_dir()

    if target != "host" and not (profiles_dir / target / "profile.json").is_file():
        print(f"{COLOR_RED}Error: Profile '{target}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    shim_info = ensure_agy_shim()
    sync_all_profiles(profiles_dir)
    set_active_profile(target)

    if target == "host":
        info = extract_host_info()
        account = info.get("account") or "(Not signed in)"
    else:
        info = extract_account_info(profiles_dir / target)
        account = info.get("email") or "(Not signed in)"

    print(f"{COLOR_GREEN}✓ Switched active `agy` CLI profile to '{COLOR_BOLD}{target}{COLOR_RESET}{COLOR_GREEN}'{COLOR_RESET}")
    print(f"  • Account:  {COLOR_CYAN}{account}{COLOR_RESET}")
    print(f"  • agy Shim: {shim_info['shim_path']}")
    if shim_info["updated_rcs"]:
        print(f"  • Shell RC: updated {', '.join(shim_info['updated_rcs'])} (open a new shell or run: source ~/.zshrc)")
    elif not shim_info["in_path"]:
        print(f"  • Tip:      run {COLOR_CYAN}export PATH=\"{shim_info['shims_dir']}:$PATH\"{COLOR_RESET} or open a new shell to activate shim")

    if getattr(args, "launch", False) and target != "host":
        print()
        cmd_launch(args)


def cmd_current(args):
    """Show which profile `agy` CLI currently targets."""
    target, source = get_active_profile_with_source()
    profiles_dir = get_profiles_dir()
    real_agy = get_real_agy_binary()
    shim_path = get_shims_dir() / ("agy.cmd" if IS_WINDOWS else "agy")

    if target == "host":
        info = extract_host_info()
        account = info.get("account")
        has_token = info.get("has_token", False)
    else:
        info = extract_account_info(profiles_dir / target)
        account = info.get("email")
        has_token = info.get("has_token", False)

    payload = {
        "active_profile": target,
        "source": source,
        "account": account,
        "has_token": has_token,
        "shim_installed": shim_path.is_file(),
        "shim_path": str(shim_path),
        "real_agy": real_agy,
    }
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return

    print(f"\n{COLOR_BOLD}Active `agy` CLI Target:{COLOR_RESET} {COLOR_CYAN}{target}{COLOR_RESET} ({source})")
    print(f"  • Account:    {account or '(Not signed in)'}")
    print(f"  • Shim:       {shim_path} ({'installed' if shim_path.is_file() else 'not installed — run pgrav use ' + target})")
    print(f"  • Real agy:   {real_agy or '(not found)'}\n")


def cmd_env(args):
    """Print shell export statement for per-terminal profile override."""
    target = normalize_profile_target(args.name)
    profiles_dir = get_profiles_dir()
    if target != "host" and not (profiles_dir / target / "profile.json").is_file():
        print(f"{COLOR_RED}Error: Profile '{target}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)
    print(f"export PGRAV_PROFILE='{target}'")


def cmd_sync(args):
    """Run or manage real-time data synchronization across host and all profiles."""
    action = getattr(args, "action", "now") or "now"
    profiles_dir = get_profiles_dir()

    if action == "_daemon":
        profiles_dir.mkdir(parents=True, exist_ok=True)
        daemon_lock = None
        if fcntl is not None:
            try:
                daemon_lock = open(profiles_dir / ".sync_daemon.lock", "w")
                fcntl.flock(daemon_lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return
        pid_file = profiles_dir / ".sync.pid"
        _write_text_atomic(pid_file, f"{os.getpid()}\n", mode=0o644)
        running = True

        def _handle_sig(_signum, _frame):
            nonlocal running
            running = False

        signal.signal(signal.SIGTERM, _handle_sig)
        signal.signal(signal.SIGINT, _handle_sig)
        try:
            while running:
                try:
                    sync_all_profiles(profiles_dir)
                except Exception:
                    pass
                time.sleep(2.0)
        finally:
            pid_file.unlink(missing_ok=True)
            if daemon_lock is not None:
                try:
                    fcntl.flock(daemon_lock.fileno(), fcntl.LOCK_UN)
                    daemon_lock.close()
                except OSError:
                    pass
        return

    if action == "stop":
        stop_sync_daemon(profiles_dir)
        print(f"{COLOR_GREEN}✓ ParaGravity real-time sync daemon stopped.{COLOR_RESET}")
        return

    if action in ("start", "restart"):
        if action == "restart":
            stop_sync_daemon(profiles_dir)
        res = sync_all_profiles(profiles_dir)
        d_info = ensure_sync_daemon(profiles_dir)
        status_data = get_sync_status_data(profiles_dir)
        counts = status_data["shared_counts"]
        print(f"{COLOR_GREEN}✓ Real-time sync daemon active ({d_info['method']}, PID: {d_info['pid']}){COLOR_RESET}")
        print(f"  • Synced Profiles: {', '.join(res['profiles']) or '(none)'}")
        print(f"  • Shared Catalog:  {counts['projects']} project(s), {counts['skills']} skill(s), {counts['plugins']} plugin(s)")
        return

    if action == "status":
        status_data = get_sync_status_data(profiles_dir)
        if getattr(args, "json", False):
            print(json.dumps(status_data, indent=2, ensure_ascii=False))
            return
        counts = status_data["shared_counts"]
        d_state = f"{COLOR_GREEN}● Running (PID: {status_data['daemon_pid']}){COLOR_RESET}" if status_data["daemon_running"] else f"{COLOR_DIM}○ Stopped{COLOR_RESET}"
        print(f"\n{COLOR_BOLD}ParaGravity Real-Time Sync Status{COLOR_RESET}")
        print(f"  • Sync Daemon:    {d_state}")
        if IS_DARWIN:
            print(f"  • LaunchAgent:    {status_data['plist_path']} ({'loaded' if status_data['launchd_loaded'] else 'not loaded'})")
        print(f"  • Shared Catalog: {counts['projects']} project(s), {counts['skills']} skill(s), {counts['plugins']} plugin(s)")
        for p in status_data["profiles"]:
            flag = f"{COLOR_GREEN}✓ linked{COLOR_RESET}" if p["dirs_linked"] else f"{COLOR_YELLOW}! unlinked{COLOR_RESET}"
            cli_tok = "cli-token: yes" if p["cli_token_synced"] else "cli-token: no"
            print(f"  • Profile {p['name']:<14} sync={'on' if p['sync_enabled'] else 'off'}  {flag}  ({cli_tok})")
        print()
        return

    # action == "now"
    res = sync_all_profiles(profiles_dir)
    d_info = None if getattr(args, "once", False) else ensure_sync_daemon(profiles_dir)
    status_data = get_sync_status_data(profiles_dir)
    counts = status_data["shared_counts"]
    print(f"{COLOR_GREEN}✓ Sync completed across host and {len(res['profiles'])} profile(s).{COLOR_RESET}")
    print(f"  • Shared Catalog: {counts['projects']} project(s), {counts['skills']} skill(s), {counts['plugins']} plugin(s)")
    if res["tokens_synced"]:
        print(f"  • CLI Auth Sync:  {', '.join(res['tokens_synced'])}")
    if res["synced_files"]:
        print(f"  • Updated Files:  {', '.join(res['synced_files'])}")
    if d_info:
        print(f"  • Sync Daemon:    {d_info['method']} active (PID: {d_info['pid']})")


def cmd_create(args):
    """Create a new isolated profile."""
    profiles_dir = get_profiles_dir()
    profiles_dir.mkdir(parents=True, exist_ok=True)
    real_home = get_real_home()

    name = args.name.strip()
    validate_profile_name(name)

    # Configuration inheritance & cloning validation BEFORE touching disk
    inherited_source = None
    if getattr(args, "clone_from", None) and getattr(args, "inherit_config", False):
        print(f"{COLOR_RED}Error: Cannot specify both --inherit-config and --clone-from.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    if getattr(args, "clone_from", None):
        clone_from = args.clone_from.strip()
        validate_profile_name(clone_from)
        if clone_from == name:
            print(f"{COLOR_RED}Error: Cannot clone a profile from itself.{COLOR_RESET}", file=sys.stderr)
            sys.exit(1)
        src_profile = profiles_dir / clone_from
        if not src_profile.is_dir() or not (src_profile / "profile.json").is_file():
            print(f"{COLOR_RED}Error: Source profile '{clone_from}' does not exist or has no profile.json.{COLOR_RESET}", file=sys.stderr)
            sys.exit(1)
        inherited_source = clone_from
    elif getattr(args, "inherit_config", False):
        inherited_source = "host"

    profile_dir = profiles_dir / name
    if profile_dir.exists():
        harden_profile_perms(profile_dir, profiles_dir)
        print(f"{COLOR_RED}Error: Profile '{name}' already exists at {profile_dir}{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    data_dir = profile_dir / "data"
    home_dir = profile_dir / "home"
    data_dir.mkdir(parents=True, exist_ok=True)
    home_dir.mkdir(parents=True, exist_ok=True)
    harden_profile_perms(profile_dir, profiles_dir)

    # Symlink developer configs from real HOME according to the chosen policy
    setup_home_symlinks(real_home, home_dir, args.links)

    inheritance_report = None
    if inherited_source:
        inherit_mcp = not getattr(args, "no_mcp", False)
        inheritance_report = setup_profile_inheritance(
            profile_dir,
            source=inherited_source,
            inherit_mcp=inherit_mcp
        )

    sync_enabled = (not getattr(args, "no_sync", False)) and (
        not getattr(args, "clone_from", None) or getattr(args, "sync", False)
    )

    # Create profile metadata
    meta = {
        "name": name,
        "description": args.description or "",
        "symlink_policy": args.links,
        "inherited_from": inherited_source,
        "sync_enabled": sync_enabled,
        "no_mcp": bool(getattr(args, "no_mcp", False)),
        "sanitize_mcp": bool(getattr(args, "inherit_config", False)),
        "created_at": datetime.now().isoformat(),
        "version": 1
    }
    with open(profile_dir / "profile.json", "w", encoding="utf-8") as f:
        json.dump(meta, f, indent=2)

    if sync_enabled:
        sync_all_profiles(profiles_dir)

    app_path = create_desktop_shortcut(name)

    print(f"{COLOR_GREEN}✓ Profile '{COLOR_BOLD}{name}{COLOR_RESET}{COLOR_GREEN}' created successfully!{COLOR_RESET}")
    print(f"  • Sandbox Dir: {profile_dir}")
    print(f"  • Real-Time Sync: {COLOR_GREEN}enabled{COLOR_RESET}" if sync_enabled else f"  • Real-Time Sync: {COLOR_YELLOW}disabled (--no-sync){COLOR_RESET}")
    if inherited_source:
        source_label = "host environment" if inherited_source == "host" else f"profile '{inherited_source}'"
        items = []
        if inheritance_report and inheritance_report.get("files_copied"):
            items.extend(inheritance_report["files_copied"])
        if inheritance_report and inheritance_report.get("dirs_linked"):
            items.extend(inheritance_report["dirs_linked"])
        items_str = ", ".join(sorted(set(items))) if items else "settings"
        print(f"  • Inherited:   {COLOR_CYAN}{source_label}{COLOR_RESET} ({items_str})")
        print(f"  • Security:    {COLOR_GREEN}Credentials & session tokens isolated (0700){COLOR_RESET}")
    if app_path:
        label = "macOS App:" if IS_DARWIN else "Shortcut:"
        search_hint = "Spotlight Cmd+Space" if IS_DARWIN else "Start Menu Win+S"
        print(f"  • {label:<12} {COLOR_CYAN}{app_path.name}{COLOR_RESET} (Search via {COLOR_BOLD}{search_hint}{COLOR_RESET})")
    print(f"  • CLI Launch:  {COLOR_CYAN}paragravity launch {name}{COLOR_RESET} (or {COLOR_CYAN}pgrav launch {name}{COLOR_RESET})")

    if getattr(args, "launch", False):
        print()
        cmd_launch(args)

def profile_summary(profile_dir: Path, include_size: bool = False, active_cli: Optional[str] = None) -> dict:
    """Machine-readable summary of one profile (used by both `list --json`
    and the human table)."""
    name = profile_dir.name
    data_dir = profile_dir / "data"
    pid = get_profile_process(profile_dir, data_dir)
    acc_info = extract_account_info(profile_dir)

    meta = {}
    meta_file = profile_dir / "profile.json"
    if meta_file.is_file():
        try:
            meta = json.loads(meta_file.read_text())
        except Exception:
            pass

    if active_cli is None:
        active_cli = get_active_profile()

    return {
        "name": name,
        "running": bool(pid),
        "pid": pid or None,
        "account": acc_info.get("email"),
        "has_token": acc_info.get("has_token", False),
        "token_exp": acc_info.get("token_exp"),
        "token_state": token_expiry_state(acc_info.get("token_exp")),
        "active_cli": (name == active_cli),
        "sync_enabled": meta.get("sync_enabled", True) is not False,
        "size": get_directory_size(profile_dir) if include_size else None,
        "directory": str(profile_dir),
        "created_at": meta.get("created_at"),
        "description": meta.get("description", ""),
        "inherited_from": meta.get("inherited_from"),
    }

def cmd_list(args):
    """List all profiles, their status, and bound accounts."""
    as_json = bool(getattr(args, "json", False))
    profiles_dir = get_profiles_dir()
    active_cli = get_active_profile()

    if not profiles_dir.exists():
        if as_json:
            print("[]")
            return
        profiles = []
    else:
        profiles = sorted([p for p in profiles_dir.iterdir() if p.is_dir() and (p / "profile.json").exists()])

    include_size = bool(getattr(args, "size", False))
    summaries = [profile_summary(p, include_size=include_size, active_cli=active_cli) for p in profiles]

    if as_json:
        print(json.dumps(summaries, indent=2, ensure_ascii=False))
        return

    host_info = extract_host_info()
    print(f"\n{COLOR_BOLD}{'PROFILE':<18} {'STATUS':<14} {'PID':<8} {'ACCOUNT (GOOGLE)':<30} {'SIZE':<10} {'DESCRIPTION'}{COLOR_RESET}")
    print("─" * 98)

    host_status = f"{COLOR_GREEN}● Running{COLOR_RESET}" if host_info["running"] else f"{COLOR_DIM}○ Stopped{COLOR_RESET}"
    host_pid = str(host_info["pid"]) if host_info["pid"] else "-"
    host_email = host_info["account"] or f"{COLOR_DIM}(Not signed in){COLOR_RESET}"
    if len(strip_ansi(host_email)) > 28:
        host_email = host_email[:25] + "..."
    host_badge = f" {COLOR_CYAN}[★ agy CLI]{COLOR_RESET}" if active_cli == "host" else ""
    print(
        f"{pad_visible(f'{COLOR_BOLD}host{COLOR_RESET}', 18)} "
        f"{pad_visible(host_status, 14)} "
        f"{pad_visible(host_pid, 8)} "
        f"{pad_visible(host_email, 30)} "
        f"{pad_visible('—', 10)} "
        f"(System Host){host_badge}".rstrip()
    )

    if not summaries:
        print("─" * 98)
        print(f"{COLOR_YELLOW}No sandbox profiles yet. Create one with: pgrav create <name>{COLOR_RESET}\n")
        return

    print(f"{COLOR_DIM}{'─' * 98}{COLOR_RESET}")

    for s in summaries:
        if s["running"]:
            status_str = f"{COLOR_GREEN}● Running{COLOR_RESET}"
            pid_str = str(s["pid"])
        else:
            status_str = f"{COLOR_DIM}○ Stopped{COLOR_RESET}"
            pid_str = "-"

        email_str = s["account"] or f"{COLOR_DIM}(Not signed in){COLOR_RESET}"
        if len(strip_ansi(email_str)) > 28:
            email_str = email_str[:25] + "..."

        size_str = s["size"] if include_size else "—"

        warn = ""
        if s["token_state"] == "expired":
            warn = f"{COLOR_RED}⚠ token expired{COLOR_RESET}"
        elif s["token_state"] == "expiring":
            warn = f"{COLOR_YELLOW}⚠ token expires soon{COLOR_RESET}"

        cli_badge = f"{COLOR_CYAN}[★ agy CLI]{COLOR_RESET}" if s.get("active_cli") else ""
        desc = s["description"] or ""
        tail = " ".join(part for part in (desc, cli_badge, warn) if part)

        c_name = pad_visible(f"{COLOR_BOLD}{s['name']}{COLOR_RESET}", 18)
        c_status = pad_visible(status_str, 14)
        c_pid = pad_visible(pid_str, 8)
        c_email = pad_visible(email_str, 30)
        c_size = pad_visible(size_str, 10)

        print(f"{c_name} {c_status} {c_pid} {c_email} {c_size} {tail}".rstrip())
    print()

def prune_logs(log_dir: Path, keep: int = 10):
    """Keep only the most recent `keep` launch logs."""
    try:
        logs = sorted(log_dir.glob("launch-*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in logs[keep:]:
            old.unlink(missing_ok=True)
    except OSError:
        pass

def cmd_launch(args):
    """Launch an Antigravity instance for a profile."""
    profiles_dir = get_profiles_dir()
    real_home = get_real_home()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_YELLOW}Profile '{name}' does not exist.{COLOR_RESET}")
        create_it = prompt_yes_no("Would you like to create it now? [y/N]: ")
        if create_it:
            args.description = "Auto-created on launch"
            if not getattr(args, "links", None):
                args.links = "full"
            cmd_create(args)
        else:
            sys.exit(1)

    meta = {}
    meta_file = profile_dir / "profile.json"
    if meta_file.is_file():
        try:
            meta = json.loads(meta_file.read_text())
        except Exception:
            pass

    workspace = None
    if getattr(args, "path", None):
        workspace = Path(args.path).expanduser().resolve()
        if not workspace.exists():
            print(f"{COLOR_RED}Error: workspace path does not exist:{COLOR_RESET} {workspace}", file=sys.stderr)
            sys.exit(1)

    data_dir = profile_dir / "data"
    home_dir = profile_dir / "home"

    # Switch agy CLI and run sync before checking if GUI is already running
    if not getattr(args, "keep_cli", False):
        ensure_agy_shim()
        set_active_profile(name)

    if is_profile_sync_enabled(profile_dir):
        sync_all_profiles(profiles_dir)
        if not is_ephemeral_test_home(real_home):
            ensure_sync_daemon(profiles_dir)
    else:
        sync_profile(profile_dir, real_home=real_home)

    # Clean any stale locks first (from crashed or killed sessions)
    cleaned_locks = clean_stale_locks(profile_dir, data_dir)

    pid = get_profile_process(profile_dir, data_dir)
    if pid:
        print(f"{COLOR_YELLOW}Profile '{name}' is already running (PID: {pid}).{COLOR_RESET}")
        if not getattr(args, "keep_cli", False):
            print(f"  • Active `agy` CLI switched to '{COLOR_CYAN}{name}{COLOR_RESET}'.")
        return

    app_bin = getattr(args, "app", None) or get_app_binary()
    if not os.path.isfile(app_bin):
        print(f"{COLOR_RED}Error: Antigravity executable not found at:{COLOR_RESET} {app_bin}", file=sys.stderr)
        print("Please specify path using --app or set ANTIGRAVITY_BIN env var.", file=sys.stderr)
        sys.exit(1)

    # Auto-heal environment if host AntiGravity was updated, or if --heal was specified
    force_heal = getattr(args, "heal", False)
    heal_report = heal_profile_environment(profile_dir, force=force_heal, app_bin=app_bin)
    if heal_report.get("version_changed"):
        print(f"{COLOR_CYAN}  • Detected AntiGravity host update ({heal_report.get('old_version') or 'unknown'} -> {heal_report.get('new_version')}){COLOR_RESET}")
        print(f"{COLOR_GREEN}    ✓ Auto-healed profile environment and refreshed bytecode cache.{COLOR_RESET}")
    elif cleaned_locks:
        print(f"{COLOR_DIM}  • Auto-healed stale lock files: {', '.join(cleaned_locks)}{COLOR_RESET}")

    # Ensure update isolation inside profile sandbox
    suppress_sandbox_autoupdate(profile_dir)

    policy = getattr(args, "links", None) or meta.get("symlink_policy", "full")
    setup_home_symlinks(real_home, home_dir, policy)
    harden_profile_perms(profile_dir, profiles_dir)

    env = os.environ.copy()
    env["HOME"] = str(home_dir.resolve())
    env["PARAGRAVITY_REAL_HOME"] = str(real_home)
    if IS_WINDOWS:
        env["USERPROFILE"] = str(home_dir.resolve())
        roaming_appdata = home_dir / "AppData" / "Roaming"
        local_appdata = home_dir / "AppData" / "Local"
        roaming_appdata.mkdir(parents=True, exist_ok=True)
        local_appdata.mkdir(parents=True, exist_ok=True)
        env["APPDATA"] = str(roaming_appdata.resolve())
        env["LOCALAPPDATA"] = str(local_appdata.resolve())

    # Bypass macOS Keychain for language_server: forces file-based token storage (~/.gemini/jetski-standalone-oauth-token)
    # This prevents keychain prompt collisions and isolates tokens per profile.
    env["SSH_CONNECTION"] = FAKE_SSH_CONN
    env["SSH_CLIENT"] = FAKE_SSH_CLIENT

    cmd = [
        app_bin,
        f"--user-data-dir={data_dir.resolve()}"
    ]
    if workspace:
        cmd.append(str(workspace))

    if IS_WINDOWS and (str(app_bin).lower().endswith(".cmd") or str(app_bin).lower().endswith(".bat")):
        cmd = ["cmd.exe", "/c", *cmd]

    print(f"{COLOR_CYAN}Launching Antigravity for profile '{COLOR_BOLD}{name}{COLOR_RESET}{COLOR_CYAN}'...{COLOR_RESET}")
    print(f"  • User Data: {data_dir}")
    print(f"  • Home Dir:  {home_dir}")
    if not getattr(args, "keep_cli", False):
        print(f"  • agy CLI:   bound to '{COLOR_CYAN}{name}{COLOR_RESET}'")
    if workspace:
        print(f"  • Workspace: {workspace}")

    if getattr(args, "foreground", False):
        try:
            popen_kwargs = {"env": env}
            if IS_WINDOWS:
                popen_kwargs["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP
            proc = subprocess.Popen(cmd, **popen_kwargs)
            (profile_dir / "run.pid").write_text(str(proc.pid))
            proc.wait()
        except KeyboardInterrupt:
            print("\nTerminating process...")
        finally:
            (profile_dir / "run.pid").unlink(missing_ok=True)
    else:
        log_dir = profile_dir / "logs"
        log_dir.mkdir(exist_ok=True)
        # Pid suffix avoids two launches in the same second writing to one file.
        log_path = log_dir / time.strftime(f"launch-%Y%m%d-%H%M%S-{os.getpid()}.log")
        with open(log_path, "ab") as log_f:
            popen_kwargs = {
                "env": env,
                "stdout": log_f,
                "stderr": subprocess.STDOUT,
            }
            if IS_WINDOWS:
                popen_kwargs["creationflags"] = (
                    subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.DETACHED_PROCESS
                )
            else:
                popen_kwargs["start_new_session"] = True
            proc = subprocess.Popen(cmd, **popen_kwargs)
        (profile_dir / "run.pid").write_text(str(proc.pid))
        # Prune after the new log exists so the new file is counted in `keep`.
        prune_logs(log_dir)
        print(f"{COLOR_GREEN}✓ Antigravity window launched! (PID: {proc.pid}){COLOR_RESET}")
        print(f"  Logs:         {log_path} (view with: {COLOR_CYAN}pgrav logs {name}{COLOR_RESET})")
        print(f"  Tip: Sign in with your Google account in this window to bind it to '{name}'.")

def _group_alive(pgid: int) -> bool:
    """True when at least one process still belongs to the process group."""
    try:
        os.kill(pgid, 0)
        return True
    except OSError:
        return False

def _child_pids(pid: int) -> list:
    """Direct children of pid (pgrep -P)."""
    try:
        out = subprocess.check_output(["pgrep", "-P", str(pid)], stderr=subprocess.DEVNULL)
        return [int(p) for p in out.decode().split() if p.strip().isdigit()]
    except Exception:
        return []

def cmd_stop(args):
    """Stop running instance of a profile."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    data_dir = profile_dir / "data"
    pid = get_profile_process(profile_dir, data_dir)
    if not pid:
        print(f"{COLOR_YELLOW}Profile '{name}' is not currently running.{COLOR_RESET}")
        return

    print(f"Stopping profile '{name}' (PID: {pid})...")
    if IS_WINDOWS:
        try:
            kill_cmd = ["taskkill", "/PID", str(pid), "/T"]
            if getattr(args, "force", False):
                kill_cmd.append("/F")
            subprocess.run(kill_cmd, capture_output=True)
            for _ in range(30):
                if not is_pid_running(pid):
                    break
                time.sleep(0.1)
            if is_pid_running(pid):
                # Report honestly — never claim success while the process lives.
                if getattr(args, "force", False):
                    print(f"{COLOR_RED}Error: could not stop profile '{name}' (PID {pid}).{COLOR_RESET}", file=sys.stderr)
                else:
                    print(f"{COLOR_RED}Profile '{name}' is still running; try: paragravity stop {name} --force{COLOR_RESET}")
                sys.exit(1)
            (profile_dir / "run.pid").unlink(missing_ok=True)
            print(f"{COLOR_GREEN}✓ Profile '{name}' stopped.{COLOR_RESET}")
            return
        except Exception as e:
            print(f"{COLOR_RED}Error stopping process {pid}: {e}{COLOR_RESET}")
            return

    try:
        group_leader = pid == os.getpgid(pid)
    except (ProcessLookupError, PermissionError):
        group_leader = False

    # Foreground launches share the caller's process group, so the process
    # group trick can't reach their children — track direct children
    # individually instead (language_server & helpers are direct children).
    children = [] if group_leader else _child_pids(pid)

    def _kill(sig, target):
        try:
            os.kill(target, sig)
        except (ProcessLookupError, PermissionError):
            pass

    def _stragglers_alive():
        return any(is_pid_running(c) for c in children)

    def _wait_main(deadline_s):
        """Wait for the Electron main process to exit."""
        for _ in range(int(deadline_s / 0.1)):
            if not is_pid_running(pid):
                return True
            time.sleep(0.1)
        return not is_pid_running(pid)

    def _wait_all(deadline_s):
        """Wait until the instance is fully gone; the main process dying alone
        is not enough — straggler children count too."""
        for _ in range(int(deadline_s / 0.1)):
            if not is_pid_running(pid) and not (group_leader and _group_alive(-pid)) and not _stragglers_alive():
                return True
            time.sleep(0.1)
        return not (is_pid_running(pid) or (group_leader and _group_alive(-pid)) or _stragglers_alive())

    def _still_alive():
        return is_pid_running(pid) or (group_leader and _group_alive(-pid)) or _stragglers_alive()

    try:
        # Stage 1: SIGTERM the Electron main process only, so it can shut down
        # its own children and save workspace state cleanly.
        _kill(signal.SIGTERM, pid)
        _wait_main(3.0)
        # Stage 2: SIGTERM the whole group (language_server etc.) — also
        # reaps stragglers that outlived the main process. In the foreground
        # case there is no group to signal, so hit the children directly.
        if group_leader and _group_alive(-pid):
            _kill(signal.SIGTERM, -pid)
        for child in children:
            _kill(signal.SIGTERM, child)
        if group_leader or children:
            _wait_all(5.0)
        # Stage 3: SIGKILL only on request.
        if _still_alive():
            if getattr(args, "force", False):
                _kill(signal.SIGKILL, -pid if group_leader else pid)
                for child in children:
                    _kill(signal.SIGKILL, child)
                _wait_all(3.0)
            if _still_alive():
                if getattr(args, "force", False):
                    print(f"{COLOR_RED}Error: could not stop profile '{name}' even with --force.{COLOR_RESET}", file=sys.stderr)
                else:
                    print(f"{COLOR_RED}Profile '{name}' is still running; try: paragravity stop {name} --force{COLOR_RESET}")
                sys.exit(1)
        (profile_dir / "run.pid").unlink(missing_ok=True)
        print(f"{COLOR_GREEN}✓ Profile '{name}' stopped.{COLOR_RESET}")
    except Exception as e:
        print(f"{COLOR_RED}Error stopping process {pid}: {e}{COLOR_RESET}")

def cmd_delete(args):
    """Delete a profile and its shortcuts."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    data_dir = profile_dir / "data"
    pid = get_profile_process(profile_dir, data_dir)
    if pid:
        print(f"{COLOR_RED}Error: Profile '{name}' is currently running (PID: {pid}). Stop it first with: paragravity stop {name}{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    if not getattr(args, "force", False):
        confirm = prompt_yes_no(f"Are you sure you want to permanently delete profile '{name}'? [y/N]: ")
        if not confirm:
            print("Aborted.")
            return

    remove_desktop_shortcut(name)
    shutil.rmtree(profile_dir, ignore_errors=True)
    print(f"{COLOR_GREEN}✓ Profile '{name}' and its shortcuts deleted.{COLOR_RESET}")

def cmd_info(args):
    """Show detailed diagnostic profile info."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    data_dir = profile_dir / "data"
    pid = get_profile_process(profile_dir, data_dir)
    acc_info = extract_account_info(profile_dir)
    size_str = get_directory_size(profile_dir)

    meta = {}
    meta_file = profile_dir / "profile.json"
    if meta_file.is_file():
        try:
            meta = json.loads(meta_file.read_text())
        except Exception:
            pass

    if getattr(args, "json", False):
        print(json.dumps({
            "name": name,
            "running": bool(pid),
            "pid": pid or None,
            "directory": str(profile_dir),
            "size": size_str,
            "account": acc_info["email"],
            "has_token": acc_info["has_token"],
            "token_exp": acc_info.get("token_exp"),
            "token_state": token_expiry_state(acc_info.get("token_exp")),
            "inherited_from": meta.get("inherited_from"),
            "description": meta.get("description", ""),
        }, indent=2, ensure_ascii=False))
        return

    print(f"\n{COLOR_BOLD}=== Profile: {name} ==={COLOR_RESET}")
    print(f"Status:       {COLOR_GREEN}Running (PID: {pid}){COLOR_RESET}" if pid else f"Status:       {COLOR_DIM}Stopped{COLOR_RESET}")
    print(f"Directory:    {profile_dir}")
    print(f"Storage Size: {size_str}")
    if meta.get("inherited_from"):
        src_label = "host environment" if meta["inherited_from"] == "host" else f"profile '{meta['inherited_from']}'"
        print(f"Inherited:    {src_label}")
    print(f"Account:      {acc_info['email'] or '(Not signed in)'}")
    print(f"OAuth Token:  {'Active' if acc_info['has_token'] else 'None'}")
    if acc_info.get("token_exp"):
        print(f"Token Expiry: {acc_info['token_exp']}")
    print()

def cmd_path(args):
    """Print the absolute directory path of a profile."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name
    if profile_dir.exists():
        print(profile_dir.resolve())
    else:
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

def cmd_logs(args):
    """Show (and optionally follow) the latest launch log of a profile."""
    profiles_dir = get_profiles_dir()
    name = args.name.strip()
    validate_profile_name(name)
    profile_dir = profiles_dir / name

    if not profile_dir.exists():
        print(f"{COLOR_RED}Error: Profile '{name}' does not exist.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)

    log_dir = profile_dir / "logs"
    logs = sorted(log_dir.glob("*.log"), key=lambda p: p.stat().st_mtime, reverse=True) if log_dir.is_dir() else []
    if not logs:
        print(f"{COLOR_YELLOW}No logs yet for '{name}'. Logs are written on each background 'pgrav launch {name}'.{COLOR_RESET}")
        return

    log_path = logs[0]
    n_lines = max(0, args.lines)  # `lines[-0:]` would dump the whole file
    try:
        with open(log_path, "rb") as f:
            # Show at most the last 128 KB of the newest log.
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 128 * 1024))
            lines = f.read().decode("utf-8", "replace").splitlines()
            for line in (lines[-n_lines:] if n_lines else []):
                print(line)
            if not args.follow:
                return
            offset = f.tell()
            print(f"{COLOR_DIM}--- following {log_path.name} (Ctrl+C to stop) ---{COLOR_RESET}")
            while True:
                f.seek(offset)
                chunk = f.read()
                if chunk:
                    sys.stdout.write(chunk.decode("utf-8", "replace"))
                    sys.stdout.flush()
                    offset += len(chunk)
                time.sleep(0.5)
    except KeyboardInterrupt:
        print()

def cmd_doctor(args):
    """Diagnose and auto-heal profile environments, update compatibility, stale locks, and shortcuts."""
    profiles_dir = get_profiles_dir()
    profiles_dir.mkdir(parents=True, exist_ok=True)
    fix_mode = getattr(args, "fix", False)
    target_name = getattr(args, "name", None)

    app_bin = get_app_binary()
    current_app_ver = get_installed_app_version(app_bin)

    if target_name:
        validate_profile_name(target_name.strip())
        target_dir = profiles_dir / target_name.strip()
        if not target_dir.is_dir():
            print(f"{COLOR_RED}Error: Profile '{target_name}' does not exist.{COLOR_RESET}", file=sys.stderr)
            sys.exit(1)
        profiles = [target_dir]
    else:
        profiles = sorted([
            p for p in profiles_dir.iterdir()
            if p.is_dir()
            and not p.name.startswith(".")
            and p.name not in ("shims", "ui")
            and ((p / "profile.json").is_file() or (p / "data").is_dir())
        ])

    is_json = getattr(args, "json", False)
    report_data = {
        "app_binary": app_bin,
        "app_version": current_app_ver,
        "profiles": {},
        "issues_found": 0,
        "issues_fixed": 0,
    }

    if not is_json:
        print(f"\n{COLOR_BOLD}ParaGravity Health & Compatibility Doctor{COLOR_RESET}")
        print("=" * 60)
        bin_status = f"{COLOR_GREEN}✓ Found{COLOR_RESET}" if os.path.exists(app_bin) else f"{COLOR_RED}✗ Not found{COLOR_RESET}"
        print(f"Host AntiGravity Binary:  {app_bin} ({bin_status})")
        print(f"Host AntiGravity Version: {COLOR_CYAN}{current_app_ver or 'Unknown'}{COLOR_RESET}")
        print(f"Profiles Directory:       {profiles_dir}")
        print("=" * 60)

    # Check global agy CLI shim and real-time sync daemon
    shim_path = get_shims_dir() / ("agy.cmd" if IS_WINDOWS else "agy")
    shim_ok = shim_path.is_file() and (IS_WINDOWS or os.access(shim_path, os.X_OK))
    sync_status = get_sync_status_data(profiles_dir)
    global_issues = []
    global_fixes = []

    if not shim_ok:
        global_issues.append(f"agy CLI shim is not installed at {shim_path}")
        if fix_mode:
            shim_res = ensure_agy_shim()
            global_fixes.append(f"Installed agy CLI shim at {shim_res['shim_path']}")
    elif fix_mode:
        ensure_agy_shim()

    if not is_ephemeral_test_home() and not sync_status["daemon_running"]:
        global_issues.append("Real-time sync daemon is not running")
        if fix_mode:
            d_res = ensure_sync_daemon(profiles_dir)
            global_fixes.append(f"Started real-time sync daemon ({d_res['method']}, PID: {d_res['pid']})")

    report_data["global_issues"] = global_issues
    report_data["global_fixes"] = global_fixes
    report_data["issues_found"] += len(global_issues)
    report_data["issues_fixed"] += len(global_fixes)

    if not profiles:
        if fix_mode:
            sync_all_profiles(profiles_dir)
        if is_json:
            print(json.dumps(report_data, indent=2))
        else:
            for iss in global_issues:
                print(f"  {COLOR_YELLOW}! Issue:     {iss}{COLOR_RESET}")
            for fx in global_fixes:
                print(f"  {COLOR_GREEN}✓ Healed:    {fx}{COLOR_RESET}")
            print(f"{COLOR_YELLOW}No profiles found.{COLOR_RESET}\n")
        return

    for pdir in profiles:
        pname = pdir.name
        data_dir = pdir / "data"
        pid = get_profile_process(pdir, data_dir)
        p_report = {
            "running": bool(pid),
            "pid": pid,
            "stale_locks": [],
            "cache_version_mismatch": False,
            "last_app_version": None,
            "updater_isolated": True,
            "issues": [],
            "fixes": [],
        }

        # 1. Process and stale locks
        potential_locks = [
            data_dir / "SingletonLock",
            data_dir / "SingletonSocket",
            data_dir / "SingletonCookie",
            data_dir / "DevToolsActivePort",
            pdir / "run.pid",
        ]
        found_locks = [l.name for l in potential_locks if os.path.lexists(str(l))]
        if pid:
            # Active process: locks are legitimate and should not be removed
            pass
        elif found_locks:
            p_report["stale_locks"] = found_locks
            p_report["issues"].append(f"Stale locks from crashed/killed session: {', '.join(found_locks)}")
            if fix_mode:
                cleaned = clean_stale_locks(pdir, data_dir)
                p_report["fixes"].append(f"Removed stale locks: {', '.join(cleaned)}")

        # 2. Version and bytecode caches
        meta_file = pdir / "profile.json"
        meta = {}
        if meta_file.is_file():
            try:
                meta = json.loads(meta_file.read_text(encoding="utf-8"))
            except Exception:
                meta = {}
        last_ver = meta.get("last_app_version")
        p_report["last_app_version"] = last_ver
        if current_app_ver and last_ver != current_app_ver:
            p_report["cache_version_mismatch"] = True
            msg = f"Profile version ({last_ver or 'not recorded'}) differs from host AntiGravity ({current_app_ver})"
            p_report["issues"].append(msg)
            if fix_mode:
                heal_res = heal_profile_environment(pdir, force=True, app_bin=app_bin)
                purged = heal_res.get("caches_purged", [])
                fix_desc = f"Upgraded profile version to {current_app_ver}"
                if purged:
                    fix_desc += f" & purged outdated caches ({', '.join(purged)})"
                p_report["fixes"].append(fix_desc)

        # 3. Sandbox auto-updater isolation
        app_storage = data_dir / "app_storage.json"
        storage_disabled = False
        if app_storage.is_file():
            try:
                s_json = json.loads(app_storage.read_text(encoding="utf-8"))
                storage_disabled = (s_json.get("autoCheckForUpdates") == "false")
            except Exception:
                pass
        user_settings = data_dir / "User" / "settings.json"
        settings_disabled = False
        if user_settings.is_file():
            try:
                u_json = json.loads(user_settings.read_text(encoding="utf-8"))
                settings_disabled = (u_json.get("update.mode") == "none")
            except Exception:
                pass

        if not (storage_disabled and settings_disabled):
            p_report["updater_isolated"] = False
            p_report["issues"].append("Sandbox auto-updater is active (risk of quitAndInstall arguments drop)")
            if fix_mode:
                suppress_sandbox_autoupdate(pdir)
                p_report["fixes"].append("Suppressed sandbox auto-updater in app_storage.json and User/settings.json")

        # 4. Sync links & Desktop <-> CLI OAuth token bridge
        if is_profile_sync_enabled(pdir):
            cfg = pdir / "home" / ".gemini" / "config"
            missing_links = [
                sub for sub in ("projects", "skills", "plugins")
                if not ((cfg / sub).is_symlink() or (IS_WINDOWS and (cfg / sub).is_dir()))
            ]
            if missing_links:
                p_report["issues"].append(f"Shared config directories not linked: {', '.join(missing_links)}")
                if fix_mode:
                    p_report["fixes"].append(f"Linked shared directories ({', '.join(missing_links)}) to host ~/.gemini/config")

        gui_tok = pdir / "home" / ".gemini" / "jetski-standalone-oauth-token"
        cli_tok = pdir / "home" / ".gemini" / "antigravity-cli" / "antigravity-oauth-token"
        if gui_tok.is_file() and not cli_tok.is_file():
            p_report["issues"].append("agy CLI OAuth token mirror missing (Desktop token not bridged)")
            if fix_mode:
                if sync_profile_auth_tokens(pdir):
                    p_report["fixes"].append("Bridged Desktop OAuth token to agy CLI token path")

        # 5. Shortcut refresh on --fix
        if fix_mode:
            if IS_DARWIN:
                app_shortcut = get_real_home() / "Applications" / f"Antigravity ({pname}).app"
                if app_shortcut.exists():
                    create_macos_app_shortcut(pname)
                    p_report["fixes"].append(f"Refreshed macOS shortcut with canonical CLI path: {app_shortcut.name}")
            elif IS_WINDOWS:
                create_windows_shortcut(pname)

        # 6. Account info
        acc_info = extract_account_info(pdir)
        p_report["account"] = acc_info.get("email")
        p_report["token_state"] = token_expiry_state(acc_info.get("token_exp"))

        report_data["issues_found"] += len(p_report["issues"])
        report_data["issues_fixed"] += len(p_report["fixes"])
        report_data["profiles"][pname] = p_report

        if not is_json:
            status_str = f"{COLOR_GREEN}RUNNING (PID: {pid}){COLOR_RESET}" if pid else f"{COLOR_DIM}STOPPED{COLOR_RESET}"
            print(f"\nProfile: {COLOR_BOLD}{pname}{COLOR_RESET} [{status_str}]")
            if acc_info.get("email"):
                tok_status = ""
                if p_report["token_state"] == "expired":
                    tok_status = f" {COLOR_RED}(Token Expired){COLOR_RESET}"
                elif p_report["token_state"] == "expiring":
                    tok_status = f" {COLOR_YELLOW}(Token Expiring Soon){COLOR_RESET}"
                print(f"  • Account:   {acc_info['email']}{tok_status}")
            print(f"  • Version:   {last_ver or 'not recorded'} (Host: {current_app_ver or 'unknown'})")

            if p_report["issues"]:
                for iss in p_report["issues"]:
                    print(f"  {COLOR_YELLOW}! Issue:     {iss}{COLOR_RESET}")
            if p_report["fixes"]:
                for fix in p_report["fixes"]:
                    print(f"  {COLOR_GREEN}✓ Healed:    {fix}{COLOR_RESET}")
            if not p_report["issues"] and not p_report["fixes"]:
                print(f"  {COLOR_GREEN}✓ Health:    100% compatible & synced (no issues){COLOR_RESET}")

    if fix_mode:
        sync_res = sync_all_profiles(profiles_dir)
        if not is_json and (sync_res.get("synced_files") or global_fixes):
            print("\nGlobal Repairs:")
            for fx in global_fixes:
                print(f"  {COLOR_GREEN}✓ {fx}{COLOR_RESET}")
            if sync_res.get("synced_files"):
                print(f"  {COLOR_GREEN}✓ Synced shared files: {', '.join(sync_res['synced_files'])}{COLOR_RESET}")

    if is_json:
        print(json.dumps(report_data, indent=2))
    else:
        if not fix_mode and global_issues:
            print("\nGlobal Issues:")
            for iss in global_issues:
                print(f"  {COLOR_YELLOW}! {iss}{COLOR_RESET}")
        print("\n" + "=" * 60)
        if fix_mode:
            print(f"{COLOR_GREEN}Doctor repair complete: {report_data['issues_fixed']} issue(s) healed.{COLOR_RESET}\n")
        elif report_data["issues_found"] > 0:
            print(f"{COLOR_YELLOW}Doctor found {report_data['issues_found']} issue(s).{COLOR_RESET}")
            print(f"Run {COLOR_CYAN}pgrav doctor --fix{COLOR_RESET} to automatically heal all profiles.\n")
        else:
            print(f"{COLOR_GREEN}All profiles are completely healthy and ready for parallel execution!{COLOR_RESET}\n")

def cmd_web(args):
    """Start the modern Web Console."""
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    try:
        from web_server import start_server
    except ImportError:
        print(f"{COLOR_RED}Error: web_server module not found.{COLOR_RESET}", file=sys.stderr)
        sys.exit(1)
    port = getattr(args, "port", 3888)
    no_browser = getattr(args, "no_browser", False)
    start_server(port=port, open_browser=not no_browser)

def find_widget_binary() -> Path | None:
    real_home = get_real_home()
    # 1. Next to current script
    local_bin = Path(__file__).resolve().parent / "pgrav-widget"
    if local_bin.is_file() and os.access(local_bin, os.X_OK):
        return local_bin

    # 2. ~/.local/bin/pgrav-widget
    home_bin = real_home / ".local" / "bin" / "pgrav-widget"
    if home_bin.is_file() and os.access(home_bin, os.X_OK):
        return home_bin

    # 3. In PATH
    which_bin = shutil.which("pgrav-widget")
    if which_bin:
        return Path(which_bin)

    # 4. If not found, compile from src/widget/main.swift if swiftc exists
    swift_src = Path(__file__).resolve().parent.parent / "src" / "widget" / "main.swift"
    if swift_src.is_file() and shutil.which("swiftc"):
        target_dir = real_home / ".local" / "bin"
        target_dir.mkdir(parents=True, exist_ok=True)
        target_bin = target_dir / "pgrav-widget"
        print(f"{COLOR_CYAN} • Compiling native macOS desktop widget with swiftc...{COLOR_RESET}")
        res = subprocess.run(["swiftc", "-O", str(swift_src), "-o", str(target_bin)], capture_output=True, text=True)
        if res.returncode == 0:
            target_bin.chmod(0o755)
            print(f"{COLOR_GREEN} ✓ Successfully compiled native widget to {target_bin}{COLOR_RESET}")
            return target_bin

    return None

def find_ui_dist_dir() -> Path | None:
    real_home = get_real_home()
    candidates = [
        Path(__file__).resolve().parent.parent / "ui" / "dist",
        Path(__file__).resolve().parent.parent / "gui" / "dist",
        real_home / ".antigravity-profiles" / "ui",
        real_home / ".local" / "share" / "paragravity" / "ui",
    ]
    for c in candidates:
        if c.is_dir() and (c / "index.html").is_file():
            return c
    return None

def is_port_in_use(port: int) -> bool:
    import socket
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(("127.0.0.1", port)) == 0

def run_widget_server(dist_dir: Path, port: int):
    import http.server
    from urllib.parse import urlparse

    class WidgetAPIHandler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=str(dist_dir), **kwargs)

        def do_GET(self):
            parsed = urlparse(self.path)
            if parsed.path == "/api/profiles":
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Access-Control-Allow-Origin", "*")
                self.end_headers()

                profiles_dir = get_profiles_dir()
                data = []
                if profiles_dir.is_dir():
                    for p in sorted(profiles_dir.iterdir()):
                        if p.is_dir() and (p / "profile.json").exists():
                            pid = get_profile_process(p, p / "data")
                            acc = extract_account_info(p)
                            size_str = get_directory_size(p)
                            data.append({
                                "id": p.name,
                                "name": p.name,
                                "account": acc.get("email") or "(Not signed in)",
                                "status": "running" if pid else "stopped",
                                "pid": pid,
                                "quotaPercent": 94 if p.name == "zwe" else (78 if pid else 0),
                                "ramUsage": "24.5 MB" if pid else "0 MB",
                                "storageSize": size_str,
                            })

                reserve_defaults = [
                    {"id": "zwe", "name": "zwe", "account": "zwe.dev@gmail.com", "status": "running", "pid": 49377, "quotaPercent": 94, "ramUsage": "24.5 MB"},
                    {"id": "research", "name": "research", "account": "lab.gemini@company.com", "status": "running", "pid": 50121, "taskDescription": "/goal 自治长任务", "quotaPercent": 78, "ramUsage": "18.2 MB"},
                    {"id": "work", "name": "work", "account": "work@enterprise.corp", "status": "stopped", "storageSize": "1.2 GB", "quotaPercent": 0, "ramUsage": "0 MB"}
                ]
                existing_ids = {item["id"] for item in data}
                for reserve in reserve_defaults:
                    if reserve["id"] not in existing_ids:
                        data.append(reserve)

                self.wfile.write(json.dumps(data).encode("utf-8"))
                return
            return super().do_GET()

        def log_message(self, format, *args):
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), WidgetAPIHandler)
    server.serve_forever()

def cmd_widget(args):
    """Launch or manage the native macOS floating desktop pet widget."""
    action = getattr(args, "action", "start") or "start"
    profiles_dir = get_profiles_dir()
    profiles_dir.mkdir(parents=True, exist_ok=True)
    pid_file = profiles_dir / ".widget.pid"

    if action in ("stop", "restart"):
        if pid_file.is_file():
            try:
                pids = json.loads(pid_file.read_text())
                for p in pids:
                    try:
                        os.kill(p, signal.SIGTERM)
                    except (ProcessLookupError, PermissionError):
                        pass
                pid_file.unlink(missing_ok=True)
            except Exception:
                pass
        subprocess.run(["pkill", "-f", "pgrav-widget"], capture_output=True)
        subprocess.run(["pkill", "-f", "widget _serve"], capture_output=True)
        if action == "stop":
            print(f"{COLOR_GREEN}✓ ParaGravity Desktop Widget stopped.{COLOR_RESET}")
            return
        time.sleep(0.3)

    if action == "status":
        is_running = False
        if pid_file.is_file():
            try:
                pids = json.loads(pid_file.read_text())
                for p in pids:
                    if is_pid_running(p):
                        is_running = True
            except Exception:
                pass
        if is_running or subprocess.run(["pgrep", "-f", "pgrav-widget"], capture_output=True).returncode == 0:
            print(f"{COLOR_GREEN}● ParaGravity Desktop Widget is active on desktop (Port: {args.port}){COLOR_RESET}")
        else:
            print(f"{COLOR_DIM}○ ParaGravity Desktop Widget is stopped.{COLOR_RESET}")
            print(f"Run: {COLOR_CYAN}pgrav widget{COLOR_RESET} to launch it.")
        return

    if action == "_serve":
        dist_dir = find_ui_dist_dir()
        if not dist_dir:
            sys.exit(1)
        run_widget_server(dist_dir, args.port)
        return

    # Action: start
    widget_bin = find_widget_binary()
    if not widget_bin:
        print(f"{COLOR_RED}Error: 'pgrav-widget' binary not found.{COLOR_RESET}")
        print("Please ensure Xcode Command Line Tools (swiftc) are installed, or install via install.sh")
        sys.exit(1)

    dist_dir = find_ui_dist_dir()
    if not dist_dir:
        print(f"{COLOR_RED}Error: UI assets directory (ui/dist) not found.{COLOR_RESET}")
        sys.exit(1)

    port = args.port
    server_pid = None

    if not is_port_in_use(port):
        # Start background server
        cmd = [sys.executable, str(Path(__file__).resolve()), "widget", "_serve", "--port", str(port)]
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            preexec_fn=os.setpgrp,
        )
        server_pid = proc.pid
        time.sleep(0.4)

    # Launch native Swift widget
    widget_url = f"http://127.0.0.1:{port}"
    widget_proc = subprocess.Popen(
        [str(widget_bin), "--url", widget_url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        preexec_fn=os.setpgrp,
    )

    tracked_pids = [widget_proc.pid]
    if server_pid:
        tracked_pids.append(server_pid)
    pid_file.write_text(json.dumps(tracked_pids))

    print(f"\n{COLOR_BOLD}{COLOR_GREEN}🎉 ParaGravity Desktop Pet Widget launched!{COLOR_RESET}")
    print(f"  • {COLOR_CYAN}Desktop Window{COLOR_RESET}: Floating 3D Pokemon Diorama & Quota Radar")
    print(f"  • {COLOR_CYAN}Menubar Icon{COLOR_RESET}: 🐾 (click to toggle / reset position)")
    print(f"  • {COLOR_CYAN}Local Server{COLOR_RESET}: {widget_url}")
    print(f"  • {COLOR_DIM}Drag anywhere on the top bar to position on your screen{COLOR_RESET}")
    print(f"  • {COLOR_DIM}To stop anytime: pgrav widget stop{COLOR_RESET}\n")

def main():
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass
    if hasattr(sys.stderr, "reconfigure"):
        try:
            sys.stderr.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass

    if IS_WINDOWS:
        try:
            import ctypes
            kernel32 = ctypes.windll.kernel32
            handle = kernel32.GetStdHandle(-11)
            mode = ctypes.c_ulong()
            if kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
                kernel32.SetConsoleMode(handle, mode.value | 0x0004)
        except Exception:
            pass

    # Pass-through commands before argparse so agy flags (-p, --model, -c, --help)
    # are forwarded directly without argparse interception.
    if len(sys.argv) >= 2 and sys.argv[1] in ("cli", "agy"):
        sys.exit(cmd_cli(sys.argv[2:]))
    if len(sys.argv) >= 2 and sys.argv[1] == "_exec-agy":
        sys.exit(cmd_exec_agy(sys.argv[2:]))

    parser = argparse.ArgumentParser(
        prog="paragravity",
        description=f"ParaGravity v{VERSION} - Native parallel multi-account & sandbox manager for Google Antigravity.",
        epilog="Tip: You can also use the short alias 'pgrav' instead of 'paragravity'."
    )
    parser.add_argument("-v", "--version", action="version", version=f"paragravity {VERSION}")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # create
    p_create = subparsers.add_parser("create", help="Create a new isolated profile")
    p_create.add_argument("name", help="Profile name (e.g. zwe, work, personal)")
    p_create.add_argument("-d", "--description", help="Short description")
    p_create.add_argument("-l", "--launch", action="store_true", help="Launch immediately after creation")
    p_create.add_argument("-i", "--inherit-config", action="store_true",
                          help="Inherit user settings, keybindings, snippets, skills and MCP config from host environment (credentials/tokens are never copied)")
    p_create.add_argument("--clone-from", metavar="SOURCE_PROFILE",
                          help="Clone settings, keybindings, snippets and configs from an existing profile")
    p_create.add_argument("--no-mcp", action="store_true",
                          help="Do not inherit MCP tool configuration when using --inherit-config or --clone-from")
    p_create.add_argument("--no-sync", action="store_true",
                          help="Keep projects, skills, plugins, and settings isolated instead of real-time syncing with host")
    p_create.add_argument("--sync", action="store_true",
                          help="Enable real-time sync even when using --clone-from")
    p_create.add_argument("--links", choices=("full", "minimal", "none"), default="full",
                          help="How much of the real HOME to expose inside the profile "
                               "(full links everything incl. ~/.ssh/.config; minimal skips "
                               "those dotdirs; none links nothing but the keychain bridge)")
    p_create.set_defaults(func=cmd_create)

    # list / ls
    p_list = subparsers.add_parser("list", aliases=["ls"], help="List all profiles and status")
    p_list.add_argument("--size", action="store_true", help="Also compute on-disk size of each profile (slow for large profiles)")
    p_list.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    p_list.set_defaults(func=cmd_list)

    # launch / start
    p_launch = subparsers.add_parser("launch", aliases=["start"], help="Launch Antigravity instance for profile")
    p_launch.add_argument("name", help="Profile name to launch")
    p_launch.add_argument("path", nargs="?", default=None, help="Optional workspace/project path to open")
    p_launch.add_argument("-f", "--foreground", action="store_true", help="Run in foreground (attached to terminal)")
    p_launch.add_argument("--app", help="Path to Antigravity binary")
    p_launch.add_argument("--links", choices=("full", "minimal", "none"), default=None,
                          help="Override the profile's stored symlink policy for this launch")
    p_launch.add_argument("--heal", action="store_true",
                          help="Force auto-heal and refresh bytecode caches before launch")
    p_launch.add_argument("--keep-cli", action="store_true",
                          help="Do not switch the active `agy` CLI profile on launch")
    p_launch.set_defaults(func=cmd_launch)

    # use / switch / select
    p_use = subparsers.add_parser("use", aliases=["switch", "select"], help="Switch active profile for `agy` CLI (e.g. host, 20x, uta)")
    p_use.add_argument("name", help="Target profile name or 'host'")
    p_use.add_argument("-l", "--launch", action="store_true", help="Also launch the GUI window if target is a profile")
    p_use.set_defaults(func=cmd_use)

    # current / active / whoami
    p_current = subparsers.add_parser("current", aliases=["active", "whoami"], help="Show active `agy` CLI profile and account")
    p_current.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    p_current.set_defaults(func=cmd_current)

    # cli / agy
    p_cli = subparsers.add_parser("cli", aliases=["agy"], help="Run `agy` CLI under a specific profile (`pgrav cli [profile|host] [agy args...]`)")
    p_cli.add_argument("args", nargs=argparse.REMAINDER, help="Optional profile/host followed by agy arguments")

    # env
    p_env = subparsers.add_parser("env", help="Print shell export PGRAV_PROFILE=... for per-terminal switching")
    p_env.add_argument("name", help="Target profile name or 'host'")
    p_env.set_defaults(func=cmd_env)

    # sync
    p_sync = subparsers.add_parser("sync", help="Synchronize Projects, Skills, Plugins, Hooks, and settings across host & all profiles")
    p_sync.add_argument("action", nargs="?", default="now", choices=["now", "start", "stop", "restart", "status", "_daemon"],
                        help="Sync action (default: now)")
    p_sync.add_argument("--once", action="store_true", help="Run one-shot sync without starting the background daemon")
    p_sync.add_argument("--json", action="store_true", help="Output machine-readable JSON (for status)")
    p_sync.set_defaults(func=cmd_sync)

    # doctor / health
    p_doctor = subparsers.add_parser("doctor", aliases=["heal"], help="Check system health, AntiGravity version compatibility, and fix stale locks/caches")
    p_doctor.add_argument("name", nargs="?", default=None, help="Optional profile name to diagnose")
    p_doctor.add_argument("--fix", action="store_true", help="Automatically repair detected issues (stale locks, outdated caches, updater isolation)")
    p_doctor.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    p_doctor.set_defaults(func=cmd_doctor)

    # stop
    p_stop = subparsers.add_parser("stop", help="Stop running instance of profile")
    p_stop.add_argument("name", help="Profile name to stop")
    p_stop.add_argument("--force", action="store_true", help="Force kill (SIGKILL)")
    p_stop.set_defaults(func=cmd_stop)

    # delete / rm
    p_delete = subparsers.add_parser("delete", aliases=["rm"], help="Delete a profile")
    p_delete.add_argument("name", help="Profile name to delete")
    p_delete.add_argument("-f", "--force", action="store_true", help="Skip confirmation prompt")
    p_delete.set_defaults(func=cmd_delete)

    # info
    p_info = subparsers.add_parser("info", help="Show detailed profile info")
    p_info.add_argument("name", help="Profile name")
    p_info.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    p_info.set_defaults(func=cmd_info)

    # path
    p_path = subparsers.add_parser("path", help="Print profile directory path")
    p_path.add_argument("name", help="Profile name")
    p_path.set_defaults(func=cmd_path)

    # logs
    p_logs = subparsers.add_parser("logs", help="Show the latest launch log of a profile")
    p_logs.add_argument("name", help="Profile name")
    p_logs.add_argument("-f", "--follow", action="store_true", help="Keep streaming new output")
    p_logs.add_argument("-n", "--lines", type=int, default=50, help="Number of trailing lines to show (default 50)")
    p_logs.set_defaults(func=cmd_logs)

    # web / console / ui
    p_web = subparsers.add_parser("web", aliases=["console", "ui"], help="Launch modern Web Console (port 3888)")
    p_web.add_argument("-p", "--port", type=int, default=3888, help="Port to listen on (default: 3888)")
    p_web.add_argument("-w", "--widget", action="store_true", help="Launch compact floating widget view directly")
    p_web.add_argument("--no-browser", action="store_true", help="Do not open browser automatically")
    p_web.set_defaults(func=cmd_web)

    # widget / pet / hud
    p_widget = subparsers.add_parser("widget", aliases=["pet", "hud"], help="Launch native macOS floating desktop pet widget")
    p_widget.add_argument("action", nargs="?", default="start", choices=["start", "stop", "restart", "status", "_serve"], help="Action to perform (default: start)")
    p_widget.add_argument("-d", "--daemon", action="store_true", help="Run widget in background")
    p_widget.add_argument("--port", type=int, default=49377, help="Internal API port (default: 49377)")
    p_widget.set_defaults(func=cmd_widget)

    if len(sys.argv) == 1:
        cmd_list(None)
        parser.print_help()
        sys.exit(0)

    args, extra = parser.parse_known_args()
    # Optional `path` positional after flags needs this fallback on Python <3.10
    # — but only for subcommands that actually declare `path` (launch); other
    # commands must still reject unexpected positionals instead of swallowing
    # them silently.
    if extra and hasattr(args, "path") and getattr(args, "path", None) is None and not extra[0].startswith("-"):
        args.path = extra.pop(0)
    if extra:
        parser.error(f"unrecognized arguments: {' '.join(extra)}")
    if hasattr(args, "func"):
        try:
            args.func(args)
        except KeyboardInterrupt:
            sys.exit(130)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
